                        class="auth-form-input w-full text-heading-6 font-semibold text-secondary dark:text-accent placeholder:font-normal placeholder:text-secondary/25 dark:placeholder:text-accent/25"
                      />
                    </div>
                    <div class="space-y-2">
                      <label for="calc-hours" class="block text-tagline-2 font-medium text-secondary/70 dark:text-accent/70 uppercase tracking-widest">Billable Hours Per Year</label>
                      <input
                        id="calc-hours"
                        type="number"
                        min="1"
                        value="1200"
                        placeholder="e.g. 1200"
                        class="auth-form-input w-full text-heading-6 font-semibold text-secondary dark:text-accent placeholder:font-normal placeholder:text-secondary/25 dark:placeholder:text-accent/25"
                      />
                    </div>
                    <div class="space-y-2">
