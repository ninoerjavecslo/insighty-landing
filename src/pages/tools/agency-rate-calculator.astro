                          <p id="out-target-rate" class="text-heading-3 font-semibold text-secondary dark:text-accent">—</p>
                          <p id="out-target-note" class="text-tagline-2 text-secondary/70 dark:text-accent/70">With margin</p>
                        </div>
                        <!-- Day Rate -->
                        <div class="rounded-xl border border-stroke-2 dark:border-stroke-5 bg-background-1 dark:bg-background-7 p-5 space-y-1">
                          <p class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Day Rate</p>
                          <p id="out-day-rate" class="text-heading-3 font-semibold text-secondary dark:text-accent">—</p>
                          <p class="text-tagline-2 text-secondary/70 dark:text-accent/70">8h at target</p>
                        </div>
                        <!-- Monthly Revenue -->
                        <div class="rounded-xl border border-stroke-2 dark:border-stroke-5 bg-background-1 dark:bg-background-7 p-5 space-y-1">
                          <p class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Monthly Revenue</p>
                          <p id="out-monthly" class="text-heading-3 font-semibold text-secondary dark:text-accent">—</p>
