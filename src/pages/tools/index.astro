---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/organisms/Header.astro'
import Footer from '../../components/organisms/Footer.astro'

const tools = [
  {
    slug: 'profit-margin-calculator',
    name: 'Profit Margin Calculator',
    description: 'Know if your projects are actually profitable. Calculate gross margin, net margin, and markup percentage so you can price with confidence.',
    tag: 'Finance',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    color: '#4a6ec7',
  },
  {
    slug: 'billable-hours-calculator',
    name: 'Billable Hours Calculator',
    description: 'Calculate exactly how many billable hours you need each month to hit your revenue targets — factoring in your rate and non-billable time.',
    tag: 'Finance',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    color: '#1b3a6b',
  },
  {
    slug: 'agency-rate-calculator',
    name: 'Agency Rate Calculator',
    description: 'Set hourly rates that actually cover your costs, pay you fairly, and hit your profit targets. Stop guessing — calculate the minimum rate you need.',
    tag: 'Pricing',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/><path d="M20 12H4"/></svg>`,
    color: '#6e8fd9',
  },
  {
    slug: 'project-budget-estimator',
    name: 'Project Budget Estimator',
    description: 'Estimate project budgets based on team roles, hours, and margin targets. Stop underquoting — build quotes that cover costs and protect profit.',
    tag: 'Projects',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>`,
    color: '#2d6a4f',
  },
  {
    slug: 'retainer-value-calculator',
    name: 'Retainer Value Calculator',
    description: 'Price recurring retainers to cover your costs, protect your margins, and build predictable revenue. Know exactly what to charge before you sign.',
    tag: 'Contracts',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>`,
    color: '#b5451b',
  },
  {
    slug: 'resource-utilisation-tracker',
    name: 'Resource Utilisation Tracker',
    description: 'Find out what percentage of your team\'s time is actually billable — and how much revenue you\'re leaving on the table from non-billable work.',
    tag: 'Operations',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    color: '#7c3aed',
  },
]

const comingSoon: never[] = []
---

<BaseLayout
  title="Free Agency Tools — Insighty"
  description="Free calculators and tools for digital agencies. Profit margin calculator, billable rate calculator, and more — built for agency operators who need real numbers fast."
>
  <Header />
  <main>

    <!-- Hero -->
    <section
      class="pt-[140px] sm:pt-[150px] md:pt-[160px] pb-16 md:pb-24 relative overflow-hidden"
      style="background: linear-gradient(135deg, #0a1628 0%, #112445 50%, #1a3a70 100%)"
    >
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>
      <div class="main-container relative z-10">
        <div class="max-w-[680px] space-y-6">
          <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/30 px-4 py-1.5">Free Tools</span>
          <h1 class="text-white">Agency tools.<br /><span class="hero-text-gradient hero-text-color-1">No subscription.</span></h1>
          <p class="text-white text-tagline-1 max-w-[520px]">
            Calculators and resources built for agency operators. Free to use — no account, no trial, no credit card.
          </p>
        </div>
      </div>
    </section>

    <!-- Available tools -->
    <section class="bg-background-2 dark:bg-background-7 py-16 md:py-20">
      <div class="main-container space-y-10">
        <div class="flex items-end justify-between gap-4 flex-wrap border-b border-stroke-2 dark:border-stroke-6 pb-6">
          <div class="space-y-1.5">
            <span class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Available now</span>
            <h2 class="text-secondary dark:text-accent">Free tools</h2>
          </div>
          <span class="text-tagline-2 text-secondary/80 dark:text-accent/80">{tools.length} tool{tools.length !== 1 ? 's' : ''}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          {tools.map(tool => (
            <a
              href={`/tools/${tool.slug}`}
              class="group flex flex-col bg-background-1 dark:bg-background-6 rounded-2xl border border-stroke-2 dark:border-stroke-5 p-7 gap-5 hover:border-primary-500/40 hover:shadow-2 transition-all duration-300"
            >
              <div class="flex flex-col gap-4">
                <div class="flex items-start justify-between gap-3">
                  <span class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-white" style={`background: ${tool.color}`}>
                    <span class="w-6 h-6" set:html={tool.icon} />
                  </span>
                  <span class="badge badge-primary text-tagline-3">Free</span>
                </div>
                <div class="space-y-1.5">
                  <p class="text-heading-6 font-semibold text-secondary dark:text-accent">{tool.name}</p>
                  <span class="inline-block text-tagline-3 text-secondary/80 dark:text-accent/80 uppercase tracking-widest font-medium">{tool.tag}</span>
                </div>
              </div>
              <p class="text-tagline-2 text-secondary/80 dark:text-accent/80 leading-relaxed flex-1">{tool.description}</p>
              <div class="flex items-center justify-between pt-4 border-t border-stroke-2 dark:border-stroke-5">
                <span class="text-tagline-2 font-medium text-primary-500 group-hover:text-primary-400 transition-colors duration-200">Open calculator</span>
                <svg class="w-4 h-4 text-primary-500 group-hover:translate-x-0.5 transition-transform duration-200" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>


    <!-- CTA -->
    <section style="background: linear-gradient(135deg, #0a1628 0%, #112445 60%, #1a3a70 100%)" class="py-16 md:py-20">
      <div class="main-container text-center space-y-6 max-w-[600px] mx-auto">
        <h2 class="text-white">Want these numbers tracked automatically?</h2>
        <p class="text-white/60 text-tagline-1">
          Insighty tracks margins, revenue, and project profitability in real time — across all your clients, projects, and income streams. No spreadsheets.
        </p>
        <a href="/contact" class="btn btn-outline-white btn-md inline-flex"><span>Request early access</span></a>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
