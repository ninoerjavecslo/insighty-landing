<script>
  // ── Email gate ──────────────────────────────────────────────────────────────
  const GATE_KEY       = 'insighty_tool_email'
  const emailGate      = document.getElementById('email-gate')!
  const gateForm       = document.getElementById('gate-form')   as HTMLFormElement
  const gateEmailInput = document.getElementById('gate-email')  as HTMLInputElement
  const gateError      = document.getElementById('gate-error')!

  // Tracks whether the gate has been dismissed (email stored or already had one)
  let gateUnlocked = !!localStorage.getItem(GATE_KEY)

  function showGate() {
    emailGate.classList.remove('hidden')
  }

  function hideGate() {
    emailGate.classList.add('hidden')
    gateUnlocked = true
  }

  // Check on page load — if email already stored, skip gate entirely
  if (!gateUnlocked) {
    // Gate will appear once the user enters at least one input (handled in calculate())
  }

  function isValidEmail(val: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val.trim())
  }

  gateForm.addEventListener('submit', (e) => {
    e.preventDefault()
    const val = gateEmailInput.value
    if (!isValidEmail(val)) {
      gateError.classList.remove('hidden')
      return
    }
    gateError.classList.add('hidden')
    localStorage.setItem(GATE_KEY, val.trim())
    hideGate()
    calculate()
  })

  gateEmailInput.addEventListener('input', () => {
    if (!gateError.classList.contains('hidden')) {
      gateError.classList.add('hidden')
    }
  })

  // ── Calculator logic ────────────────────────────────────────────────────────
  const hoursInput    = document.getElementById('calc-hours')    as HTMLInputElement
  const rateInput     = document.getElementById('calc-rate')     as HTMLInputElement
  const overheadInput = document.getElementById('calc-overhead') as HTMLInputElement
  const marginInput   = document.getElementById('calc-margin')   as HTMLInputElement

  const outBase         = document.getElementById('out-base')!
  const outBaseNote     = document.getElementById('out-base-note')!
  const outTotal        = document.getElementById('out-total')!
  const outTotalNote    = document.getElementById('out-total-note')!
  const outQuote        = document.getElementById('out-quote')!
  const outQuoteCard    = document.getElementById('out-quote-card')!
  const outQuoteNote    = document.getElementById('out-quote-note')!
  const outProfit       = document.getElementById('out-profit')!
  const outProfitCard   = document.getElementById('out-profit-card')!
  const outProfitNote   = document.getElementById('out-profit-note')!
  const outBreakeven    = document.getElementById('out-breakeven')!
  const outBreakevenNote = document.getElementById('out-breakeven-note')!
  const healthNote      = document.getElementById('health-note')!

  function fmt(n: number): string {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      maximumFractionDigits: 0,
    }).format(n)
  }

  function pct(n: number): string {
    return n.toFixed(1) + '%'
  }

  function marginColor(n: number): { border: string; bg: string; text: string } {
    if (n >= 20) return { border: 'border-emerald-500/30', bg: 'bg-emerald-500/5', text: 'text-emerald-600 dark:text-emerald-400' }
    if (n >= 10) return { border: 'border-amber-500/30',   bg: 'bg-amber-500/5',   text: 'text-amber-600 dark:text-amber-400' }
    return             { border: 'border-red-500/30',     bg: 'bg-red-500/5',     text: 'text-red-600 dark:text-red-400' }
  }

  function applyCardStyle(card: HTMLElement, valueEl: HTMLElement, value: number, active: boolean) {
    card.className = card.className
      .replace(/border-\S+\/30\s?/g, '')
      .replace(/bg-\S+\/5\s?/g, '')
      .trim()
    valueEl.className = valueEl.className
      .replace(/text-(emerald|amber|red)-\S+\s?/g, '')
      .trim()
    if (!active) return
    const c = marginColor(value)
    card.classList.add(c.border, c.bg)
    valueEl.classList.add(...c.text.split(' '))
  }

  function calculate() {
    const hours    = parseFloat(hoursInput.value)
    const rate     = parseFloat(rateInput.value)
    const overhead = parseFloat(overheadInput.value)
    const margin   = parseFloat(marginInput.value)

    const hasHours    = !isNaN(hours)    && hours > 0
    const hasRate     = !isNaN(rate)     && rate > 0
    const hasOverhead = !isNaN(overhead) && overhead >= 0
    const hasMargin   = !isNaN(margin)   && margin >= 0 && margin < 100

    // Show gate when user has entered at least one meaningful input and is not yet unlocked
    const hasAnyInput = hasHours || hasRate ||
      (!isNaN(parseFloat(marginInput.value)) && marginInput.value !== '20')
    if (!gateUnlocked && hasAnyInput) {
      showGate()
      return
    }

    // If gate is showing but user hasn't submitted, bail out
    if (!gateUnlocked) {
      return
    }

    // Reset outputs
    if (!hasHours || !hasRate) {
      outBase.textContent         = '—'
      outBaseNote.textContent     = 'Hours × rate'
      outTotal.textContent        = '—'
      outTotalNote.textContent    = 'Including overhead'
      outQuote.textContent        = '—'
      outQuoteNote.textContent    = 'Enter numbers above'
      outProfit.textContent       = '—'
      outProfitNote.textContent   = 'After all costs'
      outBreakeven.textContent    = '—'
      healthNote.classList.add('hidden')
      applyCardStyle(outQuoteCard, outQuote, 0, false)
      applyCardStyle(outProfitCard, outProfit, 0, false)
      return
    }

    // Base cost
    const baseCost = hours * rate
    outBase.textContent     = fmt(baseCost)
    outBaseNote.textContent = `${hours} hrs × ${fmt(rate)}/hr`

    // Total cost with overhead
    const overheadRate  = hasOverhead ? overhead / 100 : 0
    const totalCost     = baseCost * (1 + overheadRate)
    outTotal.textContent     = fmt(totalCost)
    outTotalNote.textContent = hasOverhead
      ? `Base + ${overhead}% overhead`
      : 'No overhead applied'

    // Break-even (total cost = minimum price)
    outBreakeven.textContent     = fmt(totalCost)
    outBreakevenNote.textContent = 'Minimum to charge (no profit)'

    if (!hasMargin) {
      outQuote.textContent     = '—'
      outQuoteNote.textContent = 'Enter target margin'
      outProfit.textContent    = '—'
      outProfitNote.textContent = 'After all costs'
      applyCardStyle(outQuoteCard, outQuote, 0, false)
      applyCardStyle(outProfitCard, outProfit, 0, false)
      healthNote.classList.add('hidden')
      return
    }

    // Recommended quote price: price = totalCost / (1 − margin)
    const quotePrice  = totalCost / (1 - margin / 100)
    const profit      = quotePrice - totalCost
    const actualMargin = (profit / quotePrice) * 100

    outQuote.textContent     = fmt(quotePrice)
    outQuoteNote.textContent = `At ${pct(margin)} margin`
    applyCardStyle(outQuoteCard, outQuote, actualMargin, true)

    outProfit.textContent     = fmt(profit)
    outProfitNote.textContent = `${pct(actualMargin)} margin`
    applyCardStyle(outProfitCard, outProfit, actualMargin, true)

    // Health note
    healthNote.classList.remove('hidden')
    const c = marginColor(actualMargin)
    healthNote.className = `rounded-xl border ${c.border} ${c.bg} px-5 py-4 text-tagline-2 leading-relaxed`

    if (actualMargin >= 25) {
      healthNote.textContent = `Margin of ${pct(actualMargin)} is excellent. Your quote covers all costs and delivers strong profit. Quote with confidence.`
    } else if (actualMargin >= 20) {
      healthNote.textContent = `Margin of ${pct(actualMargin)} is healthy. Your quote covers costs and protects profit. This is a sustainable price for this type of work.`
    } else if (actualMargin >= 10) {
      healthNote.textContent = `Margin of ${pct(actualMargin)} is tight. Your quote covers costs but leaves limited room for scope changes or delays. Consider increasing your target margin or reducing hours.`
    } else if (actualMargin >= 0) {
      healthNote.textContent = `Margin of ${pct(actualMargin)} is dangerously low. Any scope change or overrun will put this project in the red. Raise your margin target or reduce your cost base.`
    } else {
      healthNote.textContent = `Your quote price is below break-even — you would lose money on this project. Increase your target margin so the quote price exceeds total costs.`
    }
  }

  hoursInput.addEventListener('input', calculate)
  rateInput.addEventListener('input', calculate)
  overheadInput.addEventListener('input', calculate)
  marginInput.addEventListener('input', calculate)

  // Run once on load in case overhead field has a default value
  calculate()
</script>

