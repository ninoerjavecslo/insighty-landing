    <!-- Content -->
    <section class="bg-background-1 dark:bg-background-8 py-14 md:py-20">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-[220px_1fr] xl:grid-cols-[260px_1fr] gap-12 xl:gap-16 items-start">

