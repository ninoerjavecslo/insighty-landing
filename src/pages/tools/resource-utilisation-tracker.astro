<script>
  // ── Email gate ────────────────────────────────────────────────────────────
  const EMAIL_KEY   = 'insighty_tool_email'
  const emailGate   = document.getElementById('email-gate')!
  const gateForm    = document.getElementById('gate-form')  as HTMLFormElement
  const gateEmailEl = document.getElementById('gate-email') as HTMLInputElement
  const gateError   = document.getElementById('gate-error')!

  let gateUnlocked = Boolean(localStorage.getItem(EMAIL_KEY))

  function showGate() {
    if (!gateUnlocked) emailGate.classList.remove('hidden')
  }

  function hideGate() {
    emailGate.classList.add('hidden')
    gateUnlocked = true
  }

  function isValidEmail(v: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim())
  }

  gateForm.addEventListener('submit', (e) => {
    e.preventDefault()
    const val = gateEmailEl.value.trim()
    if (!isValidEmail(val)) {
      gateError.classList.remove('hidden')
      gateEmailEl.focus()
      return
    }
    gateError.classList.add('hidden')
    localStorage.setItem(EMAIL_KEY, val)
    hideGate()
    calculate()
  })

  gateEmailEl.addEventListener('input', () => {
    if (!gateError.classList.contains('hidden')) {
      gateError.classList.add('hidden')
    }
  })

  // ── Calculator logic ──────────────────────────────────────────────────────
  const availableInput  = document.getElementById('calc-available') as HTMLInputElement
  const billableInput   = document.getElementById('calc-billable')  as HTMLInputElement
  const rateInput       = document.getElementById('calc-rate')      as HTMLInputElement

  const utilisationPct  = document.getElementById('out-utilisation-pct')!
  const utilisationNote = document.getElementById('out-utilisation-note')!
  const utilisationCard = document.getElementById('out-utilisation')!
  const revenueVal      = document.getElementById('out-revenue-val')!
  const revenueNote     = document.getElementById('out-revenue-note')!
  const revenueCard     = document.getElementById('out-revenue')!
  const potentialVal    = document.getElementById('out-potential-val')!
  const gapVal          = document.getElementById('out-gap-val')!
  const gapCard         = document.getElementById('out-gap')!
  const effectiveVal    = document.getElementById('out-effective-val')!
  const healthNote      = document.getElementById('health-note')!

  function fmt(n: number): string {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n)
  }

  function fmtRate(n: number): string {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 2 }).format(n)
  }

  function pct(n: number): string {
    return n.toFixed(1) + '%'
  }

  type ColorSet = { border: string; bg: string; text: string }

  function utilisationColor(u: number): ColorSet {
    if (u >= 70) return { border: 'border-emerald-500/30', bg: 'bg-emerald-500/5', text: 'text-emerald-600 dark:text-emerald-400' }
    if (u >= 55) return { border: 'border-amber-500/30',   bg: 'bg-amber-500/5',   text: 'text-amber-600 dark:text-amber-400' }
    return             { border: 'border-red-500/30',     bg: 'bg-red-500/5',     text: 'text-red-600 dark:text-red-400' }
  }

  function gapColor(): ColorSet {
    return { border: 'border-red-500/30', bg: 'bg-red-500/5', text: 'text-red-600 dark:text-red-400' }
  }

  function revenueColorSet(): ColorSet {
    return { border: 'border-emerald-500/30', bg: 'bg-emerald-500/5', text: 'text-emerald-600 dark:text-emerald-400' }
  }

  function applyCardStyle(card: HTMLElement, valEl: HTMLElement, colors: ColorSet) {
    // Strip any previous color classes
    card.className = card.className.replace(/border-(emerald|amber|red)-\S+\/30\s?/g, '').replace(/bg-(emerald|amber|red)-\S+\/5\s?/g, '').trim()
    valEl.className = valEl.className.replace(/text-(emerald|amber|red)-\S+\s?/g, '').trim()
    card.classList.add(colors.border, colors.bg)
    valEl.classList.add(...colors.text.split(' '))
  }

  function resetCard(card: HTMLElement, valEl: HTMLElement) {
    card.className = card.className.replace(/border-(emerald|amber|red)-\S+\/30\s?/g, '').replace(/bg-(emerald|amber|red)-\S+\/5\s?/g, '').trim()
    valEl.className = valEl.className.replace(/text-(emerald|amber|red)-\S+\s?/g, '').trim()
  }

  function hasAnyInput(): boolean {
    return availableInput.value.trim() !== '' ||
           billableInput.value.trim()  !== '' ||
           rateInput.value.trim()      !== ''
  }

  function calculate() {
    // Show gate when user has typed anything and hasn't unlocked yet
    if (hasAnyInput() && !gateUnlocked) {
      showGate()
      return
    }

    const available = parseFloat(availableInput.value)
    const billable  = parseFloat(billableInput.value)
    const rate      = parseFloat(rateInput.value)

    const hasAvailable = !isNaN(available) && available > 0
    const hasBillable  = !isNaN(billable) && billable >= 0
    const hasRate      = !isNaN(rate) && rate > 0

    if (!hasAvailable || !hasBillable) {
      utilisationPct.textContent  = '—'
      utilisationNote.textContent = 'Enter hours above'
      revenueVal.textContent      = '—'
      revenueNote.textContent     = 'Billable hrs × rate'
      potentialVal.textContent    = '—'
      gapVal.textContent          = '—'
      effectiveVal.textContent    = '—'
      healthNote.classList.add('hidden')
      resetCard(utilisationCard, utilisationPct)
      resetCard(revenueCard, revenueVal)
      resetCard(gapCard, gapVal)
      return
    }

    // Utilisation rate
    const utilisationRate = (billable / available) * 100
    utilisationPct.textContent  = pct(utilisationRate)
    utilisationNote.textContent = `${billable} of ${available} hrs`
    applyCardStyle(utilisationCard, utilisationPct, utilisationColor(utilisationRate))

    // Revenue figures (only if rate provided)
    if (hasRate) {
      const revenueGenerated = billable * rate
      const revenuePotential = available * rate
      const revenueGap       = revenuePotential - revenueGenerated
      const effectiveRate    = revenueGenerated / available

      revenueVal.textContent   = fmt(revenueGenerated)
      revenueNote.textContent  = `${billable} hrs × ${fmtRate(rate)}`
      potentialVal.textContent = fmt(revenuePotential)
      gapVal.textContent       = fmt(revenueGap)
      effectiveVal.textContent = fmtRate(effectiveRate) + '/hr'

      applyCardStyle(revenueCard, revenueVal, revenueColorSet())
      applyCardStyle(gapCard,    gapVal,    gapColor())

      // Health note
      healthNote.classList.remove('hidden')
      const c = utilisationColor(utilisationRate)
      healthNote.className = `rounded-xl border ${c.border} ${c.bg} px-5 py-4 text-tagline-2 leading-relaxed`

      const gapFormatted = fmt(revenueGap)

      if (utilisationRate >= 70) {
        healthNote.textContent = `Your utilisation rate of ${pct(utilisationRate)} is healthy — above the 70% benchmark. You're capturing most of your available capacity. The remaining ${gapFormatted} revenue gap is within a normal range for internal time and overhead.`
      } else if (utilisationRate >= 55) {
        healthNote.textContent = `Your utilisation rate of ${pct(utilisationRate)} is approaching the healthy range, but there is ${gapFormatted} in recoverable revenue. Audit where non-billable hours are going — meetings, admin, and context-switching are typically the largest culprits.`
      } else {
        healthNote.textContent = `Your utilisation rate of ${pct(utilisationRate)} is below the 55% threshold. You're leaving ${gapFormatted} on the table each period. This signals a structural imbalance between team capacity and billable workload — either win more work, reduce overhead, or reduce capacity.`
      }
    } else {
      revenueVal.textContent   = '—'
      revenueNote.textContent  = 'Add hourly rate'
      potentialVal.textContent = '—'
      gapVal.textContent       = '—'
      effectiveVal.textContent = '—'
      resetCard(revenueCard, revenueVal)
      resetCard(gapCard,    gapVal)
      healthNote.classList.add('hidden')
    }
  }

  availableInput.addEventListener('input', calculate)
  billableInput.addEventListener('input',  calculate)
  rateInput.addEventListener('input',      calculate)

  // FAQ accordion
  document.querySelectorAll<HTMLButtonElement>('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const body    = btn.nextElementSibling as HTMLElement
      const chevron = btn.querySelector('.faq-chevron') as HTMLElement
      const isOpen  = btn.getAttribute('aria-expanded') === 'true'

      btn.setAttribute('aria-expanded', String(!isOpen))
      body.classList.toggle('hidden', isOpen)
      chevron.style.transform = isOpen ? '' : 'rotate(180deg)'
    })
  })
</script>

