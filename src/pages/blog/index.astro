---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/organisms/Header.astro'
import Footer from '../../components/organisms/Footer.astro'
import BlogCard from '../../components/molecules/BlogCard.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('blog')
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const featured = sorted.find(p => p.data.featured) ?? sorted[0]
const rest = sorted.filter(p => p.id !== featured.id)

const categories = ['All', 'Agency Ops', 'Revenue', 'Projects', 'Product'] as const

const gradients: Record<string, string> = {
  'Agency Ops': 'linear-gradient(135deg, #112445 0%, #4a6ec7 100%)',
  'Revenue':    'linear-gradient(135deg, #d4a574 0%, #b87333 100%)',
  'Projects':   'linear-gradient(135deg, #2d9b9b 0%, #4a6ec7 100%)',
  'Product':    'linear-gradient(135deg, #1b3a6b 0%, #6e8fd9 100%)',
}

const featuredGradient = gradients[featured.data.category] ?? gradients['Agency Ops']
const featuredDate = featured.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
---

<BaseLayout
  title="Blog — Insighty"
  description="Agency operations, client intelligence, and profitable growth — from the team building Insighty."
>
  <Header />
  <main>

    <!-- Page header -->
    <section class="bg-background-1 dark:bg-background-8 pt-[140px] sm:pt-[150px] md:pt-[160px] pb-12 md:pb-16">
      <div class="main-container text-center space-y-4">
        <span data-ns-animate data-delay="0.05" class="inline-block border border-secondary/25 dark:border-accent/20 text-secondary dark:text-accent/80 text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">Blog</span>
        <h1 data-ns-animate data-delay="0.1" class="mx-auto">The Insighty Blog</h1>
        <p data-ns-animate data-delay="0.2" class="mx-auto max-w-[520px]">
          Agency operations, client intelligence, and profitable growth — from the team building Insighty.
        </p>
      </div>
    </section>

    <!-- Featured post -->
    <section class="bg-background-1 dark:bg-background-8 pb-10 md:pb-14">
      <div class="main-container">
        <a
          href={`/blog/${featured.id}`}
          data-ns-animate
          data-delay="0.1"
          class="group block rounded-2xl overflow-hidden bg-background-2 dark:bg-background-6 border border-stroke-2 dark:border-stroke-5 hover:shadow-3 hover:scale-[1.005] transition-all duration-500"
        >
          <div class="grid grid-cols-1 lg:grid-cols-2">
            <!-- Thumbnail / placeholder -->
            <div
              class="min-h-[240px] lg:min-h-[380px] relative flex items-end p-8 overflow-hidden"
              style={featured.data.thumbnail ? undefined : `background: ${featuredGradient}`}
            >
              {featured.data.thumbnail ? (
                <>
                  <img
                    src={featured.data.thumbnail}
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="eager"
                    decoding="async"
                  />
                  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, transparent 60%)"></div>
                </>
              ) : (
                <span class="absolute inset-0 flex items-center justify-center pointer-events-none select-none" aria-hidden="true">
                  <span class="text-white/8 font-bold text-[14rem] leading-none">{featured.data.category[0]}</span>
                </span>
              )}
              <div class="relative z-10 flex items-center gap-3">
                <span class="badge badge-white !text-secondary font-medium">{featured.data.category}</span>
                <span class="text-tagline-3 text-white/60 font-medium uppercase tracking-widest">Featured</span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-8 xl:p-12 flex flex-col justify-center gap-5">
              <h2 class="line-clamp-3 group-hover:text-primary-400 transition-colors duration-300">{featured.data.title}</h2>
              <p class="max-w-[480px] line-clamp-3">{featured.data.description}</p>
              <div class="flex items-center gap-3 text-tagline-2 text-secondary/70 dark:text-accent/70">
                <time datetime={featured.data.pubDate.toISOString()}>{featuredDate}</time>
                <span aria-hidden="true">·</span>
                <span>{featured.data.readTime} min read</span>
              </div>
              <div>
                <span class="btn btn-md btn-primary"><span>Read article</span></span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>

    <!-- Filter + Grid -->
    <section class="bg-background-2 dark:bg-background-7 py-16 md:py-[100px]">
      <div class="main-container space-y-10">

        <!-- Section label -->
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <h2 data-ns-animate data-delay="0.05">All articles</h2>
        </div>

        <!-- Desktop filter tabs -->
        <div
          data-ns-animate
          data-delay="0.1"
          class="hidden sm:flex relative items-center gap-1 border-b border-stroke-2 dark:border-stroke-6 overflow-x-auto"
          data-tab-bar
        >
          <div data-active-tab-bar class="absolute bottom-0 h-0.5 bg-primary-500 pointer-events-none"></div>
          {categories.map((cat, i) => (
            <button
              data-tab-button
              data-state={i === 0 ? 'selected' : ''}
              class="px-5 py-3 text-tagline-2 font-medium text-secondary/70 dark:text-accent/70 data-[state=selected]:text-secondary dark:data-[state=selected]:text-accent whitespace-nowrap transition-colors duration-200 cursor-pointer"
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Mobile filter pills -->
        <div data-ns-animate data-delay="0.1" class="flex sm:hidden gap-2 overflow-x-auto pb-1 -mx-4 px-4">
          {categories.map((cat, i) => (
            <button
              data-mobile-tab-button
              data-mobile-active={i === 0 ? 'true' : undefined}
              class="shrink-0 px-4 py-1.5 text-tagline-3 font-medium uppercase tracking-wide border border-stroke-2 dark:border-stroke-6 text-secondary/80 dark:text-accent/80 data-[mobile-active=true]:bg-secondary data-[mobile-active=true]:text-accent data-[mobile-active=true]:border-secondary dark:data-[mobile-active=true]:bg-accent dark:data-[mobile-active=true]:text-secondary transition-all duration-200 cursor-pointer"
            >
              {cat}
            </button>
          ))}
        </div>

        <!-- Articles grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
          {rest.map((post, i) => (
            <div
              data-filter-item
              data-filter-category={post.data.category.toLowerCase()}
              data-ns-animate
              data-delay={String(0.05 * (i + 1))}
            >
              <BlogCard post={post} />
            </div>
          ))}
        </div>

      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
