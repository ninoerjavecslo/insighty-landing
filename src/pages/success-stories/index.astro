---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/organisms/Header.astro'
import Footer from '../../components/organisms/Footer.astro'
import Button from '../../components/atoms/Button.astro'

const stories = [
  {
    href: '/success-stories/founder-story',
    eyebrow: 'Founder Story · Digital Agency',
    headline: 'I Built Insighty Because My Own Agency Was Forgetting to Invoice €30,000 Per Year',
    excerpt: 'People left the company. Handovers were a mess. Hosting fees, maintenance contracts, domain renewals — all falling through the cracks. When I finally mapped everything, the number made me sick.',
    metric: '€30,000+',
    metricLabel: 'recovered per year',
    accent: 'linear-gradient(135deg, #112445 0%, #1b3a6b 60%, #4a6ec7 100%)',
    tag: 'Origin story',
    readTime: '5 min read',
  },
  {
    href: '/success-stories/hosting-audit',
    eyebrow: 'Case Study · Hosting & Ops',
    headline: "We Were Paying for Hosting Our Clients Weren't Billed For",
    excerpt: 'After importing every service contract into Insighty, the dashboard showed a number that didn\'t add up. Infrastructure costs versus what we were actually charging — a quiet €15,000 annual gap.',
    metric: '€15,000',
    metricLabel: 'saved per year',
    accent: 'linear-gradient(135deg, #1b3a6b 0%, #2d9b9b 100%)',
    tag: 'Ops win',
    readTime: '4 min read',
  },
]
---

<BaseLayout
  title="Success Stories — Insighty"
  description="Real results from agency owners who used Insighty to stop revenue leakage, recover forgotten invoices, and take back control of their operations."
>
  <Header />
  <main>

    <!-- Hero -->
    <section class="pt-[140px] sm:pt-[150px] md:pt-[160px] pb-16 md:pb-20 relative overflow-hidden" style="background: linear-gradient(135deg, #0a1628 0%, #112445 50%, #1a3a70 100%)">
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>
      <div class="main-container relative z-10">
        <div class="max-w-[680px] space-y-5">
          <span
            data-ns-animate
            data-delay="0.05"
            class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/30 px-4 py-1.5"
          >Success Stories</span>
          <h1
            data-ns-animate
            data-delay="0.1"
            class="text-white"
          >Revenue you didn't<br/> know you were losing.</h1>
          <p
            data-ns-animate
            data-delay="0.2"
            class="text-tagline-1 text-white/60 max-w-[520px] leading-relaxed"
          >
            These aren't marketing numbers. They're the exact amounts found, recovered, and turned into profit by agencies who finally had a single view of their operations.
          </p>
        </div>
      </div>
    </section>

    <!-- Story cards -->
    <section class="bg-background-1 dark:bg-background-8 py-16 md:py-24">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {stories.map((story, i) => (
            <a
              href={story.href}
              data-ns-animate
              data-delay={String(0.05 + i * 0.1)}
              class="group flex flex-col rounded-2xl border border-stroke-2 dark:border-stroke-6 hover:border-primary-500/30 dark:hover:border-primary-500/30 overflow-hidden transition-all duration-300 hover:shadow-[0_8px_40px_rgba(27,58,107,0.10)]"
            >
              <!-- Gradient header with metric -->
              <div
                class="relative h-[190px] p-7 flex flex-col justify-between overflow-hidden"
                style={`background: ${story.accent}`}
              >
                <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 28px 28px;" aria-hidden="true"></div>
                <div class="relative flex items-center justify-between">
                  <span class="inline-block bg-white/15 text-white text-tagline-3 font-semibold tracking-widest uppercase px-3 py-1 rounded-full">{story.tag}</span>
                  <span class="text-white/60 text-tagline-3">{story.readTime}</span>
                </div>
                <div class="relative">
                  <p class="text-white/70 text-tagline-3 font-semibold uppercase tracking-widest mb-3">{story.eyebrow}</p>
                  <p class="text-white/70 text-tagline-3 font-medium uppercase tracking-wider mb-1">{story.metricLabel}</p>
                  <p class="text-white font-bold" style="font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1;">{story.metric}</p>
                </div>
              </div>

              <!-- Body -->
              <div class="flex-1 flex flex-col p-7 bg-background-1 dark:bg-background-8 gap-3">
                <h2 class="text-heading-5 font-semibold text-secondary dark:text-accent leading-snug group-hover:text-primary-500 transition-colors duration-200">{story.headline}</h2>
                <p class="text-tagline-2 text-secondary/70 dark:text-accent/70 leading-relaxed flex-1">{story.excerpt}</p>
                <div class="flex items-center gap-2 text-primary-500 font-medium text-tagline-2 pt-1">
                  Read the story
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA banner -->
    <section class="py-16 md:py-20 border-t border-stroke-2 dark:border-stroke-6">
      <div class="main-container">
        <div
          class="relative rounded-2xl p-10 md:p-14 overflow-hidden flex flex-col md:flex-row items-center gap-10 md:gap-16"
          style="background: linear-gradient(135deg, #112445 0%, #1b3a6b 60%, #4a6ec7 100%)"
        >
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 32px 32px;" aria-hidden="true"></div>

          <!-- Left: text + buttons -->
          <div class="relative z-10 flex-1 space-y-6">
            <div class="space-y-3">
              <p class="text-white text-tagline-3 font-semibold uppercase tracking-widest">Your agency, next</p>
              <h2 class="text-white leading-tight">What's leaking from your operations right now?</h2>
              <p class="text-white/75 text-tagline-1 leading-relaxed max-w-[460px]">Import your contracts, clients, and services. Insighty surfaces the gaps in minutes — not months.</p>
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <Button kind="outline-white" href="/founding-member">Get Early Access</Button>
              <Button kind="arrow" href="/request-a-demo">Request a Demo</Button>
            </div>
          </div>

          <!-- Right: dashboard illustration, pinned to bottom -->
          <div class="relative z-10 shrink-0 hidden md:flex items-end self-end">
            <svg width="340" height="240" viewBox="0 0 340 240" fill="none" aria-hidden="true">
              <!-- Main dashboard card -->
              <rect x="0" y="30" width="280" height="210" rx="16" fill="white" fill-opacity="0.08" stroke="white" stroke-opacity="0.15" stroke-width="1"/>
              <!-- Card header lines -->
              <rect x="18" y="50" width="100" height="6" rx="3" fill="white" fill-opacity="0.5"/>
              <rect x="18" y="62" width="64" height="4" rx="2" fill="white" fill-opacity="0.25"/>
              <!-- Chart bars growing up from bottom -->
              <rect x="18"  y="178" width="18" height="52" rx="4" fill="white" fill-opacity="0.10"/>
              <rect x="42"  y="158" width="18" height="72" rx="4" fill="white" fill-opacity="0.14"/>
              <rect x="66"  y="168" width="18" height="62" rx="4" fill="white" fill-opacity="0.12"/>
              <rect x="90"  y="148" width="18" height="82" rx="4" fill="#6b8fd6" fill-opacity="0.60"/>
              <rect x="114" y="138" width="18" height="92" rx="4" fill="#6b8fd6" fill-opacity="0.85"/>
              <rect x="138" y="153" width="18" height="77" rx="4" fill="white" fill-opacity="0.18"/>
              <rect x="162" y="162" width="18" height="68" rx="4" fill="white" fill-opacity="0.13"/>
              <rect x="186" y="155" width="18" height="75" rx="4" fill="white" fill-opacity="0.10"/>
              <rect x="210" y="170" width="18" height="60" rx="4" fill="white" fill-opacity="0.08"/>
              <rect x="234" y="160" width="18" height="70" rx="4" fill="white" fill-opacity="0.07"/>
              <!-- Floating metric badge -->
              <rect x="168" y="44" width="100" height="44" rx="12" fill="white" fill-opacity="0.13" stroke="white" stroke-opacity="0.22" stroke-width="1"/>
              <text x="218" y="63" text-anchor="middle" fill="white" fill-opacity="0.95" font-size="14" font-weight="700" font-family="-apple-system,BlinkMacSystemFont,sans-serif">€30,000+</text>
              <text x="218" y="79" text-anchor="middle" fill="white" fill-opacity="0.55" font-size="9" font-weight="500" font-family="-apple-system,BlinkMacSystemFont,sans-serif">RECOVERED / YEAR</text>
              <!-- Small secondary floating card -->
              <rect x="226" y="130" width="100" height="48" rx="10" fill="white" fill-opacity="0.10" stroke="white" stroke-opacity="0.15" stroke-width="1"/>
              <text x="276" y="150" text-anchor="middle" fill="white" fill-opacity="0.55" font-size="9" font-weight="600" font-family="-apple-system,BlinkMacSystemFont,sans-serif">INVOICES SENT</text>
              <text x="276" y="168" text-anchor="middle" fill="white" fill-opacity="0.90" font-size="15" font-weight="700" font-family="-apple-system,BlinkMacSystemFont,sans-serif">24</text>
            </svg>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
