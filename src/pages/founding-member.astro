---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/organisms/Header.astro'
import Footer from '../components/organisms/Footer.astro'
import Button from '../components/atoms/Button.astro'

const spotsRemaining = 20
const spotsClaimed = 4

const benefits = [
  {
    icon: `<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2L13.09 8.26L20 9.27L15 14.14L16.18 21.02L11 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L11 2Z"/></svg>`,
    title: 'Lifetime pricing lock',
    body: 'The rate you sign up at is yours permanently. No annual price increases, no "market adjustment" emails. Founding member rates are frozen for life — regardless of where pricing goes after launch.',
  },
  {
    icon: `<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="9"/><path d="M11 7v4l3 3"/></svg>`,
    title: 'First access to every release',
    body: 'New modules, feature updates, Pixel AI improvements — you get access weeks before public release. You run on the most advanced version of Insighty, every time.',
  },
  {
    icon: `<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Direct line to the product team',
    body: "Your workflow, your pain points, your agency's reality shapes the roadmap. Founding members get a direct channel to the team — not a feedback form. We built the first version from real agency input; you help build the next.",
  },
  {
    icon: `<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'White-glove onboarding',
    body: "We migrate your data, map your projects, and configure your workspace ourselves. No reading docs alone. Founding members get a dedicated onboarding session — we're not done until you're running.",
  },
  {
    icon: `<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="18" height="14" rx="2"/><path d="M16 7V5a4 4 0 0 0-8 0v2"/><line x1="12" y1="12" x2="12" y2="15"/><circle cx="12" cy="15" r="1" fill="currentColor"/></svg>`,
    title: 'Private founding member community',
    body: 'A closed group of agency operators who got in early. Compare notes, share what works, and talk directly to the Insighty team. No noise, no vendors, no outsiders — just people building serious agencies.',
  },
  {
    icon: `<svg viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/></svg>`,
    title: 'Founding member badge',
    body: "Permanently marked in your account as someone who believed in Insighty before it launched. The agencies that built this with us — acknowledged, always.",
  },
]

const roadmapBuilt = [
  'Revenue & financial operations hub',
  'Project & delivery management with budget tracking',
  'Client health scoring & churn risk indicators',
  'Contract renewal pipeline',
  'Hosting & domain infrastructure registry',
  'Time tracking & resource utilisation view',
  'Pixel AI v1.0 — queries, proactive alerts, anomaly detection',
  'Integrations: Jira, Asana, ClickUp, Linear, HubSpot, Xero, QuickBooks, Slack',
]

const roadmapComing = [
  { label: 'Q3 2026', items: ['Mobile app (iOS + Android)', 'Pixel AI 2.0 — proposal builder & contract analysis'] },
  { label: 'Q4 2026', items: ['White-label client portal', 'Advanced resource planning & capacity management'] },
  { label: '2027', items: ['Custom API access & webhooks', 'Agency network & referral tracking'] },
]
---

<BaseLayout
  title="Founding Member — Insighty"
  description="Join Insighty as a founding member. Get lifetime pricing, first access to every release, and a direct line to shape the product. Limited to 20 spots."
>
  <Header />
  <main>

    <!-- ========================= Hero ========================= -->
    <section
      class="relative overflow-hidden pt-[130px] sm:pt-[145px] md:pt-[160px] pb-20 md:pb-28"
      style="background: linear-gradient(160deg, #080e1f 0%, #0c1832 35%, #112444 65%, #1a3468 100%)"
    >
      <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[600px] select-none" style="background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(74,110,199,0.28) 0%, transparent 70%);"></div>
      <div class="absolute inset-0 opacity-[0.035]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>

      <div class="main-container relative z-10">
        <div class="max-w-[760px] mx-auto text-center space-y-7">

          <!-- Badge -->
          <span class="inline-flex items-center gap-2.5 text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/20 px-4 py-1.5">
            <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>
            {spotsRemaining} founding spots remaining
          </span>

          <h1 class="text-white leading-tight">
            Join the agencies<br />
            <span class="text-white">building with us.</span>
          </h1>

          <p class="text-white/80 text-tagline-1 max-w-[560px] mx-auto leading-relaxed">
            Insighty is launching soon — and it's already operational for early agencies. We're opening {spotsRemaining} founding spots for the operators who want to grow with us, not wait for us.
          </p>

          <!-- Spot progress bar -->
          <div class="max-w-[400px] mx-auto space-y-2.5">
            <div class="flex justify-between text-tagline-3 text-white/50">
              <span>{spotsClaimed} spots claimed</span>
              <span>{spotsRemaining} remaining of 24</span>
            </div>
            <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
              <div
                class="progress-fill h-full rounded-full"
                style={`width: ${(spotsClaimed / 24) * 100}%;`}
              ></div>
            </div>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
            <Button kind="outline-white" href="#claim-spot">
              <span>Claim my founding spot</span>
            </Button>
            <Button kind="arrow" href="#why-now">Why join now?</Button>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================= Why join now ========================= -->
    <section id="why-now" class="bg-background-1 dark:bg-background-8 py-20 md:py-28 border-b border-stroke-2 dark:border-stroke-6">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 xl:gap-20 items-center">

          <!-- Left: story + USPs -->
          <div class="space-y-10">
            <div class="space-y-5">
              <span class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/70 dark:text-accent/70">The honest pitch</span>
              <h2 class="text-secondary dark:text-accent">We're building in public. You should be part of it.</h2>
              <div class="space-y-4 text-tagline-1 text-secondary/75 dark:text-accent/75 leading-relaxed">
                <p>
                  Insighty's core platform is already running — revenue operations, project management, client health, hosting registry, and Pixel AI are all live. Agencies are using it today to replace 4–6 separate tools.
                </p>
                <p>
                  But we're not done. The roadmap ahead — mobile app, AI proposal builder, white-label client portals — is ambitious. We're building it fast, with direct input from the agencies using it.
                </p>
                <p>
                  A founding member isn't buying a finished product. They're joining the team that's finishing it. In exchange for that trust, you get pricing and access that nobody who joins after launch ever will.
                </p>
              </div>
            </div>

            <!-- Three USP rows -->
            <ul class="space-y-6 border-t border-stroke-2 dark:border-stroke-6 pt-8">
              {[
                {
                  icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2l1.8 5.5H17l-4.6 3.3 1.7 5.2L10 13l-4.1 3 1.7-5.2L3 7.5h5.2z"/></svg>`,
                  label: 'Rate locked forever',
                  desc: 'Your founding price never increases — even when Insighty raises prices after launch.',
                },
                {
                  icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13a2 2 0 0 1-2 2H6l-3 3V4a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z"/></svg>`,
                  label: 'You shape the roadmap',
                  desc: 'Direct access to the product team. Your workflows influence what we build next.',
                },
                {
                  icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="8"/><path d="M10 6v4l2.5 2.5"/></svg>`,
                  label: 'Full access from day one',
                  desc: "Not a waitlist. You're in from day one — using the platform while it grows around you.",
                },
              ].map(item => (
                <li class="flex items-start gap-4">
                  <span class="w-8 h-8 rounded-lg bg-primary-500/10 text-primary-500 flex items-center justify-center shrink-0 mt-0.5">
                    <span class="w-4 h-4 block" set:html={item.icon} />
                  </span>
                  <div>
                    <p class="text-tagline-1 font-semibold text-secondary dark:text-accent">{item.label}</p>
                    <p class="text-tagline-2 text-secondary/65 dark:text-accent/65 mt-0.5 leading-relaxed">{item.desc}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Right: founding pricing card -->
          <div class="rounded-2xl border border-stroke-2 dark:border-stroke-5 bg-background-2 dark:bg-background-7 overflow-hidden">

            <!-- Card header -->
            <div class="px-8 py-5 border-b border-stroke-2 dark:border-stroke-6 flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse shrink-0"></span>
              <span class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Founding member pricing</span>
            </div>

            <div class="p-8 space-y-8">
              <!-- Price display -->
              <div class="space-y-2">
                <p class="text-tagline-2 text-secondary/60 dark:text-accent/60">First year — founding rate</p>
                <div class="flex items-end gap-3">
                  <span class="font-bold text-secondary dark:text-accent" style="font-size: 3rem; line-height: 1; letter-spacing: -0.03em;">50% off</span>
                </div>
                <p class="text-tagline-2 text-secondary/70 dark:text-accent/70">any plan for your first 12 months</p>
              </div>

              <!-- What you get -->
              <ul class="space-y-3.5">
                {[
                  'Solo from €24.95 / mo (was €49.90)',
                  'Pro from €17.49 / user / mo (was €34.99)',
                  'Agency from €14.50 / user / mo (was €29)',
                  'Rate locked — never increases after year one',
                  'All features included from day one',
                  'White-glove onboarding included',
                ].map(line => (
                  <li class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="text-tagline-2 text-secondary/80 dark:text-accent/80 leading-relaxed">{line}</span>
                  </li>
                ))}
              </ul>

              <!-- CTA -->
              <div class="space-y-3 pt-2">
                <Button kind="primary" href="#claim-spot" full>
                  <span>Claim founding access</span>
                </Button>
                <p class="text-tagline-3 text-secondary/50 dark:text-accent/50 text-center">
                  {spotsRemaining} spots remaining · No credit card to apply
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================= Benefits ========================= -->
    <section
      class="py-20 md:py-28 relative overflow-hidden"
      style="background: linear-gradient(160deg, #060b18 0%, #091325 40%, #0d1d3a 100%)"
    >
      <div class="pointer-events-none absolute -top-64 left-1/2 -translate-x-1/2 w-[800px] h-[600px] select-none" style="background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(74,110,199,0.2) 0%, transparent 70%);"></div>

      <div class="main-container relative z-10">
        <div class="text-center max-w-[560px] mx-auto mb-14 space-y-4">
          <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/20 px-4 py-1.5">Founding member benefits</span>
          <h2 class="text-white">Why founding members get what nobody else will</h2>
          <p class="text-white/75 text-tagline-1 leading-relaxed">
            These benefits don't transfer. They don't expire. They exist specifically for the agencies who joined before Insighty was a household name.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
          {benefits.map(b => (
            <div
              class="rounded-2xl p-7 space-y-5"
              style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);"
            >
              <span class="w-11 h-11 rounded-xl bg-primary-500/15 text-primary-400 flex items-center justify-center">
                <span class="w-5 h-5 block" set:html={b.icon} />
              </span>
              <div class="space-y-2.5">
                <p class="text-heading-6 font-semibold text-white">{b.title}</p>
                <p class="text-tagline-2 text-white/75 leading-relaxed">{b.body}</p>
              </div>
            </div>
          ))}
        </div>


      </div>
    </section>

    <!-- ========================= Form ========================= -->
    <section id="claim-spot" class="bg-background-2 dark:bg-background-7 py-20 md:py-28 border-t border-stroke-2 dark:border-stroke-6">
      <div class="main-container">
        <div class="max-w-[560px] mx-auto space-y-10">

          <!-- Header -->
          <div id="founding-form-header" class="text-center space-y-4">
            <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80 border border-stroke-2 dark:border-stroke-5 px-4 py-1.5">Founding member application</span>
            <h2 class="text-secondary dark:text-accent">Apply for founding access</h2>
            <p class="text-tagline-1 text-secondary/70 dark:text-accent/70 leading-relaxed max-w-[420px] mx-auto">
              We review every application personally and will confirm your spot within one business day.
            </p>
          </div>

          <!-- Form -->
          <form class="space-y-4" id="founding-form" novalidate data-netlify="true" name="founding-member" netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="founding-member" />
            <input type="text" name="bot-field" class="sr-only" tabindex="-1" autocomplete="off" />

            <div class="grid grid-cols-2 gap-3">
              <div class="space-y-1.5">
                <label for="fm-first-name" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                  First name <span class="text-primary-500">*</span>
                </label>
                <input
                  id="fm-first-name"
                  name="first_name"
                  type="text"
                  placeholder="Sam"
                  required
                  autocomplete="given-name"
                  class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 transition-colors"
                />
              </div>
              <div class="space-y-1.5">
                <label for="fm-last-name" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                  Last name <span class="text-primary-500">*</span>
                </label>
                <input
                  id="fm-last-name"
                  name="last_name"
                  type="text"
                  placeholder="Carter"
                  required
                  autocomplete="family-name"
                  class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 transition-colors"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="fm-email" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Work email <span class="text-primary-500">*</span>
              </label>
              <input
                id="fm-email"
                name="email"
                type="email"
                placeholder="sam@youragency.com"
                required
                autocomplete="email"
                class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 transition-colors"
              />
            </div>

            <div class="space-y-1.5">
              <label for="fm-agency" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Agency name <span class="text-primary-500">*</span>
              </label>
              <input
                id="fm-agency"
                name="agency_name"
                type="text"
                placeholder="Your agency"
                required
                autocomplete="organization"
                class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 transition-colors"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div class="space-y-1.5">
                <label for="fm-team-size" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                  Team size <span class="text-primary-500">*</span>
                </label>
                <div class="relative">
                  <select
                    id="fm-team-size"
                    name="team_size"
                    required
                    class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent focus:outline-none focus:border-primary-500 transition-colors appearance-none cursor-pointer"
                  >
                    <option value="" disabled selected>Select</option>
                    <option value="1-5">1–5 people</option>
                    <option value="6-15">6–15 people</option>
                    <option value="16-30">16–30 people</option>
                    <option value="31+">31+ people</option>
                  </select>
                  <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-secondary/30 dark:text-accent/30">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </div>
              <div class="space-y-1.5">
                <label for="fm-role" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                  Your role <span class="text-primary-500">*</span>
                </label>
                <div class="relative">
                  <select
                    id="fm-role"
                    name="role"
                    required
                    class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent focus:outline-none focus:border-primary-500 transition-colors appearance-none cursor-pointer"
                  >
                    <option value="" disabled selected>Select</option>
                    <option value="owner">Agency Owner / CEO</option>
                    <option value="pm">Project Manager</option>
                    <option value="ops">Operations Manager</option>
                    <option value="finance">Finance / Accounting</option>
                    <option value="other">Other</option>
                  </select>
                  <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-secondary/30 dark:text-accent/30">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="fm-challenge" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Biggest ops challenge right now <span class="text-primary-500">*</span>
              </label>
              <div class="relative">
                <select
                  id="fm-challenge"
                  name="challenge"
                  required
                  class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent focus:outline-none focus:border-primary-500 transition-colors appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Select</option>
                  <option value="revenue">Revenue visibility & forecasting</option>
                  <option value="profitability">Project & client profitability</option>
                  <option value="tools">Too many tools, no single source of truth</option>
                  <option value="reporting">Client & management reporting</option>
                  <option value="capacity">Resource planning & capacity</option>
                  <option value="all">Honestly, all of the above</option>
                </select>
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-secondary/30 dark:text-accent/30">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="fm-message" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Anything else we should know? <span class="text-secondary/30 dark:text-accent/30">(optional)</span>
              </label>
              <textarea
                id="fm-message"
                name="message"
                rows="3"
                placeholder="Tell us about your current stack, how many clients you manage, or what you'd want to see first..."
                class="founding-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 transition-colors resize-none"
              ></textarea>
            </div>

            <div class="pt-1 space-y-3">
              <button
                type="submit"
                id="founding-submit-btn"
                class="btn btn-primary btn-md w-full"
              >
                <span>Claim my founding spot</span>
              </button>
              <p class="text-tagline-3 text-secondary/75 dark:text-accent/75 text-center leading-relaxed">
                {spotsRemaining} spots remaining. We'll reply within one business day.
              </p>
              <p id="founding-form-error" class="hidden text-[11px] text-red-500 text-center">Something went wrong. Please try again or email us at sales@insighty.io.</p>
            </div>

          </form>

          <!-- Success state -->
          <div id="founding-success" style="display:none;" class="text-center space-y-5 py-8">
            <div class="size-14 rounded-2xl bg-primary-500/8 border border-primary-500/20 flex items-center justify-center mx-auto">
              <svg class="w-6 h-6 text-primary-500" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <div class="space-y-2">
              <p class="text-heading-6 font-semibold text-secondary dark:text-accent">You're on the list.</p>
              <p class="text-tagline-1 text-secondary/75 dark:text-accent/75 max-w-[340px] mx-auto leading-relaxed">
                Thanks for applying. We review every founding member personally and will reach out within one business day to confirm your spot.
              </p>
            </div>
            <div class="pt-2 flex flex-wrap justify-center gap-3">
              <Button kind="outline-white" href="/blog">
                <span>Read the blog</span>
              </Button>
              <a href="/" class="btn btn-md border border-stroke-2 dark:border-stroke-6 text-secondary/70 dark:text-accent/70">
                <span>Back to home</span>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  .progress-fill {
    background: linear-gradient(90deg, #3b5fc0 0%, #6e9ef5 50%, #a5c4ff 100%);
    background-size: 200% 100%;
    animation: progress-shimmer 2.5s ease-in-out infinite;
  }
  @keyframes progress-shimmer {
    0%   { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .founding-left,
  .founding-right {
    opacity: 0;
    transform: translateY(16px);
    animation: panel-in 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .founding-right { animation-delay: 0.1s; }

  @keyframes panel-in {
    to { opacity: 1; transform: translateY(0); }
  }

  .founding-input:focus {
    box-shadow: 0 0 0 3px rgba(27, 58, 107, 0.08);
  }
  :global(.dark) .founding-input:focus {
    box-shadow: 0 0 0 3px rgba(74, 110, 199, 0.12);
  }
  .founding-input.error {
    border-color: #ef4444 !important;
  }
</style>

<script>
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
  const form = document.getElementById('founding-form') as HTMLFormElement | null
  const formHeader = document.getElementById('founding-form-header')
  const successState = document.getElementById('founding-success')
  const submitBtn = document.getElementById('founding-submit-btn') as HTMLButtonElement | null
  const formError = document.getElementById('founding-form-error')

  function getError(el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string {
    if (el.required && !el.value.trim()) return 'This field is required'
    if (el.type === 'email' && el.value && !EMAIL_RE.test(el.value)) return 'Please enter a valid email address'
    return ''
  }

  // Blur validation
  form?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
    'input[required], select[required]'
  ).forEach(el => {
    el.addEventListener('blur', () => {
      el.classList.toggle('error', !!getError(el))
    })
    el.addEventListener('input', () => {
      if (el.classList.contains('error') && !getError(el)) el.classList.remove('error')
    })
  })

  if (form && successState && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      let valid = true
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input[required], select[required]'
      ).forEach(el => {
        const err = getError(el)
        el.classList.toggle('error', !!err)
        if (err) valid = false
      })
      if (!valid) return

      const span = submitBtn.querySelector('span')
      if (span) span.textContent = 'Sending...'
      submitBtn.disabled = true
      formError?.classList.add('hidden')

      try {
        const body = new URLSearchParams()
        new FormData(form).forEach((v, k) => body.append(k, v as string))
        const ok = (await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        })).ok

        if (ok) {
          form.style.display = 'none'
          if (formHeader) formHeader.style.display = 'none'
          successState.style.display = 'block'
        } else {
          formError?.classList.remove('hidden')
          if (span) span.textContent = 'Claim my founding spot'
          submitBtn.disabled = false
        }
      } catch {
        formError?.classList.remove('hidden')
        if (span) span.textContent = 'Claim my founding spot'
        submitBtn.disabled = false
      }
    })
  }
</script>
