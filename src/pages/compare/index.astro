    name: 'OpenProject',
    category: 'Open Source PM',
    tagline: 'Open-source Jira alternative. Insighty for agency revenue visibility above the projects.',
    color: '#1A67A3',
    available: false,
  },
  {
    slug: 'taiga',
    name: 'Taiga',
    category: 'Open Source PM',
    tagline: 'Open-source agile for cross-functional teams. Insighty for the ops layer those teams need.',
    color: '#45BF6A',
    available: false,
  },
  {
    slug: 'orangescrum',
    name: 'Orangescrum',
