const totalCount = projectManagement.length + agencyPsa.length
---

<BaseLayout
  title="Insighty vs. Competitors — Agency Software Comparisons"
  description={`Compare Insighty with ${totalCount} agency management, project management, and PSA tools. Understand how Insighty's financial intelligence layer differs from each alternative.`}
>
  <Header />
  <main>

    <!-- Hero -->
    <section
      class="pt-[140px] sm:pt-[150px] md:pt-[160px] pb-16 md:pb-24 relative overflow-hidden"
      style="background: linear-gradient(135deg, #0a1628 0%, #112445 50%, #1a3a70 100%)"
    >
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>
      <div class="main-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">

          <!-- Left: copy -->
          <div class="space-y-6">
            <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/30 px-4 py-1.5">Platform Comparisons</span>
            <h1 class="text-white">Insighty vs.<br /><span class="hero-text-gradient hero-text-color-1">the field</span></h1>
            <p class="text-white max-w-[480px] text-tagline-1">
              Insighty is not a project management tool. It's the financial and operations intelligence layer that sits on top of the tools your agency already uses. Here's how it compares with {totalCount} alternatives.
            </p>
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a href="/founding-member" class="btn btn-md btn-outline-white"><span>Request early access</span></a>
              <a href="/#platform" class="inline-flex items-center gap-2 text-white/75 hover:text-white text-tagline-2 font-medium uppercase tracking-wide transition-colors duration-200 group">
                <span>See the platform</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Right: tool mosaic -->
          <div class="hidden lg:grid grid-cols-5 gap-3">
            {[...projectManagement, ...agencyPsa].slice(0, 15).map(tool => (
              <div
                class="aspect-square rounded-2xl flex items-center justify-center text-white font-bold text-heading-5 opacity-80"
                style={`background: color-mix(in srgb, ${tool.color} 80%, #0a1628 20%)`}
                title={tool.name}
              >
                {tool.icon ? (
                  <img src={tool.icon} alt={tool.name} class="h-6 w-auto object-contain brightness-0 invert opacity-90" loading="lazy" decoding="async" />
                ) : (
                  tool.name[0]
                )}
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- Project Management section -->
    <section class="bg-background-2 dark:bg-background-7 py-14 md:py-20">
      <div class="main-container space-y-8">
        <div class="flex items-end justify-between gap-4 flex-wrap border-b border-stroke-2 dark:border-stroke-6 pb-6">
          <div class="space-y-1.5">
            <span class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/40 dark:text-accent/40">Category 01</span>
            <h2 class="text-secondary dark:text-accent">Project Management Tools</h2>
          </div>
          <span class="text-tagline-2 text-secondary/40 dark:text-accent/40">{projectManagement.length} tools</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
          {projectManagement.map(tool => (
            <a
              href={tool.available ? `/compare/insighty-vs-${tool.slug}` : undefined}
              class={`group relative flex flex-col bg-background-1 dark:bg-background-6 rounded-2xl border border-stroke-2 dark:border-stroke-5 p-6 gap-4 transition-all duration-300 ${tool.available ? 'hover:border-primary-500/40 hover:shadow-2 cursor-pointer' : 'cursor-default'}`}
              aria-label={`Insighty vs ${tool.name}`}
            >
              <!-- Top row -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex flex-col gap-3">
                  {tool.icon ? (
                    <span class="h-14 px-4 rounded-xl flex items-center bg-white dark:bg-white/10 w-fit">
                      <img src={tool.icon} alt={tool.name} class="h-8 w-auto object-contain" loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <span
                      class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-white text-heading-6 font-bold"
                      style={`background: ${tool.color}`}
                    >
                      {tool.name[0]}
                    </span>
                  )}
                  <div>
                    <p class="text-heading-6 font-semibold text-secondary dark:text-accent leading-tight">{tool.name}</p>
                    <p class="text-tagline-2 text-secondary/40 dark:text-accent/40">{tool.category}</p>
                  </div>
                </div>
                {tool.available ? (
                  <span class="shrink-0 text-secondary/30 dark:text-accent/30 group-hover:text-primary-400 transition-colors duration-200">
                    <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="shrink-0 text-tagline-3 text-secondary/25 dark:text-accent/25 font-medium uppercase tracking-widest">Soon</span>
                )}
              </div>

              <!-- Tagline -->
              <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 leading-relaxed flex-1">{tool.tagline}</p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-stroke-2 dark:border-stroke-5">
                <span class="text-tagline-3 font-medium text-secondary/35 dark:text-accent/35">Insighty vs {tool.name}</span>
                {tool.available && (
                  <span class="badge badge-primary text-tagline-3">Live</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Agency & PSA section -->
    <section class="bg-background-1 dark:bg-background-8 py-14 md:py-20">
      <div class="main-container space-y-8">
        <div class="flex items-end justify-between gap-4 flex-wrap border-b border-stroke-2 dark:border-stroke-6 pb-6">
          <div class="space-y-1.5">
            <span class="text-tagline-3 uppercase tracking-widest font-medium text-secondary/40 dark:text-accent/40">Category 02</span>
            <h2 class="text-secondary dark:text-accent">Agency Management & PSA</h2>
          </div>
          <span class="text-tagline-2 text-secondary/40 dark:text-accent/40">{agencyPsa.length} tools</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
          {agencyPsa.map(tool => (
            <a
              href={tool.available ? `/compare/insighty-vs-${tool.slug}` : undefined}
              class={`group relative flex flex-col bg-background-2 dark:bg-background-6 rounded-2xl border border-stroke-2 dark:border-stroke-5 p-6 gap-4 transition-all duration-300 ${tool.available ? 'hover:border-primary-500/40 hover:shadow-2 cursor-pointer' : 'cursor-default'}`}
              aria-label={`Insighty vs ${tool.name}`}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="flex flex-col gap-3">
                  {tool.icon ? (
                    <span class="h-14 px-4 rounded-xl flex items-center bg-white dark:bg-white/10 w-fit">
                      <img src={tool.icon} alt={tool.name} class="h-8 w-auto object-contain" loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <span
                      class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 text-white text-heading-6 font-bold"
                      style={`background: ${tool.color}`}
                    >
                      {tool.name[0]}
                    </span>
                  )}
                  <div>
                    <p class="text-heading-6 font-semibold text-secondary dark:text-accent leading-tight">{tool.name}</p>
                    <p class="text-tagline-2 text-secondary/40 dark:text-accent/40">{tool.category}</p>
                  </div>
                </div>
                {tool.available ? (
                  <span class="shrink-0 text-secondary/30 dark:text-accent/30 group-hover:text-primary-400 transition-colors duration-200">
                    <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                ) : (
                  <span class="shrink-0 text-tagline-3 text-secondary/25 dark:text-accent/25 font-medium uppercase tracking-widest">Soon</span>
                )}
              </div>

              <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 leading-relaxed flex-1">{tool.tagline}</p>

              <div class="flex items-center justify-between pt-3 border-t border-stroke-2 dark:border-stroke-5">
                <span class="text-tagline-3 font-medium text-secondary/35 dark:text-accent/35">Insighty vs {tool.name}</span>
                {tool.available && (
                  <span class="badge badge-primary text-tagline-3">Live</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-background-2 dark:bg-background-7 py-16 md:py-20">
      <div class="main-container">
        <div class="rounded-2xl overflow-hidden" style="background: linear-gradient(135deg, #112445 0%, #1a3a70 100%)">
          <div class="px-8 py-12 md:px-16 md:py-16 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
            <div class="space-y-4">
              <h2 class="text-white">Not sure which category fits your agency?</h2>
              <p class="text-white/65 text-tagline-1 leading-relaxed">
                Insighty isn't a task manager or a CRM. It's the financial intelligence layer — revenue planning, maintenance contracts, hosting, domains, invoicing, and forecasting in one view. Request a demo and we'll show you where it fits in your current stack.
              </p>
            </div>
            <div class="flex flex-col sm:flex-row md:flex-col xl:flex-row gap-3 md:justify-start xl:justify-end">
              <a href="/contact" class="btn btn-md btn-primary"><span>Request early access</span></a>
              <a href="/blog" class="btn btn-md btn-secondary !border-white/20 !text-white hover:!bg-white/10"><span>Read the blog</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
