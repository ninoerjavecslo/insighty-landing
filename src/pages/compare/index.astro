    category: 'Agency Management',
    tagline: 'Open-source agency management with time tracking. Insighty adds deeper financial intelligence.',
    color: '#059669',
    available: false,
  },
  {
    slug: 'harvest',
    name: 'Harvest',
    category: 'Time Tracking & Invoicing',
    tagline: 'Time tracking and invoicing done simply. Insighty for the multi-stream financial ops Harvest does not cover.',
    color: '#FA5C00',
    available: true,
  },
  {
    slug: 'paymo',
    name: 'Paymo',
    category: 'Project & Billing',
