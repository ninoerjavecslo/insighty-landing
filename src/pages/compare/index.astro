    color: '#5C4EFF',
    available: false,
  },
  {
    slug: 'accelo',
    name: 'Accelo',
    category: 'PSA',
    tagline: 'Broad professional services automation. Insighty focused exclusively on agency revenue intelligence.',
    color: '#00A5A8',
    available: false,
  },
  {
