---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/organisms/Header.astro'
import Footer from '../../components/organisms/Footer.astro'

const title = 'Insighty vs Monday.com: Agency Financial Intelligence vs Work OS'
const description = 'Monday.com is a flexible work OS. Insighty is the financial intelligence layer agencies need — revenue planning, retainer billing, contracts, and forecasting in one platform.'

const checks = [
  'Revenue planning across all income streams in one view',
  'Maintenance contract billing with hours and scope tracking',
  '"This Month" dashboard — every invoice visible before it slips',
  'Hosting and domain renewal tracking with automated alerts',
  'Probability-weighted sales pipeline and forecast',
  'Resource capacity planning with billability reports',
]

const mondayStrengths = [
  { label: 'Visual, flexible boards', detail: 'Highly customisable work views — tables, kanban, timelines, Gantt, maps, and more.' },
  { label: 'Powerful automations', detail: 'No-code automations that trigger actions across boards, CRM, and external tools.' },
  { label: 'Built-in CRM', detail: 'Sales pipeline, contact management, and deal tracking — all inside Monday.' },
  { label: 'Forms and intake', detail: 'Client-facing intake forms that feed directly into project boards.' },
  { label: 'Extensive integrations', detail: '200+ integrations and a strong API for custom workflows.' },
  { label: 'Dashboards and reporting', detail: 'Cross-board reporting with widgets for status, workload, and custom KPIs.' },
]

const gaps = [
  {
    title: 'Which clients are profitable this quarter?',
    body: 'Monday tracks work and deals. It does not know the contract value per project, budget burn, or whether a retainer client is being over-served. Profitability is invisible.',
  },
  {
    title: 'Which retainers need invoicing this month?',
    body: 'Maintenance contracts and hosting renewals are not managed in Monday. You can build workarounds, but they require constant maintenance — and still do not give you the financial picture.',
  },
  {
    title: 'What does revenue look like next quarter?',
    body: 'Monday has a CRM with deal values, but no concept of probability-weighted revenue that combines pipeline, committed contracts, retainers, and project invoices into a single forecast.',
  },
  {
    title: 'Is this retainer client over the hours budget?',
    body: 'Monday tracks tasks and time. It does not know the billing scope, included hours, or change request value for a maintenance contract. Over-delivery goes unnoticed.',
  },
]

type Mark = 'yes' | 'no' | 'partial'
interface Row { feature: string; monday: Mark; insighty: Mark; note?: string }

const rows: Row[] = [
  { feature: 'Visual project boards', monday: 'yes', insighty: 'no', note: 'Monday is best-in-class for flexible visual work management.' },
  { feature: 'CRM and sales pipeline', monday: 'yes', insighty: 'partial', note: 'Monday has a full CRM. Insighty has a pipeline for agency revenue forecasting.' },
  { feature: 'Workflow automation', monday: 'yes', insighty: 'no', note: 'Monday has no-code automation across boards and tools.' },
  { feature: 'Time tracking', monday: 'partial', insighty: 'yes', note: 'Monday has basic time tracking. Insighty tracks billable hours against contracts.' },
  { feature: 'Maintenance contract billing', monday: 'no', insighty: 'yes', note: 'Monthly/annual retainers with hours-included scope tracking.' },
  { feature: 'Revenue planning (multi-stream)', monday: 'no', insighty: 'yes', note: 'Projects, retainers, hosting, domains — unified matrix.' },
  { feature: '"This Month" invoice view', monday: 'no', insighty: 'yes', note: 'Every invoice due this month across all revenue types.' },
  { feature: 'Hosting & domain renewal tracking', monday: 'no', insighty: 'yes', note: 'Automated alerts at 90 / 60 / 30 days before expiry.' },
  { feature: 'Probability-weighted forecast', monday: 'partial', insighty: 'yes', note: 'Monday has deal probability. Insighty combines pipeline + contracts + retainers.' },
  { feature: 'Resource utilisation & billability', monday: 'partial', insighty: 'yes', note: 'Monday has workload. Insighty adds billability % and utilisation reporting.' },
  { feature: 'Client financial summary', monday: 'no', insighty: 'yes', note: 'Annual revenue across all contract types per client.' },
  { feature: 'Invoice automation (recurring)', monday: 'no', insighty: 'yes', note: 'Scheduled invoice batches on a set day each month.' },
]

function mark(val: Mark) {
  if (val === 'yes') return { text: '✓', cls: 'text-emerald-500 font-semibold text-base' }
  if (val === 'partial') return { text: '~', cls: 'text-amber-500 font-semibold text-base' }
  return { text: '—', cls: 'text-secondary/25 dark:text-accent/20 text-base' }
}
---

<BaseLayout {title} {description}>
  <Header />
  <main>

    <section
      class="pt-[140px] sm:pt-[150px] md:pt-[160px] pb-16 md:pb-24 relative overflow-hidden"
      style="background: linear-gradient(135deg, #0a1628 0%, #112445 50%, #1a3a70 100%)"
    >
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>
      <div class="main-container relative z-10">
        <nav class="flex items-center gap-2 text-tagline-3 text-white/50 mb-10" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors duration-200">Insighty</a>
          <span>/</span>
          <a href="/compare" class="hover:text-white transition-colors duration-200">Compare</a>
          <span>/</span>
          <span class="text-white/70">Insighty vs Monday.com</span>
        </nav>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div class="space-y-6">
            <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/30 px-4 py-1.5">Platform Comparison</span>
            <h1 class="text-white">
              Insighty vs Monday.com:<br />
              <span class="hero-text-gradient hero-text-color-1">work OS vs financial intelligence</span>
            </h1>
            <p class="text-white max-w-[480px]">
              Monday.com is a powerful work OS for managing projects and teams. Insighty is the financial intelligence layer agencies need — contracts, retainers, revenue planning, and forecasting in one place.
            </p>
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a href="/founding-member" class="btn btn-md btn-outline-white"><span>Join founding members</span></a>
              <a href="/#platform" class="inline-flex items-center gap-2 text-white/75 hover:text-white text-tagline-2 font-medium uppercase tracking-wide transition-colors duration-200 group">
                <span>See the platform</span>
                <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="rounded-2xl p-5 flex flex-wrap items-center gap-4 border backdrop-blur-sm" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.13)">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 bg-white p-2">
                <img src="/images/icons/monday.png" alt="Monday.com" class="w-full h-full object-contain" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-white font-semibold leading-tight">Monday.com</p>
                <p class="text-white text-tagline-1 mt-1">Visual work management OS</p>
              </div>
              <span class="basis-full sm:basis-auto text-tagline-3 uppercase tracking-widest font-semibold px-3 py-1 pl-16 sm:pl-0" style="color: #ff8a96; background: rgba(255,61,87,0.12); border: 1px solid rgba(255,61,87,0.3)">Work OS</span>
            </div>
            <div class="flex items-center gap-4 py-0.5">
              <div class="flex-1 h-px bg-white/10"></div>
              <span class="text-white/55 text-tagline-2 font-semibold tracking-widest uppercase">+ together</span>
              <div class="flex-1 h-px bg-white/10"></div>
            </div>
            <div class="rounded-2xl p-5 flex items-center gap-4 border border-primary-500/30 backdrop-blur-sm" style="background: rgba(74,110,199,0.10)">
              <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #1b3a6b 0%, #4a6ec7 100%)">
                <svg viewBox="0 0 24 24" class="w-7 h-7">
                  <rect x="2" y="16" width="3.5" height="5" rx="1" fill="#a3b8ea"/>
                  <rect x="6.5" y="12" width="3.5" height="9" rx="1" fill="#6e8fd9"/>
                  <rect x="11" y="8" width="3.5" height="13" rx="1" fill="white" opacity="0.9"/>
                  <rect x="15.5" y="4" width="3.5" height="17" rx="1" fill="white" opacity="0.6"/>
                  <circle cx="17.25" cy="2.5" r="1.8" fill="#d4a574"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-white font-semibold leading-tight">Insighty</p>
                <p class="text-white text-tagline-1 mt-1">Client management, contracts & financial ops</p>
              </div>
              <span class="basis-full sm:basis-auto text-tagline-3 uppercase tracking-widest font-semibold px-3 py-1 text-primary-300 pl-16 sm:pl-0" style="background: rgba(74,110,199,0.15); border: 1px solid rgba(74,110,199,0.35)">Finance & Ops</span>
            </div>

          </div>
        </div>
      </div>
    </section>

    <section class="bg-background-1 dark:bg-background-8 py-16 md:py-20">
      <div class="main-container">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-stroke-2 dark:border-stroke-5 bg-background-2 dark:bg-background-6 p-8 space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-white p-1.5">
                <img src="/images/icons/monday.png" alt="Monday.com" class="w-full h-full object-contain" />
              </div>
              <div>
                <p class="text-tagline-1 font-semibold text-secondary dark:text-accent">Monday.com</p>
                <p class="text-tagline-3 text-secondary/70 dark:text-accent/70">Work OS platform</p>
              </div>
            </div>
            <p class="text-tagline-1 text-secondary/70 dark:text-accent/70 leading-relaxed">
              A highly flexible work operating system used by teams of all sizes. Monday.com combines project management, CRM, and workflow automation in a visual, customisable interface that adapts to almost any use case.
            </p>
            <p class="text-tagline-2 font-medium text-secondary/70 dark:text-accent/70 uppercase tracking-widest">Best for</p>
            <ul class="space-y-1.5">
              {['Visual project and work management', 'Sales CRM and deal tracking', 'Team workflow automation', 'Cross-department collaboration'].map(s => (
                <li class="flex items-center gap-2 text-tagline-2 text-secondary/70 dark:text-accent/70">
                  <span class="w-1 h-1 rounded-full bg-secondary/30 dark:bg-accent/30 shrink-0"></span>
                  {s}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl border border-primary-500/30 bg-background-2 dark:bg-background-6 p-8 space-y-4 relative overflow-hidden">
            <div class="absolute inset-0 opacity-[0.03]" style="background: linear-gradient(135deg, #4a6ec7, #a585ff)"></div>
            <div class="relative space-y-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-primary-500 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.5l7-7 4 4 7-7M3 19h18"/>
                  </svg>
                </div>
                <div>
                  <p class="text-tagline-1 font-semibold text-secondary dark:text-accent">Insighty</p>
                  <p class="text-tagline-3 text-secondary/70 dark:text-accent/70">Agency Intelligence Platform</p>
                </div>
              </div>
              <p class="text-tagline-1 text-secondary/70 dark:text-accent/70 leading-relaxed">
                The financial and operational intelligence layer built specifically for agencies. Connects clients, contracts, maintenance retainers, hosting, domains, invoices, and pipeline into one unified revenue view.
              </p>
              <p class="text-tagline-2 font-medium text-secondary/70 dark:text-accent/70 uppercase tracking-widest">Best for</p>
              <ul class="space-y-1.5">
                {['Agency owners and operations managers', 'Revenue planning and invoice tracking', 'Retainer and contract management', 'Financial forecasting and pipeline'].map(s => (
                  <li class="flex items-center gap-2 text-tagline-2 text-secondary/70 dark:text-accent/70">
                    <span class="w-1 h-1 rounded-full bg-primary-400/50 shrink-0"></span>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-background-2 dark:bg-background-7 py-16 md:py-20">
      <div class="main-container space-y-10">
        <div class="max-w-[640px] space-y-3">
          <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Where Monday.com wins</span>
          <h2 class="text-secondary dark:text-accent">Monday.com is excellent at flexible work management</h2>
          <p class="text-tagline-1 text-secondary/80 dark:text-accent/80">Monday's strength is its adaptability — it can be shaped into almost any workflow. Millions of teams use it for good reason.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {mondayStrengths.map(s => (
            <div class="bg-background-1 dark:bg-background-6 rounded-2xl border border-stroke-2 dark:border-stroke-5 p-6 space-y-2">
              <p class="text-tagline-1 font-semibold text-secondary dark:text-accent">{s.label}</p>
              <p class="text-tagline-2 text-secondary/80 dark:text-accent/80 leading-relaxed">{s.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-background-1 dark:bg-background-8 py-16 md:py-20">
      <div class="main-container space-y-10">
        <div class="max-w-[640px] space-y-3">
          <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">The agency blind spot</span>
          <h2 class="text-secondary dark:text-accent">The questions Monday.com cannot answer for agency owners</h2>
          <p class="text-tagline-1 text-secondary/80 dark:text-accent/80">Monday knows your work. It does not know your financial reality.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {gaps.map((g, i) => (
            <div class="rounded-2xl border border-stroke-2 dark:border-stroke-5 bg-background-2 dark:bg-background-6 p-7 space-y-3">
              <div class="flex items-start gap-3">
                <span class="shrink-0 text-tagline-3 font-bold text-secondary/20 dark:text-accent/20 mt-0.5 tabular-nums">0{i + 1}</span>
                <p class="text-tagline-1 font-semibold text-secondary dark:text-accent leading-snug">"{g.title}"</p>
              </div>
              <p class="text-tagline-2 text-secondary/80 dark:text-accent/80 leading-relaxed pl-7">{g.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-background-2 dark:bg-background-7 py-16 md:py-20">
      <div class="main-container space-y-8">
        <div class="max-w-[560px] space-y-3">
          <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Feature comparison</span>
          <h2 class="text-secondary dark:text-accent">What each tool handles</h2>
        </div>
        <div class="rounded-2xl border border-stroke-2 dark:border-stroke-5 overflow-hidden">
          <div class="grid grid-cols-[1fr_100px_100px] md:grid-cols-[1fr_120px_120px] bg-background-1 dark:bg-background-6 border-b border-stroke-2 dark:border-stroke-5 px-6 py-4">
            <p class="text-tagline-2 font-semibold text-secondary/70 dark:text-accent/70 uppercase tracking-widest">Capability</p>
            <p class="text-tagline-2 font-semibold text-secondary/70 dark:text-accent/70 uppercase tracking-widest text-center">Monday</p>
            <p class="text-tagline-2 font-semibold text-primary-400 uppercase tracking-widest text-center">Insighty</p>
          </div>
          {rows.map((row, i) => {
            const m = mark(row.monday)
            const ins = mark(row.insighty)
            return (
              <div class={`grid grid-cols-[1fr_100px_100px] md:grid-cols-[1fr_120px_120px] px-6 py-4 border-b border-stroke-2 dark:border-stroke-5 last:border-0 ${i % 2 === 0 ? 'bg-background-1 dark:bg-background-8' : 'bg-background-2 dark:bg-background-7'}`}>
                <div class="space-y-0.5 pr-4">
                  <p class="text-tagline-2 font-medium text-secondary dark:text-accent">{row.feature}</p>
                  {row.note && <p class="text-tagline-3 text-secondary/85 dark:text-accent/85 leading-snug hidden md:block">{row.note}</p>}
                </div>
                <p class={`text-center self-center ${m.cls}`}>{m.text}</p>
                <p class={`text-center self-center ${ins.cls}`}>{ins.text}</p>
              </div>
            )
          })}
        </div>
        <div class="flex flex-wrap items-center gap-6 text-tagline-3 text-secondary/70 dark:text-accent/70">
          <span class="flex items-center gap-1.5"><span class="text-emerald-500 font-semibold">✓</span> Fully supported</span>
          <span class="flex items-center gap-1.5"><span class="text-amber-500 font-semibold">~</span> Partial / via integration</span>
          <span class="flex items-center gap-1.5"><span class="opacity-40">—</span> Not applicable</span>
        </div>
      </div>
    </section>

    <section class="bg-background-1 dark:bg-background-8 py-16 md:py-24">
      <div class="main-container text-center space-y-6 max-w-[640px] mx-auto">
        <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-secondary/80 dark:text-accent/80">Ready to complete the picture?</span>
        <h2 class="text-secondary dark:text-accent">Keep Monday.com. Add the financial intelligence it is missing.</h2>
        <p class="text-tagline-1 text-secondary/80 dark:text-accent/80">
          Insighty works alongside Monday.com. Your team keeps using Monday for delivery. Your agency owner gets the revenue visibility they have been building custom boards to replace.
        </p>
        <div class="flex flex-wrap justify-center gap-3 pt-2">
          <a href="/founding-member" class="btn btn-md btn-primary"><span>Join founding members</span></a>
          <a href="/compare" class="btn btn-md btn-white"><span>All comparisons</span></a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
