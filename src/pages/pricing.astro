<script>
  // ── Billing toggle ──
  const toggle = document.getElementById('billing-toggle');
  const thumb = document.getElementById('billing-toggle-thumb');
  const labelAnnual = document.getElementById('label-annual');
  const labelMonthly = document.getElementById('label-monthly');
  let isAnnual = false;

  toggle?.addEventListener('click', () => {
    isAnnual = !isAnnual;
    toggle.setAttribute('aria-checked', String(isAnnual));

    if (isAnnual) {
      (toggle as HTMLElement).style.background = '#4a6ec7';
      (thumb as HTMLElement).style.transform = 'translateX(22px)';
      if (labelAnnual) (labelAnnual as HTMLElement).style.opacity = '1';
      if (labelMonthly) (labelMonthly as HTMLElement).style.opacity = '0.5';
    } else {
      (toggle as HTMLElement).style.background = '#d1d5db';
      (thumb as HTMLElement).style.transform = '';
      if (labelAnnual) (labelAnnual as HTMLElement).style.opacity = '0.5';
      if (labelMonthly) (labelMonthly as HTMLElement).style.opacity = '1';
    }

    document.querySelectorAll('.price-monthly').forEach(el => {
      (el as HTMLElement).style.display = isAnnual ? 'none' : 'inline';
    });
    document.querySelectorAll('.price-annual').forEach(el => {
      (el as HTMLElement).style.display = isAnnual ? 'inline' : 'none';
    });
    document.querySelectorAll('.billing-note-annual').forEach(el => {
      (el as HTMLElement).style.display = isAnnual ? 'block' : 'none';
    });
  });

  // ── Savings calculator ──
  const competitorData: Record<string, { name: string; perUser: number; flat: number }> = {
    jira:    { name: 'Jira ecosystem',    perUser: 32, flat: 149 },
    asana:   { name: 'Asana + tools',     perUser: 25, flat: 149 },
    monday:  { name: 'Monday.com + tools', perUser: 22, flat: 99  },
    clickup: { name: 'ClickUp + tools',   perUser: 12, flat: 199 },
  };

  function getInsightyPlan(n: number) {
    if (n <= 3)  return { name: 'Starter', price: 49,  desc: `${n} seat${n > 1 ? 's' : ''}, 250 AI credits, all features` };
    if (n <= 10) return { name: 'Growth',  price: 129, desc: `${n} seats, 1,000 AI credits, all features` };
    if (n <= 25) return { name: 'Scale',   price: 299, desc: `${n} seats, 5,000 AI credits, all features` };
    const extra = n - 25;
    return { name: 'Scale + extra seats', price: 299 + extra * 10, desc: `${n} seats, 5,000 AI credits, all features` };
  }

  function formatMoney(n: number) {
    return '$' + n.toLocaleString('en-US');
  }

  function updateCalc() {
    const teamSizeEl = document.getElementById('team-size') as HTMLInputElement;
    const n = parseInt(teamSizeEl?.value || '10');
    const selected = (document.querySelector('input[name="competitor"]:checked') as HTMLInputElement)?.value || 'jira';
    const comp = competitorData[selected];
    const competitorCost = n * comp.perUser + comp.flat;
    const plan = getInsightyPlan(n);
    const savings = Math.max(0, competitorCost - plan.price);

    const set = (id: string, val: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = val;
    };

    set('team-size-display', `${n} ${n === 1 ? 'person' : 'people'}`);
    set('competitor-name-display', comp.name);
    set('competitor-cost-display', `${formatMoney(competitorCost)} / mo`);
    set('competitor-breakdown-display', `${n} seats × $${comp.perUser}/user + $${comp.flat} platform fees`);
    set('insighty-plan-display', `${plan.name} plan`);
    set('insighty-cost-display', `${formatMoney(plan.price)} / mo`);
    set('insighty-includes-display', plan.desc);
    set('monthly-savings-display', formatMoney(savings));
    set('annual-savings-display', formatMoney(savings * 12));
  }

  // Team size slider
  document.getElementById('team-size')?.addEventListener('input', updateCalc);

  // Competitor selection
  document.querySelectorAll('.competitor-option').forEach(label => {
    label.addEventListener('click', () => {
      // Reset all
      document.querySelectorAll('.competitor-option').forEach(l => {
        (l as HTMLElement).style.borderWidth = '1px';
        (l as HTMLElement).style.borderColor = '';
        (l as HTMLElement).style.background = '';
        l.classList.remove('border-2', 'border-primary-500', 'bg-primary-500/5');
        const dot = l.querySelector('div');
        const inner = l.querySelector('div > div');
        if (dot) {
          (dot as HTMLElement).style.borderColor = '';
          (dot as HTMLElement).style.background = '';
        }
        if (inner) (inner as HTMLElement).style.display = 'none';
      });

      // Activate selected
      (label as HTMLElement).style.borderWidth = '2px';
      (label as HTMLElement).style.borderColor = '#4a6ec7';
      (label as HTMLElement).style.background = 'rgba(74,110,199,0.05)';
      const dot = label.querySelector('div');
      const inner = label.querySelector('div > div');
      if (dot) {
        (dot as HTMLElement).style.borderColor = '#4a6ec7';
        (dot as HTMLElement).style.background = '#4a6ec7';
      }
      if (inner) (inner as HTMLElement).style.display = 'block';

      // Check the radio
      const radio = label.querySelector('input[type="radio"]') as HTMLInputElement;
      if (radio) radio.checked = true;

      updateCalc();
    });
  });

  // Initial calc
  updateCalc();

  // ── Pricing FAQ accordion ──
  document.querySelectorAll('.pricing-faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const body = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.pricing-faq-chevron') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        body.style.display = 'none';
        btn.setAttribute('aria-expanded', 'false');
        chevron.style.transform = '';
      } else {
        body.style.display = 'block';
        btn.setAttribute('aria-expanded', 'true');
        chevron.style.transform = 'rotate(180deg)';
      }
    });
  });
</script>
