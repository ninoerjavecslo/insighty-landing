            <div>
              <span class="text-tagline-3 uppercase tracking-widest font-semibold text-white/35">Enterprise</span>
              <div class="mt-3 mb-0.5">
                <span class="text-white font-bold text-[2rem] leading-none tracking-tight">Custom</span>
              </div>
