---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/organisms/Header.astro'
import Footer from '../components/organisms/Footer.astro'
import Button from '../components/atoms/Button.astro'

const shipped = [
  {
    category: 'Revenue & Finance',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v16M5 6h7.5a2.5 2.5 0 0 1 0 5H7a2.5 2.5 0 0 0 0 5H15"/></svg>`,
    features: [
      'Revenue Planner — multi-stream matrix',
      'This Month invoice dashboard',
      'Probability-weighted Forecast',
      'Sales Pipeline — Kanban + table view',
      'Cash flow projections',
      'Budget burn & profitability per project',
      'Change request management',
    ],
  },
  {
    category: 'Projects & Delivery',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="16" height="13" rx="2"/><path d="M2 8h16M6 12h2M10 12h4"/></svg>`,
    features: [
      'Project management with PN system (RS-YYYY-NNN)',
      'Fixed, variable, maintenance & internal project types',
      'Maintenance contracts with Jira & Tempo sync',
      'Resource allocation grid (day-level)',
      'Project deliverables & milestone tracking',
      'Timesheet with AI-assisted pre-fill',
      'Allocation templates',
    ],
  },
  {
    category: 'Client & Infrastructure',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="7" r="3.5"/><path d="M3.5 17.5c0-3.59 2.91-6.5 6.5-6.5s6.5 2.91 6.5 6.5"/></svg>`,
    features: [
      'Client directory with full financial summary',
      'Domain expiry tracking with billing integration',
      'Infrastructure & hosting margin dashboard',
      'Reminder rules (domain, contract, pipeline alerts)',
      'Automations — recurring monthly invoice batches',
      'Contracts & contractors registry',
      'Agency tools stack & SaaS spend tracking',
    ],
  },
  {
    category: 'AI & Platform',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3l1.8 5.5H17l-4.6 3.3 1.7 5.2L10 14l-4.1 3 1.7-5.2L3 8.5h5.2z"/></svg>`,
    features: [
      'Pixel AI assistant (Claude + GPT-4o)',
      'Natural language queries over agency data',
      'AI-assisted timesheet pre-fill',
      'Multi-tenant with row-level security',
      'Role-based permissions per page',
      'Admin console for platform management',
      'Public "My Week" sharing link for team members',
    ],
  },
]

const inProgress = [
  {
    title: 'Offer Generator',
    description: 'AI-powered proposal creation in Slovenian and English. Generates structured, professional proposals from a brief using quick, guided, or fully manual modes. Built and tested — launching with the platform rebrand.',
    tag: 'AI-powered',
  },
  {
    title: 'Xero & QuickBooks Sync',
    description: 'Two-way accounting integration. Pull paid invoice status directly from your accounting software and push new invoices from Insighty — no double entry, no reconciliation headaches.',
    tag: 'Integration',
  },
  {
    title: 'Monthly Digest Email',
    description: 'Auto-generated agency health summary delivered on the 1st of each month. Covers revenue vs. plan, top clients, pipeline movements, team utilization, and domain or contract alerts.',
    tag: 'Automation',
  },
]

const planned = [
  {
    title: 'Domain Registrar Auto-Sync',
    description: 'Automatically pull expiry dates and renewal status from Namecheap, GoDaddy, and Google Domains. No more manual updates — domain data stays accurate without lifting a finger.',
    tag: 'Integration',
  },
  {
    title: 'Hosting Provider API Sync',
    description: 'Live contract status from cPanel, Plesk, and major cloud providers synced directly into your hosting registry. Catch cancellations and renewals before they become billing surprises.',
    tag: 'Integration',
  },
  {
    title: 'CRM Integrations',
    description: 'Connect HubSpot, Salesforce, and Pipedrive to sync client records and pipeline deals bidirectionally. Won deals flow into Insighty automatically — no manual pipeline creation.',
    tag: 'Integration',
  },
  {
    title: 'Extended PM Integrations',
    description: "Asana, ClickUp, and Linear alongside the existing Jira sync. Deliverables and allocated hours pulled automatically — no more switching tabs to see what's planned vs. what's tracked.",
    tag: 'Integration',
  },
  {
    title: 'Capacity Forecast Report',
    description: '12-week forward view of team capacity versus planned allocations. Spot over-allocation before it becomes a problem, and identify under-utilised weeks before revenue slips.',
    tag: 'Reports',
  },
  {
    title: 'Delay Impact Report',
    description: 'Model what happens to your revenue forecast if a project slips by 1, 2, or 3 months. Colour-coded risk severity so you know exactly which delays cost the most.',
    tag: 'Reports',
  },
]

const tagColors: Record<string, string> = {
  'AI-powered':  'bg-primary-500/10 text-primary-500 border-primary-500/20',
  'Integration': 'bg-[#2d9b9b]/10 text-[#2d9b9b] border-[#2d9b9b]/20',
  'Automation':  'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
  'Reports':     'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20',
}
---

<BaseLayout
  title="Roadmap — Insighty"
  description="See what's live, what we're building, and what's coming next. Insighty builds in public — here's the honest state of the platform."
>
  <Header />
  <main>

    <!-- Hero -->
    <section
      class="pt-[140px] sm:pt-[150px] md:pt-[160px] pb-16 md:pb-20 relative overflow-hidden"
      style="background: linear-gradient(135deg, #0a1628 0%, #112445 50%, #1a3a70 100%)"
    >
      <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;" aria-hidden="true"></div>
      <div class="main-container relative z-10">
        <div class="max-w-[720px] space-y-5">
          <span
            data-ns-animate
            data-delay="0.05"
            class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-white border border-white/30 px-4 py-1.5"
          >Building in public</span>
          <h1 data-ns-animate data-delay="0.1" class="text-white">
            What we've shipped.<br/>What's coming next.
          </h1>
          <p data-ns-animate data-delay="0.2" class="text-tagline-1 text-white/65 max-w-[560px] leading-relaxed">
            No vague promises. This is the honest state of Insighty — every shipped module, every feature in active development, and everything queued up next.
          </p>
        </div>
      </div>
    </section>

    <!-- ========================= Live Now ========================= -->
    <section class="bg-background-1 dark:bg-background-8 py-16 md:py-24 border-b border-stroke-2 dark:border-stroke-6">
      <div class="main-container">

        <div class="flex items-center gap-3 mb-12">
          <span class="w-2.5 h-2.5 rounded-full bg-green-400 shrink-0 shadow-[0_0_8px_2px_rgba(74,222,128,0.4)]" aria-hidden="true"></span>
          <h2 class="text-secondary dark:text-accent">Live now</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
          {shipped.map((group, i) => (
            <div
              data-ns-animate
              data-delay={String(0.05 + i * 0.07)}
              class="relative flex flex-col gap-5 p-6 rounded-2xl bg-background-2 dark:bg-background-7 border border-stroke-2 dark:border-stroke-5 overflow-hidden"
            >
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-400/40 to-transparent" aria-hidden="true"></div>
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 block shrink-0 text-primary-500" set:html={group.icon} />
                <span class="text-tagline-2 font-semibold text-secondary dark:text-accent">{group.category}</span>
              </div>
              <ul class="space-y-2.5">
                {group.features.map(f => (
                  <li class="flex items-start gap-2.5">
                    <svg class="w-4 h-4 shrink-0 mt-0.5 text-ns-green" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="text-tagline-3 text-secondary/80 dark:text-accent/80 leading-snug">{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ========================= In Progress ========================= -->
    <section class="bg-background-2 dark:bg-background-7 py-16 md:py-24 border-b border-stroke-2 dark:border-stroke-6">
      <div class="main-container">

        <div class="flex items-center gap-3 mb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0 shadow-[0_0_8px_2px_rgba(251,191,36,0.35)]" aria-hidden="true"></span>
          <h2 class="text-secondary dark:text-accent">In progress</h2>
        </div>
        <p class="text-tagline-1 text-secondary/65 dark:text-accent/65 mb-12 max-w-[520px]">
          Features currently in active development. These are being built, tested, or finalised right now.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
          {inProgress.map((item, i) => (
            <div
              data-ns-animate
              data-delay={String(0.05 + i * 0.08)}
              class="flex flex-col gap-4 p-6 rounded-2xl bg-background-1 dark:bg-background-6 border border-stroke-2 dark:border-stroke-5"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-heading-6 font-semibold text-secondary dark:text-accent leading-snug">{item.title}</h3>
                <span class={`shrink-0 text-tagline-3 font-medium border px-2.5 py-0.5 rounded-full ${tagColors[item.tag]}`}>{item.tag}</span>
              </div>
              <p class="text-tagline-2 text-secondary/70 dark:text-accent/70 leading-relaxed flex-1">{item.description}</p>
              <div class="flex items-center gap-2 pt-1">
                <span class="w-2 h-2 rounded-full bg-amber-400 shrink-0" aria-hidden="true"></span>
                <span class="text-tagline-3 text-secondary/50 dark:text-accent/50 font-medium uppercase tracking-widest">In development</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ========================= Planned ========================= -->
    <section class="bg-background-1 dark:bg-background-8 py-16 md:py-24">
      <div class="main-container">

        <div class="flex items-center gap-3 mb-3">
          <span class="w-2.5 h-2.5 rounded-full bg-stroke-5 dark:bg-stroke-4 shrink-0" aria-hidden="true"></span>
          <h2 class="text-secondary dark:text-accent">Planned</h2>
        </div>
        <p class="text-tagline-1 text-secondary/65 dark:text-accent/65 mb-12 max-w-[520px]">
          Confirmed for the roadmap. Not in active development yet, but spec'd and prioritised.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
          {planned.map((item, i) => (
            <div
              data-ns-animate
              data-delay={String(0.05 + i * 0.07)}
              class="flex flex-col gap-4 p-6 rounded-2xl bg-background-2 dark:bg-background-7 border border-stroke-2 dark:border-stroke-5 border-dashed"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-heading-6 font-semibold text-secondary/85 dark:text-accent/85 leading-snug">{item.title}</h3>
                <span class={`shrink-0 text-tagline-3 font-medium border px-2.5 py-0.5 rounded-full ${tagColors[item.tag]}`}>{item.tag}</span>
              </div>
              <p class="text-tagline-2 text-secondary/65 dark:text-accent/65 leading-relaxed flex-1">{item.description}</p>
              <div class="flex items-center gap-2 pt-1">
                <span class="w-2 h-2 rounded-full bg-stroke-4 shrink-0" aria-hidden="true"></span>
                <span class="text-tagline-3 text-secondary/40 dark:text-accent/40 font-medium uppercase tracking-widest">Planned</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ========================= CTA ========================= -->
    <section class="py-16 md:py-20 border-t border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7">
      <div class="main-container">
        <div
          class="relative rounded-2xl p-10 md:p-14 overflow-hidden flex flex-col md:flex-row items-center gap-10"
          style="background: linear-gradient(135deg, #112445 0%, #1b3a6b 60%, #4a6ec7 100%)"
        >
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 32px 32px;" aria-hidden="true"></div>
          <div class="relative z-10 flex-1 space-y-5">
            <p class="text-white text-tagline-3 font-semibold uppercase tracking-widest">Want early access?</p>
            <h2 class="text-white leading-tight max-w-[480px]">Get in before the public launch.</h2>
            <p class="text-white/75 text-tagline-1 leading-relaxed max-w-[440px]">
              Founding members get locked-in pricing, direct access to the team, and the ability to shape what gets built next.
            </p>
            <div class="flex flex-wrap items-center gap-4 pt-1">
              <Button kind="outline-white" href="/founding-member">Become a Founding Member</Button>
              <Button kind="arrow" href="/request-a-demo">Request a Demo</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
