<script>
  import { validateForm, setupBlurValidation, submitToNetlify } from '../js/utils/form-submit.js'

  const form = document.getElementById('ds-demo-form') as HTMLFormElement | null
  const btn = document.getElementById('ds-submit') as HTMLButtonElement | null
  const successEl = document.getElementById('ds-success')
  const errorEl = document.getElementById('ds-form-error')

  if (form && btn) {
    setupBlurValidation(form)

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!validateForm(form)) return

      const span = btn.querySelector('span')
      if (span) span.textContent = 'Sending...'
      btn.disabled = true
      errorEl?.classList.add('hidden')

      try {
        const ok = await submitToNetlify(form)
        if (ok) {
          form.classList.add('hidden')
          successEl?.classList.remove('hidden')
        } else {
          errorEl?.classList.remove('hidden')
          if (span) span.textContent = 'Submit form'
          btn.disabled = false
        }
      } catch {
        errorEl?.classList.remove('hidden')
        if (span) span.textContent = 'Submit form'
        btn.disabled = false
      }
    })
  }
</script>
