---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/organisms/Header.astro'
import Footer from '../components/organisms/Footer.astro'
import Button from '../components/atoms/Button.astro'
---

<BaseLayout
  title="Request a Demo — Insighty | Agency Operations Platform"
  description="Book a 30-minute live demo of Insighty. See how we unify clients, projects, revenue, and forecasting for digital agencies."
>
  <Header />

  <main class="min-h-screen flex flex-col lg:grid lg:grid-cols-2">

    <!-- ========================
    Left panel — dark pitch side
    ========================= -->
    <div class="demo-left relative overflow-hidden flex flex-col justify-between px-8 pt-[120px] pb-12 md:px-12 md:pt-[140px] md:pb-16 xl:px-16 xl:pt-[160px] xl:pb-20 lg:min-h-screen" style="background: linear-gradient(160deg, #0c1932 0%, #112445 40%, #1b3a6b 100%);">

      <!-- Blue radial glow top-left -->
      <div class="pointer-events-none absolute -top-32 -left-32 size-[600px] rounded-full opacity-30 select-none" style="background: radial-gradient(circle, #4a6ec7 0%, transparent 70%);"></div>
      <!-- Subtle blue glow bottom-right -->
      <div class="pointer-events-none absolute -bottom-40 -right-20 size-[500px] rounded-full opacity-15 select-none" style="background: radial-gradient(circle, #2d9b9b 0%, transparent 70%);"></div>

      <!-- Content -->
      <div class="relative z-10 flex flex-col h-full gap-10 lg:gap-12">

        <!-- Headline block -->
        <div class="space-y-5 max-w-[460px]">
          <span
            data-ns-animate
            data-delay="0.05"
            class="inline-block border border-white/20 text-white text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5"
          >
            Live Demo
          </span>
          <h2
            data-ns-animate
            data-delay="0.1"
            class="text-accent leading-[115%]"
            style="font-size: clamp(1.75rem, 3vw, 2.75rem);"
          >
            See Insighty in&nbsp;action — tailored to your agency
          </h2>
          <p
            data-ns-animate
            data-delay="0.15"
            class="text-white text-tagline-1 leading-relaxed"
          >
            Fill in your details and we'll schedule a 30-minute walkthrough built around your workflow, team size, and the problems you actually need to solve.
          </p>
        </div>

        <!-- Benefits -->
        <ul data-ns-animate data-delay="0.2" class="space-y-6">
          <li class="flex items-start gap-4">
            <span class="shrink-0 mt-1 text-white/70">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 1.5C5.96447 1.5 3.5 3.96447 3.5 7C3.5 8.73547 4.31297 10.2792 5.57422 11.2812L5.25 16.5L9 14.625L12.75 16.5L12.4258 11.2812C13.687 10.2792 14.5 8.73547 14.5 7C14.5 3.96447 12.0355 1.5 9 1.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
              </svg>
            </span>
            <div class="space-y-1">
              <p class="text-heading-6 font-medium text-accent" style="font-size: 0.9375rem;">Personalized walkthrough</p>
              <p class="text-white text-tagline-2 leading-relaxed">We walk through your exact agency context — clients, projects, revenue streams, and what's broken today.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="shrink-0 mt-1 text-white/70">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="1.5" y="2.5" width="15" height="13" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
                <path d="M1.5 6.5H16.5" stroke="currentColor" stroke-width="1.25"/>
                <path d="M5.5 1.5V3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <path d="M12.5 1.5V3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <path d="M5 10H13" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                <path d="M5 13H10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
            </span>
            <div class="space-y-1">
              <p class="text-heading-6 font-medium text-accent" style="font-size: 0.9375rem;">Live platform demo</p>
              <p class="text-white text-tagline-2 leading-relaxed">See the Revenue Planner, Pixel AI, resource planning, and client modules running live — not a slide deck.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <span class="shrink-0 mt-1 text-white/70">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.25"/>
                <path d="M6.5 9.5L8 11L11.5 7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <div class="space-y-1">
              <p class="text-heading-6 font-medium text-accent" style="font-size: 0.9375rem;">Founding member pricing</p>
              <p class="text-white text-tagline-2 leading-relaxed">Get the full picture on early-access rates, what's included, and how the founding member program works.</p>
            </div>
          </li>
        </ul>

        <!-- Social proof strip -->
        <div data-ns-animate data-delay="0.25" class="mt-auto pt-2">
          <p class="text-tagline-3 text-white uppercase tracking-widest font-medium mb-4">Trusted by agency operators</p>
          <div class="flex items-center gap-6 flex-wrap">
            <div class="flex items-center gap-2">
              <div class="flex -space-x-2">
                <div class="size-8 rounded-full bg-primary-400/30 border border-white/10 flex items-center justify-center text-[10px] font-semibold text-white">SA</div>
                <div class="size-8 rounded-full bg-ns-green/20 border border-white/10 flex items-center justify-center text-[10px] font-semibold text-white">MK</div>
                <div class="size-8 rounded-full bg-ns-yellow/20 border border-white/10 flex items-center justify-center text-[10px] font-semibold text-white">JL</div>
                <div class="size-8 rounded-full bg-primary-300/20 border border-white/10 flex items-center justify-center text-[10px] font-semibold text-white">TR</div>
              </div>
              <span class="text-tagline-2 text-white">+16 agencies joined</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-ns-yellow text-[13px]">★★★★★</span>
              <span class="text-tagline-3 text-white">Early access members</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ========================
    Right panel — form side
    ========================= -->
    <div class="demo-right bg-background-1 dark:bg-background-6 flex flex-col justify-center px-8 pt-[120px] pb-12 md:px-12 md:pt-[140px] md:pb-16 xl:px-16 xl:pt-[160px] xl:pb-20 lg:min-h-screen">

      <div class="w-full max-w-[480px] mx-auto space-y-8">

        <!-- Form header -->
        <div data-ns-animate data-delay="0.1" class="space-y-2">
          <h3 class="text-secondary dark:text-accent" style="font-size: 1.375rem; line-height: 130%; font-weight: 500;">
            Request your demo
          </h3>
          <p class="text-tagline-2 text-secondary/70 dark:text-accent/70">
            We'll get back to you within one business day to confirm a time.
          </p>
        </div>

        <!-- Form -->
        <form
          data-ns-animate
          data-delay="0.15"
          class="space-y-4"
          id="demo-request-form"
          name="demo-request"
          data-netlify="true"
          netlify-honeypot="bot-field"
          novalidate
        >
          <input type="hidden" name="form-name" value="demo-request" />
          <input type="hidden" name="bot-field" class="hidden" />

          <!-- Name row -->
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label for="first-name" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                First name <span class="text-ns-yellow">*</span>
              </label>
              <input
                id="first-name"
                name="first_name"
                type="text"
                placeholder="Sam"
                required
                autocomplete="given-name"
                class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="last-name" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Last name <span class="text-ns-yellow">*</span>
              </label>
              <input
                id="last-name"
                name="last_name"
                type="text"
                placeholder="Carter"
                required
                autocomplete="family-name"
                class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors"
              />
            </div>
          </div>

          <!-- Work email -->
          <div class="space-y-1.5">
            <label for="work-email" class="text-tagline-2 font-medium text-secondary dark:text-accent">
              Work email <span class="text-ns-yellow">*</span>
            </label>
            <input
              id="work-email"
              name="email"
              type="email"
              placeholder="sam@youragency.com"
              required
              autocomplete="email"
              class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors"
            />
          </div>

          <!-- Agency name -->
          <div class="space-y-1.5">
            <label for="agency-name" class="text-tagline-2 font-medium text-secondary dark:text-accent">
              Agency name <span class="text-ns-yellow">*</span>
            </label>
            <input
              id="agency-name"
              name="agency_name"
              type="text"
              placeholder="Your agency"
              required
              autocomplete="organization"
              class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors"
            />
          </div>

          <!-- Team size + Role -->
          <div class="grid grid-cols-2 gap-3">
            <div class="space-y-1.5">
              <label for="team-size" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Team size <span class="text-ns-yellow">*</span>
              </label>
              <div class="relative">
                <select
                  id="team-size"
                  name="team_size"
                  required
                  class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Select</option>
                  <option value="1-5">1–5 people</option>
                  <option value="6-15">6–15 people</option>
                  <option value="16-30">16–30 people</option>
                  <option value="31+">31+ people</option>
                </select>
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-secondary/30 dark:text-accent/30">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
            <div class="space-y-1.5">
              <label for="role" class="text-tagline-2 font-medium text-secondary dark:text-accent">
                Your role <span class="text-ns-yellow">*</span>
              </label>
              <div class="relative">
                <select
                  id="role"
                  name="role"
                  required
                  class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors appearance-none cursor-pointer"
                >
                  <option value="" disabled selected>Select</option>
                  <option value="owner">Agency Owner / CEO</option>
                  <option value="pm">Project Manager</option>
                  <option value="ops">Operations Manager</option>
                  <option value="finance">Finance / Accounting</option>
                  <option value="other">Other</option>
                </select>
                <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-secondary/30 dark:text-accent/30">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M3 5L7 9L11 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>

          <!-- What to see -->
          <div class="space-y-1.5">
            <label for="message" class="text-tagline-2 font-medium text-secondary dark:text-accent">
              What would you like to see?
            </label>
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="e.g. Revenue forecasting, client reporting, Pixel AI assistant..."
              class="demo-input w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-primary-500 dark:focus:border-primary-300 transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <div class="pt-1 space-y-3">
            <button
              type="submit"
              class="btn btn-primary btn-md w-full py-3 text-tagline-1"
              id="demo-submit-btn"
            >
              <span>Request my demo</span>
            </button>
            <p class="text-tagline-3 text-secondary/75 dark:text-accent/75 text-center leading-relaxed">
              No sales pressure. We'll reach out within one business day.
            </p>
          </div>

          <p id="demo-form-error" class="hidden text-[11px] text-red-500 text-center">Something went wrong. Please try again or email us at sales@insighty.io.</p>

        </form>

        <!-- Success state (shown after form submit) -->
        <div
          id="demo-success"
          class="hidden text-center space-y-4 py-8"
        >
          <div class="size-14 rounded-2xl bg-ns-green/10 border border-ns-green/20 flex items-center justify-center mx-auto">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M20 6L9 17L4 12" stroke="#2d9b9b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="space-y-2">
            <p class="text-heading-6 font-medium text-secondary dark:text-accent">Thank you — we'll be in touch!</p>
            <p class="text-tagline-2 text-secondary/70 dark:text-accent/70 max-w-[320px] mx-auto">
              We've received your demo request and will reach out at your email within one business day to schedule a time.
            </p>
          </div>
          <Button kind="outline-white" href="/" class="inline-flex mt-2">
            <span>Back to home</span>
          </Button>
        </div>

      </div>
    </div>

  </main>

  <Footer />
</BaseLayout>

<style>
  /* Smooth entry for the split layout */
  .demo-left,
  .demo-right {
    opacity: 0;
    transform: translateY(16px);
    animation: panel-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .demo-right {
    animation-delay: 0.1s;
  }

  @keyframes panel-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Input focus ring */
  .demo-input:focus {
    box-shadow: 0 0 0 3px rgba(27, 58, 107, 0.08);
  }

  :global(.dark) .demo-input:focus {
    box-shadow: 0 0 0 3px rgba(74, 110, 199, 0.12);
  }

  /* Error state */
  .demo-input.error {
    border-color: #ef4444;
  }
</style>

<script>
  const form = document.getElementById('demo-request-form') as HTMLFormElement | null
  const submitBtn = document.getElementById('demo-submit-btn') as HTMLButtonElement | null
  const successEl = document.getElementById('demo-success')
  const formHeader = form?.previousElementSibling as HTMLElement | null
  const errorMsg = document.getElementById('demo-form-error')

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

  function validateDemoForm(): boolean {
    let valid = true
    form!.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      'input[required], select[required]'
    ).forEach(input => {
      input.classList.remove('error')
      let err = false
      if (!input.value.trim()) {
        err = true
      } else if (input.type === 'email' && !EMAIL_RE.test(input.value)) {
        err = true
      }
      if (err) { input.classList.add('error'); valid = false }
    })
    return valid
  }

  // Blur validation
  form?.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
    'input[required], select[required]'
  ).forEach(input => {
    input.addEventListener('blur', () => {
      input.classList.remove('error')
      if (!input.value.trim() || (input.type === 'email' && !EMAIL_RE.test(input.value))) {
        if (input.value !== '' || input.required) input.classList.add('error')
      }
    })
    input.addEventListener('input', () => {
      if (input.classList.contains('error') && input.value.trim()) {
        if (input.type !== 'email' || EMAIL_RE.test(input.value)) {
          input.classList.remove('error')
        }
      }
    })
  })

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!validateDemoForm()) return

      const span = submitBtn.querySelector('span')
      if (span) span.textContent = 'Sending...'
      submitBtn.disabled = true
      if (errorMsg) errorMsg.classList.add('hidden')

      try {
        const body = new URLSearchParams()
        new FormData(form).forEach((v, k) => body.append(k, v as string))
        const ok = (await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        })).ok

        if (ok) {
          form.classList.add('hidden')
          if (formHeader) formHeader.classList.add('hidden')
          if (successEl) successEl.classList.remove('hidden')
        } else {
          if (errorMsg) errorMsg.classList.remove('hidden')
          if (span) span.textContent = 'Request my demo'
          submitBtn.disabled = false
        }
      } catch {
        if (errorMsg) errorMsg.classList.remove('hidden')
        if (span) span.textContent = 'Request my demo'
        submitBtn.disabled = false
      }
    })
  }
</script>
