---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/organisms/Header.astro'
import Footer from '../../components/organisms/Footer.astro'

const useCase = {
  title: "Insighty for Accounting & Finance Teams — Automate Invoicing & Track Every Revenue Stream",
  description: "Finance teams use Insighty to eliminate manual invoice workflows, automate recurring billing, and get a real-time view of planned versus actual revenue across every client.",

  eyebrow: "For Accounting & Finance",
  heroHeadline: "From invoice chaos",
  heroHeadlineEm: "to automated clarity.",
  heroSubtext: "Insighty gives finance teams a single view of every planned, issued, and paid invoice — with automated monthly billing batches, reminder rules, and real-time revenue tracking across all clients.",

  problemEyebrow: "The Problem",
  problemHeadline: "Where finance teams lose control",
  problems: [
    {
      icon: "alert",
      title: "Manual invoice preparation",
      body: "Recurring invoices for retainers, hosting, and domains are prepared manually each month — a time-consuming process that breaks when someone is sick or on leave."
    },
    {
      icon: "chart",
      title: "No revenue vs. plan view",
      body: "What was planned versus what was actually invoiced and paid? Without a unified tracker, month-end reconciliation is a painful manual exercise."
    },
    {
      icon: "grid",
      title: "Late payment blind spots",
      body: "Issued invoices disappear into email. There's no systematic tracking of which invoices are overdue, by how much, and for which clients."
    },
  ],

  feature1: {
    eyebrow: "Automations",
    headline: "Recurring invoices.",
    headlineEm: "Sent automatically.",
    body: "Configure monthly automation rules that send formatted invoice emails on a specified day each month. Each automation holds multiple line items — retainers, hosting fees, domain renewals — with description templates that auto-fill the month and year.",
    bullets: [
      "Scheduled invoice batches on any day of month",
      "Multi-line item templates with {month} tokens",
      "Send history log and manual trigger",
    ],
  },

  feature2: {
    eyebrow: "Revenue Planner",
    headline: "Planned vs. actual.",
    headlineEm: "At a glance.",
    body: "A month-by-month matrix showing every revenue entry — projects, retainers, hosting, domains — with status (planned / issued / paid). Finance teams see exactly what's outstanding and what's already collected without opening a single spreadsheet.",
    bullets: [
      "4 revenue streams in one matrix",
      "Planned / issued / paid status per entry",
      "Probability weighting for forecast accuracy",
    ],
  },

  feature3: {
    eyebrow: "Reminder Rules",
    headline: "Automated alerts",
    headlineEm: "before anything expires.",
    body: "Configure reminder rules that fire N days before domain expiries, maintenance contract ends, or hosting renewals. Rules can include automated invoice generation — sending a formatted billing email to accounting without any manual work.",
    bullets: [
      "Domain, hosting, and contract reminders",
      "Configurable days-before threshold",
      "Auto-invoice generation on trigger",
    ],
  },

  stats: [
    { value: "100%", label: "Recurring invoices automated" },
    { value: "0", label: "Manual reminders needed" },
    { value: "4+", label: "Revenue streams tracked" },
    { value: "1", label: "Finance dashboard" },
  ],

  testimonial: {
    quote: "\"The automation engine replaced a 2-hour monthly invoicing session. We set it up once and it runs itself — every retainer, every hosting fee, every domain renewal.\"",
    name: "Elena Voss",
    role: "Finance Manager, Brand Studio Co.",
  },

  ctaHeadline: "Automate your monthly billing cycle.",
  ctaSubtext: "Join the founding member waitlist and lock in pre-launch pricing for your finance team.",
}
---

<BaseLayout title={useCase.title} description={useCase.description}>
  <Header />
  <main>

    <!-- HERO -->
    <section class="relative pt-[140px] pb-20 sm:pt-[160px] md:pb-[120px] xl:pb-[160px] overflow-hidden bg-white dark:bg-background-8">
      <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden">
        <div class="absolute -top-[80px] left-1/2 -translate-x-1/2 w-[800px] h-[500px] rounded-full bg-ns-yellow-light/60 dark:bg-ns-yellow/8 blur-[130px]"></div>
        <div class="absolute top-1/3 -right-[200px] w-[500px] h-[400px] rounded-full bg-primary-100/50 dark:bg-primary-500/10 blur-[100px]"></div>
      </div>
      <div class="main-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 xl:gap-20 items-center">
          <div class="space-y-8">
            <div class="space-y-5">
              <div data-ns-animate data-delay="0.05">
                <span class="inline-block border border-ns-yellow/50 text-ns-yellow dark:text-ns-yellow text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.eyebrow}</span>
              </div>
              <h1 data-ns-animate data-delay="0.1" class="max-w-[560px]">
                {useCase.heroHeadline}<br/>
                <em class="not-italic text-ns-yellow">{useCase.heroHeadlineEm}</em>
              </h1>
              <p data-ns-animate data-delay="0.2" class="max-w-[500px] text-secondary/70 dark:text-accent/70">{useCase.heroSubtext}</p>
            </div>
            <div data-ns-animate data-delay="0.3" class="flex flex-wrap gap-3">
              <a href="/founding-member" class="btn btn-primary btn-md"><span>Get Early Access</span></a>
              <a href="/#platform" class="btn btn-white dark:btn-white-dark btn-md"><span>See the Platform</span></a>
            </div>
            <div data-ns-animate data-delay="0.4" class="flex items-center gap-3 pt-2">
              <div class="flex -space-x-2">
                {["E","K","L","F"].map(l => (
                  <div class="size-8 rounded-full bg-background-3 dark:bg-background-7 border-2 border-white dark:border-background-8 flex items-center justify-center text-tagline-3 font-semibold text-secondary/80 dark:text-accent/80">{l}</div>
                ))}
              </div>
              <p class="text-tagline-2 text-secondary/80 dark:text-accent/80">Joined by <strong class="text-secondary dark:text-accent font-medium">finance teams</strong> across Europe</p>
            </div>
          </div>
          <div data-ns-animate data-delay="0.4" data-direction="up" data-offset="60">
            <div class="relative">
              <!-- MOCKUP PLACEHOLDER: Automations list or This Month dashboard, 1200×900px -->
              <div class="bg-background-3 dark:bg-background-7 border border-stroke-2 dark:border-stroke-6 rounded-2xl overflow-hidden aspect-[4/3] flex items-center justify-center shadow-3">
                <div class="text-center space-y-3 p-8">
                  <div class="size-12 rounded-xl bg-background-4 dark:bg-background-6 flex items-center justify-center mx-auto">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-secondary/30 dark:text-accent/30"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.5"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5"/><line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5"/><line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5"/><polyline points="10 9 9 9 8 9" stroke="currentColor" stroke-width="1.5"/></svg>
                  </div>
                  <p class="text-tagline-2 text-secondary/80 dark:text-accent/80 font-medium">Automations dashboard mockup</p>
                  <p class="text-tagline-3 text-secondary/25 dark:text-accent/25">1200 × 900 px</p>
                </div>
              </div>
              <div class="absolute -bottom-3 -right-3 w-20 h-20 border-r-2 border-b-2 border-ns-yellow/30 -z-10 rounded-br-xl"></div>
              <div class="absolute -top-3 -left-3 w-20 h-20 border-l-2 border-t-2 border-primary-300/30 -z-10 rounded-tl-xl"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST BAR -->
    <section class="py-10 md:py-14 border-y border-stroke-1 dark:border-stroke-5 bg-background-2 dark:bg-background-7">
      <div class="main-container">
        <div class="flex flex-col items-center gap-8">
          <p class="text-tagline-3 font-semibold tracking-widest uppercase text-secondary/80 dark:text-accent/80">Trusted by finance teams</p>
          <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
            {[1,2,3,4,5].map(i => (
              <div class="h-7 w-[100px] bg-background-3 dark:bg-background-6 rounded flex items-center justify-center">
                <span class="text-tagline-3 text-secondary/25 dark:text-accent/25 font-medium">Client {i}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEM BLOCK -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-white dark:bg-background-8">
      <div class="main-container space-y-14 md:space-y-16">
        <div class="max-w-[560px]">
          <span data-ns-animate data-delay="0.05" class="inline-block text-tagline-3 font-semibold tracking-widest uppercase text-ns-yellow mb-4">{useCase.problemEyebrow}</span>
          <h2 data-ns-animate data-delay="0.1">{useCase.problemHeadline}</h2>
        </div>
        <div data-ns-animate data-delay="0.15" class="grid grid-cols-1 md:grid-cols-3 gap-px bg-stroke-1 dark:bg-stroke-5">
          {useCase.problems.map((p, i) => (
            <div class="bg-white dark:bg-background-8 p-8 xl:p-10 space-y-4 group">
              <div class="size-10 rounded-xl bg-background-3 dark:bg-background-7 flex items-center justify-center group-hover:bg-ns-yellow-light dark:group-hover:bg-ns-yellow/10 transition-colors duration-300">
                {p.icon === "grid" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class= text-secondary/70 dark:text-accent/70"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>}
                {p.icon === "alert" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class= text-secondary/70 dark:text-accent/70"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                {p.icon === "chart" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class= text-secondary/70 dark:text-accent/70"><path d="M18 20V10M12 20V4M6 20v-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              </div>
              <h3 class="text-heading-6 font-medium text-secondary dark:text-accent">{p.title}</h3>
              <p class="text-tagline-1 text-secondary/80 dark:text-accent/80 leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURE 1 -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-background-2 dark:bg-background-5">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div class="space-y-6 lg:max-w-[480px]">
            <span data-ns-animate data-delay="0.05" class="inline-block border border-secondary/20 dark:border-accent/20 text-secondary dark:text-accent text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.feature1.eyebrow}</span>
            <h2 data-ns-animate data-delay="0.1" class="leading-tight">{useCase.feature1.headline}<br/><em class="not-italic text-ns-yellow">{useCase.feature1.headlineEm}</em></h2>
            <p data-ns-animate data-delay="0.2" class="text-secondary/70 dark:text-accent/70 leading-relaxed">{useCase.feature1.body}</p>
            <ul data-ns-animate data-delay="0.3" class="space-y-3">
              {useCase.feature1.bullets.map(b => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.317 12.756L13.749 7.42a1 1 0 00-1.41-1.416L7.712 10.99l-2.25-2.202a1 1 0 00-1.413 1.415l2.856 2.79a1 1 0 001.412 0z" class="fill-white dark:fill-secondary"/></svg>
                  <span class="text-tagline-1 text-secondary dark:text-accent">{b}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.35"><a href="/founding-member" class="btn btn-primary btn-md"><span>Get Early Access</span></a></div>
          </div>
          <div data-ns-animate data-delay="0.2" data-direction="up" data-offset="60">
            <!-- MOCKUP PLACEHOLDER: Automation form with line items, 1200×900px -->
            <div class="bg-background-3 dark:bg-background-7 border border-stroke-2 dark:border-stroke-6 rounded-2xl overflow-hidden aspect-[4/3] flex items-center justify-center shadow-3">
              <div class="text-center space-y-3 p-8">
                <div class="size-12 rounded-xl bg-background-4 dark:bg-background-6 flex items-center justify-center mx-auto"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-secondary/30 dark:text-accent/30"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.5"/><polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.5"/></svg></div>
                <p class="text-tagline-2 text-secondary/80 dark:text-accent/80 font-medium">Automation builder screenshot</p>
                <p class="text-tagline-3 text-secondary/25 dark:text-accent/25">1200 × 900 px</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE 2 -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-white dark:bg-background-8">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div data-ns-animate data-delay="0.1" data-direction="up" data-offset="60" class="order-2 lg:order-1">
            <!-- MOCKUP PLACEHOLDER: Revenue Planner matrix, 1200×900px -->
            <div class="bg-background-3 dark:bg-background-7 border border-stroke-2 dark:border-stroke-6 rounded-2xl overflow-hidden aspect-[4/3] flex items-center justify-center shadow-3">
              <div class="text-center space-y-3 p-8">
                <div class="size-12 rounded-xl bg-background-4 dark:bg-background-6 flex items-center justify-center mx-auto"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-secondary/30 dark:text-accent/30"><path d="M3 3h18v4H3zM3 11h18v2H3zM3 17h12v4H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></div>
                <p class="text-tagline-2 text-secondary/80 dark:text-accent/80 font-medium">Revenue Planner matrix</p>
                <p class="text-tagline-3 text-secondary/25 dark:text-accent/25">1200 × 900 px</p>
              </div>
            </div>
          </div>
          <div class="space-y-6 order-1 lg:order-2 lg:max-w-[480px]">
            <span data-ns-animate data-delay="0.05" class="inline-block border border-secondary/20 dark:border-accent/20 text-secondary dark:text-accent text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.feature2.eyebrow}</span>
            <h2 data-ns-animate data-delay="0.1" class="leading-tight">{useCase.feature2.headline}<br/><em class="not-italic text-ns-yellow">{useCase.feature2.headlineEm}</em></h2>
            <p data-ns-animate data-delay="0.2" class="text-secondary/70 dark:text-accent/70 leading-relaxed">{useCase.feature2.body}</p>
            <ul data-ns-animate data-delay="0.3" class="space-y-3">
              {useCase.feature2.bullets.map(b => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.317 12.756L13.749 7.42a1 1 0 00-1.41-1.416L7.712 10.99l-2.25-2.202a1 1 0 00-1.413 1.415l2.856 2.79a1 1 0 001.412 0z" class="fill-white dark:fill-secondary"/></svg>
                  <span class="text-tagline-1 text-secondary dark:text-accent">{b}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.35"><a href="/founding-member" class="btn btn-primary btn-md"><span>Get Early Access</span></a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE 3 — dark -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-[#0e1120] relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] rounded-full bg-ns-yellow/10 blur-[120px]"></div>
      </div>
      <div class="main-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div class="space-y-6 lg:max-w-[480px]">
            <span data-ns-animate data-delay="0.05" class="inline-block border border-white/20 text-white/70 text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.feature3.eyebrow}</span>
            <h2 data-ns-animate data-delay="0.1" class="text-white leading-tight">{useCase.feature3.headline}<br/><em class="not-italic text-ns-yellow">{useCase.feature3.headlineEm}</em></h2>
            <p data-ns-animate data-delay="0.2" class="text-white/60 leading-relaxed">{useCase.feature3.body}</p>
            <ul data-ns-animate data-delay="0.3" class="space-y-3">
              {useCase.feature3.bullets.map(b => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5"><rect width="18" height="18" rx="9" fill="white" fill-opacity="0.15"/><path d="M8.317 12.756L13.749 7.42a1 1 0 00-1.41-1.416L7.712 10.99l-2.25-2.202a1 1 0 00-1.413 1.415l2.856 2.79a1 1 0 001.412 0z" fill="white"/></svg>
                  <span class="text-tagline-1 text-white/85">{b}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.35"><a href="/founding-member" class="btn btn-white btn-md"><span>Get Early Access</span></a></div>
          </div>
          <div data-ns-animate data-delay="0.2" data-direction="up" data-offset="60">
            <!-- MOCKUP PLACEHOLDER: Reminder Rules config, 1200×900px -->
            <div class="bg-[#161929] border border-white/8 rounded-2xl overflow-hidden aspect-[4/3] flex items-center justify-center shadow-3">
              <div class="text-center space-y-3 p-8">
                <div class="size-12 rounded-xl bg-white/5 flex items-center justify-center mx-auto"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-white/30"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                <p class="text-tagline-2 text-white/30 font-medium">Reminder Rules</p>
                <p class="text-tagline-3 text-white/20">1200 × 900 px</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="py-14 md:py-20 bg-ns-yellow">
      <div class="main-container">
        <div data-ns-animate data-delay="0.1" class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-black/10">
          {useCase.stats.map((s, i) => (
            <div class="bg-ns-yellow px-8 py-10 text-center space-y-1">
              <p class="text-4xl md:text-5xl font-semibold text-secondary tracking-tight">{s.value}</p>
              <p class="text-tagline-2 text-secondary/80 uppercase tracking-wider font-medium">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section class="py-16 md:py-[100px] xl:py-[140px] bg-background-2 dark:bg-background-5">
      <div class="main-container">
        <div class="max-w-[800px] mx-auto">
          <div data-ns-animate data-delay="0.1" class="bg-white dark:bg-background-8 border border-stroke-1 dark:border-stroke-5 rounded-2xl p-10 md:p-14 xl:p-16 space-y-8">
            <svg width="40" height="30" viewBox="0 0 40 30" fill="none" class="text-ns-yellow-light dark:text-ns-yellow/30"><path d="M0 30V18C0 7.333 5.333 1.667 16 0l2 3C12.667 4.333 10 7.667 10 13v1h8V30H0zm22 0V18C22 7.333 27.333 1.667 38 0l2 3C34.667 4.333 32 7.667 32 13v1h8V30H22z" fill="currentColor"/></svg>
            <blockquote><p class="text-heading-5 md:text-heading-4 font-normal text-secondary dark:text-accent leading-relaxed">{useCase.testimonial.quote}</p></blockquote>
            <div class="flex items-center gap-4 pt-2 border-t border-stroke-1 dark:border-stroke-5">
              <div class="size-12 rounded-full bg-background-3 dark:bg-background-7 border-2 border-stroke-2 dark:border-stroke-6 flex items-center justify-center text-tagline-2 font-semibold text-secondary/80 dark:text-accent/80 shrink-0">{useCase.testimonial.name.charAt(0)}</div>
              <div>
                <p class="text-tagline-1 font-medium text-secondary dark:text-accent">{useCase.testimonial.name}</p>
                <p class="text-tagline-2 text-secondary/70 dark:text-accent/70">{useCase.testimonial.role}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="py-16 md:py-[100px] xl:py-[140px] bg-white dark:bg-background-8 relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -bottom-[100px] left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full bg-ns-yellow-light/60 dark:bg-ns-yellow/8 blur-[120px]"></div>
      </div>
      <div class="main-container relative z-10">
        <div class="max-w-[680px] mx-auto text-center space-y-8">
          <div class="space-y-4">
            <h2 data-ns-animate data-delay="0.1" class="leading-tight">{useCase.ctaHeadline}</h2>
            <p data-ns-animate data-delay="0.2" class="text-secondary/70 dark:text-accent/70 max-w-[480px] mx-auto">{useCase.ctaSubtext}</p>
          </div>
          <div data-ns-animate data-delay="0.3" class="flex flex-wrap justify-center gap-3">
            <a href="/founding-member" class="btn btn-primary btn-xl"><span>Become a Founding Member</span></a>
            <a href="/#platform" class="btn btn-white dark:btn-white-dark btn-xl"><span>Explore the Platform</span></a>
          </div>
          <p data-ns-animate data-delay="0.4" class="text-tagline-3 text-secondary/75 dark:text-accent/75">No credit card required &middot; Founding member pricing locked for life</p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
