---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/organisms/Header.astro'
import Footer from '../../components/organisms/Footer.astro'
import Button from '../../components/atoms/Button.astro'

const useCase = {
  title: "Insighty for IT Services — Manage Hosting, Domains & Contracts in One Place",
  description: "IT service providers use Insighty to track every hosting contract, domain renewal, and maintenance retainer — with automated reminders before anything expires.",

  eyebrow: "For IT Services",
  heroHeadline: "Never miss a renewal,",
  heroHeadlineEm: "ever again.",
  heroSubtext: "Insighty gives IT service providers full visibility into every hosting contract, domain expiry, maintenance retainer, and infrastructure cost — with automated reminders so nothing slips through.",

  problemEyebrow: "The Problem",
  problemHeadline: "What breaks without a system",
  problems: [
    {
      icon: "alert",
      title: "Domains expire unnoticed",
      body: "Client domains lapse because renewal dates are buried in spreadsheets or forgotten entirely. The fallout — downtime, angry calls, lost trust — is avoidable."
    },
    {
      icon: "grid",
      title: "Hosting scattered everywhere",
      body: "Dozens of clients, multiple providers, different billing cycles. No single view of what's active, what's expiring, and what's actually billable."
    },
    {
      icon: "chart",
      title: "Invisible hosting margin",
      body: "What do you charge clients versus what you pay providers? Without a cost vs. revenue view, hosting margin stays a mystery."
    },
  ],

  feature1: {
    eyebrow: "Domains",
    headline: "Every domain.",
    headlineEm: "Every expiry date.",
    body: "All client domains in one table — color-coded by status. Green is active, amber is expiring within 30 days, red is expired. Automated reminder emails fire before the deadline, with optional invoice generation built in.",
    bullets: [
      "Status: active / expiring soon / expired",
      "Automated reminder emails N days before",
      "Built-in domain renewal invoice generation",
    ],
  },

  feature2: {
    eyebrow: "Infrastructure & Hosting",
    headline: "Revenue versus cost.",
    headlineEm: "Net margin, live.",
    body: "Track what you charge clients (hosting plans, billing cycles, amounts) alongside what you pay providers (AWS, DigitalOcean, Cloudflare). Monthly summary cards show total revenue, total costs, and net hosting margin at a glance.",
    bullets: [
      "Hosting clients with annual value calculation",
      "Infrastructure cost tracking per provider",
      "Net hosting margin dashboard card",
    ],
  },

  feature3: {
    eyebrow: "Maintenance Contracts",
    headline: "Retainers that run",
    headlineEm: "themselves.",
    body: "Every maintenance contract auto-generates monthly Revenue Planner entries. Track included hours, help request usage, Jira integration for live ticket data, and contract end dates — all from one detail view.",
    bullets: [
      "Auto-generated monthly retainer entries",
      "Included hours & help request tracking",
      "Jira/Tempo integration for usage data",
    ],
  },

  stats: [
    { value: "0", label: "Missed domain renewals" },
    { value: "30d", label: "Expiry warning window" },
    { value: "100%", label: "Hosting revenue tracked" },
    { value: "1", label: "View for all contracts" },
  ],

  testimonial: {
    quote: "\"We manage domains for 80+ clients. Before Insighty, we relied on calendar reminders and prayer. Now everything is tracked automatically with alerts weeks in advance.\"",
    name: "Marco Reiter",
    role: "Managing Director, NetOps GmbH",
  },

  ctaHeadline: "Stop managing renewals in spreadsheets.",
  ctaSubtext: "Join the founding member waitlist and lock in pre-launch pricing for your IT services firm.",
}
---

<BaseLayout title={useCase.title} description={useCase.description}>
  <Header />
  <main>

    <!-- HERO -->
    <section class="relative pt-[140px] pb-20 sm:pt-[160px] md:pb-[120px] xl:pb-[160px] overflow-hidden bg-white dark:bg-background-8">
      <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden">
        <div class="absolute -top-[80px] left-1/2 -translate-x-1/2 w-[800px] h-[500px] rounded-full bg-ns-green-light/40 dark:bg-ns-green/10 blur-[130px]"></div>
        <div class="absolute top-1/3 -right-[200px] w-[500px] h-[400px] rounded-full bg-primary-100/50 dark:bg-primary-500/10 blur-[100px]"></div>
      </div>
      <div class="main-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 xl:gap-20 items-center">
          <div class="space-y-8">
            <div class="space-y-5">
              <div data-ns-animate data-delay="0.05">
                <span class="inline-block border border-ns-green/40 text-ns-green dark:text-ns-green text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.eyebrow}</span>
              </div>
              <h1 data-ns-animate data-delay="0.1" class="max-w-[560px]">
                {useCase.heroHeadline}<br/>
                <em class="not-italic text-ns-green">{useCase.heroHeadlineEm}</em>
              </h1>
              <p data-ns-animate data-delay="0.2" class="max-w-[500px] text-secondary/70 dark:text-accent/70">{useCase.heroSubtext}</p>
            </div>
            <div data-ns-animate data-delay="0.3" class="flex flex-wrap gap-3">
              <Button kind="primary" href="/founding-member"><span>Get Early Access</span></Button>
              <Button kind="outline-white" href="/#platform"><span>See the Platform</span></Button>
            </div>
            <div data-ns-animate data-delay="0.4" class="flex items-center gap-3 pt-2">
              <div class="flex -space-x-2">
                {["M","R","T","J"].map(l => (
                  <div class="size-8 rounded-full bg-background-3 dark:bg-background-7 border-2 border-white dark:border-background-8 flex items-center justify-center text-tagline-3 font-semibold text-secondary/80 dark:text-accent/80">{l}</div>
                ))}
              </div>
              <p class="text-tagline-2 text-secondary/80 dark:text-accent/80">Joined by <strong class="text-secondary dark:text-accent font-medium">IT service providers</strong> across Europe</p>
            </div>
          </div>
          <div data-ns-animate data-delay="0.4" data-direction="up" data-offset="60">
            <div class="relative">
              <!-- MOCKUP PLACEHOLDER: Domains table with color-coded status, 1200×900px -->
              <div class="rounded-2xl overflow-hidden shadow-3">
              <img src="/mockups/insighty-uc-domains%20(1).svg" alt="Insighty domains dashboard" class="w-full h-auto block" loading="lazy" />
            </div>
              <div class="absolute -bottom-3 -right-3 w-20 h-20 border-r-2 border-b-2 border-ns-green/30 -z-10 rounded-br-xl"></div>
              <div class="absolute -top-3 -left-3 w-20 h-20 border-l-2 border-t-2 border-primary-300/30 -z-10 rounded-tl-xl"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* TRUST BAR — hidden until real logos ready
    <section class="py-10 md:py-14 border-y border-stroke-1 dark:border-stroke-5 bg-background-2 dark:bg-background-7">
      <div class="main-container">
        <div class="flex flex-col items-center gap-8">
          <p class="text-tagline-3 font-semibold tracking-widest uppercase text-secondary/80 dark:text-accent/80">Trusted by IT service providers</p>
          <!-- MOCKUP PLACEHOLDER: IT services company logos -->
          <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12">
            {[1,2,3,4,5].map(i => (
              <div class="h-7 w-[100px] bg-background-3 dark:bg-background-6 rounded flex items-center justify-center">
                <span class="text-tagline-3 text-secondary/25 dark:text-accent/25 font-medium">IT Co. {i}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section> */}

    <!-- PROBLEM BLOCK -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-white dark:bg-background-8">
      <div class="main-container space-y-14 md:space-y-16">
        <div class="max-w-[560px]">
          <span data-ns-animate data-delay="0.05" class="inline-block text-tagline-3 font-semibold tracking-widest uppercase text-ns-green mb-4">{useCase.problemEyebrow}</span>
          <h2 data-ns-animate data-delay="0.1">{useCase.problemHeadline}</h2>
        </div>
        <div data-ns-animate data-delay="0.15" class="grid grid-cols-1 md:grid-cols-3 gap-px bg-stroke-1 dark:bg-stroke-5">
          {useCase.problems.map((p, i) => (
            <div class="bg-white dark:bg-background-8 p-8 xl:p-10 space-y-4 group">
              <div class="size-10 rounded-xl bg-background-3 dark:bg-background-7 flex items-center justify-center group-hover:bg-ns-green-light dark:group-hover:bg-ns-green/15 transition-colors duration-300">
                {p.icon === "grid" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class= text-secondary/70 dark:text-accent/70"><rect x="3" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="3" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="14" y="14" width="7" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>}
                {p.icon === "alert" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class= text-secondary/70 dark:text-accent/70"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                {p.icon === "chart" && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class= text-secondary/70 dark:text-accent/70"><path d="M18 20V10M12 20V4M6 20v-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
              </div>
              <h3 class="text-heading-6 font-medium text-secondary dark:text-accent">{p.title}</h3>
              <p class="text-tagline-1 text-secondary/80 dark:text-accent/80 leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURE 1 -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-background-2 dark:bg-background-5">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div class="space-y-6 lg:max-w-[480px]">
            <span data-ns-animate data-delay="0.05" class="inline-block border border-secondary/20 dark:border-accent/20 text-secondary dark:text-accent text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.feature1.eyebrow}</span>
            <h2 data-ns-animate data-delay="0.1" class="leading-tight">{useCase.feature1.headline}<br/><em class="not-italic text-ns-green">{useCase.feature1.headlineEm}</em></h2>
            <p data-ns-animate data-delay="0.2" class="text-secondary/70 dark:text-accent/70 leading-relaxed">{useCase.feature1.body}</p>
            <ul data-ns-animate data-delay="0.3" class="space-y-3">
              {useCase.feature1.bullets.map(b => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.317 12.756L13.749 7.42a1 1 0 00-1.41-1.416L7.712 10.99l-2.25-2.202a1 1 0 00-1.413 1.415l2.856 2.79a1 1 0 001.412 0z" class="fill-white dark:fill-secondary"/></svg>
                  <span class="text-tagline-1 text-secondary dark:text-accent">{b}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.35"><Button kind="primary" href="/founding-member"><span>Get Early Access</span></Button></div>
          </div>
          <div data-ns-animate data-delay="0.2" data-direction="up" data-offset="60">
            <!-- MOCKUP PLACEHOLDER: Domains table color-coded, 1200×900px -->
            <div class="rounded-2xl overflow-hidden shadow-3">
              <img src="/mockups/insighty-uc-domains%20(1).svg" alt="Insighty domains table" class="w-full h-auto block" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE 2 -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-white dark:bg-background-8">
      <div class="main-container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div data-ns-animate data-delay="0.1" data-direction="up" data-offset="60" class="order-2 lg:order-1">
            <!-- MOCKUP PLACEHOLDER: Infrastructure hosting summary cards + table, 1200×900px -->
            <div class="rounded-2xl overflow-hidden shadow-3">
              <img src="/mockups/insighty-uc-maintenances%20(1).svg" alt="Insighty infrastructure and hosting" class="w-full h-auto block" loading="lazy" />
            </div>
          </div>
          <div class="space-y-6 order-1 lg:order-2 lg:max-w-[480px]">
            <span data-ns-animate data-delay="0.05" class="inline-block border border-secondary/20 dark:border-accent/20 text-secondary dark:text-accent text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.feature2.eyebrow}</span>
            <h2 data-ns-animate data-delay="0.1" class="leading-tight">{useCase.feature2.headline}<br/><em class="not-italic text-ns-green">{useCase.feature2.headlineEm}</em></h2>
            <p data-ns-animate data-delay="0.2" class="text-secondary/70 dark:text-accent/70 leading-relaxed">{useCase.feature2.body}</p>
            <ul data-ns-animate data-delay="0.3" class="space-y-3">
              {useCase.feature2.bullets.map(b => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.317 12.756L13.749 7.42a1 1 0 00-1.41-1.416L7.712 10.99l-2.25-2.202a1 1 0 00-1.413 1.415l2.856 2.79a1 1 0 001.412 0z" class="fill-white dark:fill-secondary"/></svg>
                  <span class="text-tagline-1 text-secondary dark:text-accent">{b}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.35"><Button kind="primary" href="/founding-member"><span>Get Early Access</span></Button></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURE 3 — dark -->
    <section class="py-16 md:py-[100px] xl:py-[130px] bg-[#0e1120] relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] rounded-full bg-ns-green/15 blur-[120px]"></div>
      </div>
      <div class="main-container relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div class="space-y-6 lg:max-w-[480px]">
            <span data-ns-animate data-delay="0.05" class="inline-block border border-white/20 text-white/70 text-tagline-3 font-semibold tracking-widest uppercase px-4 py-1.5">{useCase.feature3.eyebrow}</span>
            <h2 data-ns-animate data-delay="0.1" class="text-white leading-tight">{useCase.feature3.headline}<br/><em class="not-italic text-ns-green">{useCase.feature3.headlineEm}</em></h2>
            <p data-ns-animate data-delay="0.2" class="text-white/60 leading-relaxed">{useCase.feature3.body}</p>
            <ul data-ns-animate data-delay="0.3" class="space-y-3">
              {useCase.feature3.bullets.map(b => (
                <li class="flex items-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="shrink-0 mt-0.5"><rect width="18" height="18" rx="9" fill="white" fill-opacity="0.15"/><path d="M8.317 12.756L13.749 7.42a1 1 0 00-1.41-1.416L7.712 10.99l-2.25-2.202a1 1 0 00-1.413 1.415l2.856 2.79a1 1 0 001.412 0z" fill="white"/></svg>
                  <span class="text-tagline-1 text-white/85">{b}</span>
                </li>
              ))}
            </ul>
            <div data-ns-animate data-delay="0.35"><Button kind="outline-white" href="/founding-member"><span>Get Early Access</span></Button></div>
          </div>
          <div data-ns-animate data-delay="0.2" data-direction="up" data-offset="60">
            <!-- MOCKUP PLACEHOLDER: Maintenance contract detail with Jira data, 1200×900px -->
            <div class="rounded-2xl overflow-hidden shadow-3 border border-white/8">
              <img src="/mockups/insighty-uc-maintenances%20(1).svg" alt="Insighty maintenance contracts" class="w-full h-auto block" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="py-14 md:py-20 bg-ns-green">
      <div class="main-container">
        <div data-ns-animate data-delay="0.1" class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/10">
          {useCase.stats.map((s, i) => (
            <div data-ns-animate data-delay={String(0.05 + i * 0.08)} class="bg-ns-green px-8 py-10 text-center space-y-1">
              <p class="text-4xl md:text-5xl font-semibold text-white tracking-tight">{s.value}</p>
              <p class="text-tagline-2 text-white/60 uppercase tracking-wider font-medium">{s.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section class="py-16 md:py-[100px] xl:py-[140px] bg-background-2 dark:bg-background-5">
      <div class="main-container">
        <div class="max-w-[800px] mx-auto">
          <div data-ns-animate data-delay="0.1" class="bg-white dark:bg-background-8 border border-stroke-1 dark:border-stroke-5 rounded-2xl p-10 md:p-14 xl:p-16 space-y-8">
            <svg width="40" height="30" viewBox="0 0 40 30" fill="none" class="text-ns-green-light dark:text-ns-green/30"><path d="M0 30V18C0 7.333 5.333 1.667 16 0l2 3C12.667 4.333 10 7.667 10 13v1h8V30H0zm22 0V18C22 7.333 27.333 1.667 38 0l2 3C34.667 4.333 32 7.667 32 13v1h8V30H22z" fill="currentColor"/></svg>
            <blockquote><p class="text-heading-5 md:text-heading-4 font-normal text-secondary dark:text-accent leading-relaxed">{useCase.testimonial.quote}</p></blockquote>
            <div class="flex items-center gap-4 pt-2 border-t border-stroke-1 dark:border-stroke-5">
              <div class="size-12 rounded-full bg-background-3 dark:bg-background-7 border-2 border-stroke-2 dark:border-stroke-6 flex items-center justify-center text-tagline-2 font-semibold text-secondary/80 dark:text-accent/80 shrink-0">{useCase.testimonial.name.charAt(0)}</div>
              <div>
                <p class="text-tagline-1 font-medium text-secondary dark:text-accent">{useCase.testimonial.name}</p>
                <p class="text-tagline-2 text-secondary/70 dark:text-accent/70">{useCase.testimonial.role}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BOTTOM CTA -->
    <section class="py-16 md:py-[100px] xl:py-[140px] bg-white dark:bg-background-8 relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -bottom-[100px] left-1/2 -translate-x-1/2 w-[600px] h-[400px] rounded-full bg-ns-green-light/60 dark:bg-ns-green/10 blur-[120px]"></div>
      </div>
      <div class="main-container relative z-10">
        <div class="max-w-[680px] mx-auto text-center space-y-8">
          <div class="space-y-4">
            <h2 data-ns-animate data-delay="0.1" class="leading-tight">{useCase.ctaHeadline}</h2>
            <p data-ns-animate data-delay="0.2" class="text-secondary/70 dark:text-accent/70 max-w-[480px] mx-auto">{useCase.ctaSubtext}</p>
          </div>
          <div data-ns-animate data-delay="0.3" class="flex flex-wrap justify-center gap-3">
            <Button kind="primary" href="/founding-member" size="xl"><span>Become a Founding Member</span></Button>
            <Button kind="outline" href="/#platform" size="xl"><span>Explore the Platform</span></Button>
          </div>
          <p data-ns-animate data-delay="0.4" class="text-tagline-3 text-secondary/75 dark:text-accent/75">No credit card required &middot; Founding member pricing locked for life</p>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>
