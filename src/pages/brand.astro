---
import BaseLayout from '../layouts/BaseLayout.astro'

const colors = {
  primary: [
    { name: 'primary-50',  hex: '#eef2fb', label: 'Mist' },
    { name: 'primary-100', hex: '#c9d5f3', label: 'Periwinkle' },
    { name: 'primary-200', hex: '#a3b8ea', label: 'Powder Blue' },
    { name: 'primary-300', hex: '#6e8fd9', label: 'Cornflower' },
    { name: 'primary-400', hex: '#4a6ec7', label: 'Royal' },
    { name: 'primary-500', hex: '#1b3a6b', label: 'Navy' },
    { name: 'primary-600', hex: '#162f58', label: 'Deep Navy' },
    { name: 'primary-700', hex: '#112445', label: 'Midnight' },
    { name: 'primary-800', hex: '#0c1932', label: 'Abyss' },
  ],
  brand: [
    { name: 'ns-yellow',       hex: '#d4a574', label: 'Gold' },
    { name: 'ns-green',        hex: '#2d9b9b', label: 'Teal' },
    { name: 'ns-red',          hex: '#ffb9a2', label: 'Coral' },
    { name: 'ns-yellow-light', hex: '#f5e5d0', label: 'Warm Cream' },
    { name: 'ns-green-light',  hex: '#c8eded', label: 'Mint' },
    { name: 'ns-ivory',        hex: '#f4efe7', label: 'Ivory' },
    { name: 'ns-linen',        hex: '#7a6b5d', label: 'Linen' },
  ],
  dark: [
    { name: 'background-8', hex: '#070b10', label: 'Void' },
    { name: 'background-6', hex: '#0f1217', label: 'Obsidian' },
    { name: 'background-5', hex: '#13171e', label: 'Charcoal' },
    { name: 'background-7', hex: '#181d26', label: 'Slate' },
    { name: 'background-9', hex: '#1f252f', label: 'Steel' },
    { name: 'stroke-5',     hex: '#1b232f', label: 'Border Dark' },
    { name: 'stroke-7',     hex: '#2a333e', label: 'Border Light' },
  ],
  light: [
    { name: 'accent',        hex: '#fcfcfc', label: 'White' },
    { name: 'background-1',  hex: '#fcfcfd', label: 'Snow' },
    { name: 'background-2',  hex: '#f9fafb', label: 'Off-White' },
    { name: 'background-3',  hex: '#f4f5f8', label: 'Smoke' },
    { name: 'stroke-10',     hex: '#dfd1c5', label: 'Warm Edge' },
    { name: 'background-10', hex: '#888888', label: 'Mid Gray' },
    { name: 'background-11', hex: '#555558', label: 'Dark Gray' },
  ],
}

const gradients = [
  { id: 1,  css: 'linear-gradient(135deg, #4a6ec7 0%, #d4a574 100%)',                                         label: 'Royal → Gold',      use: 'Hero headlines, primary CTAs' },
  { id: 2,  css: 'linear-gradient(135deg, #d4a574 0%, #c08040 100%)',                                         label: 'Gold → Amber',      use: 'Warm accents, pricing badges' },
  { id: 3,  css: 'linear-gradient(135deg, #2d9b9b 0%, #4a6ec7 100%)',                                         label: 'Teal → Royal',      use: 'Feature highlights, stats' },
  { id: 4,  css: 'linear-gradient(135deg, #1b3a6b 0%, #4a6ec7 100%)',                                         label: 'Navy → Royal',      use: 'Subtle blue backgrounds' },
  { id: 6,  css: 'linear-gradient(180deg, #83e7ee 0%, #c6f56f 100%)',                                         label: 'Cyan → Lime',       use: 'Vibrant accents, icons' },
  { id: 7,  css: 'linear-gradient(180deg, #ffffff 0%, #83e7ee 100%)',                                         label: 'White → Cyan',      use: 'Text gradients, dividers' },
  { id: 8,  css: 'linear-gradient(156deg, #ffffff 32.92%, #4a6ec7 91%)',                                      label: 'White → Blue',      use: 'Typography gradient' },
  { id: 9,  css: 'linear-gradient(156deg, #c9d5f3 32.92%, #d4a574 91%)',                                      label: 'Periwinkle → Gold', use: 'Soft gradient text' },
  { id: 10, css: 'linear-gradient(135deg, #83e7ee 0%, #c6f56f 100%)',                                         label: 'Cyan → Lime',       use: 'Energetic callouts' },
  { id: 12, css: 'radial-gradient(73.01% 80.77% at 19.23% 47.79%, #83e7ee 0%, rgba(134,79,254,0) 100%)',      label: 'Cyan Radial Glow',  use: 'Background glows, cards' },
  { id: 13, css: 'linear-gradient(156deg, #fff 32.92%, #ecc5a2 91%)',                                         label: 'White → Peach',     use: 'Warm typography' },
]

const typoScale = [
  { label: 'H1', size: '68px', weight: '700', lh: '110%', use: 'Hero title' },
  { label: 'H2', size: '52px', weight: '700', lh: '120%', use: 'Section heading' },
  { label: 'H3', size: '40px', weight: '700', lh: '120%', use: 'Sub-heading' },
  { label: 'H4', size: '32px', weight: '600', lh: '130%', use: 'Card title' },
  { label: 'H5', size: '24px', weight: '600', lh: '140%', use: 'Label / caption heading' },
  { label: 'H6', size: '20px', weight: '600', lh: '140%', use: 'Small heading' },
  { label: 'Body L', size: '17px', weight: '400', lh: '150%', use: 'Lead paragraph' },
  { label: 'Body M', size: '15px', weight: '400', lh: '150%', use: 'Body copy' },
  { label: 'Body S', size: '13px', weight: '400', lh: '150%', use: 'Caption / metadata' },
]

const textGradients = [
  { label: 'Royal → Gold',      css: 'linear-gradient(135deg, #4a6ec7 0%, #d4a574 100%)' },
  { label: 'Teal → Royal',      css: 'linear-gradient(135deg, #2d9b9b 0%, #4a6ec7 100%)' },
  { label: 'White → Blue',      css: 'linear-gradient(156deg, #ffffff 32.92%, #4a6ec7 91%)' },
  { label: 'Periwinkle → Gold', css: 'linear-gradient(156deg, #c9d5f3 32.92%, #d4a574 91%)' },
  { label: 'Cyan → Lime',       css: 'linear-gradient(135deg, #83e7ee 0%, #c6f56f 100%)' },
  { label: 'White → Peach',     css: 'linear-gradient(156deg, #fff 32.92%, #ecc5a2 91%)' },
]
---

<BaseLayout title="Insighty Brand Kit" description="Social media brand guidelines for the Insighty team">
  <style>
    @import url('https://api.fontshare.com/v2/css?f[]=satoshi@500&display=swap');
    * { box-sizing: border-box; }

    /* ── LOGO SECTION ── */
    .logo-variants {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    }
    @media (max-width: 900px) { .logo-variants { grid-template-columns: 1fr 1fr; } }

    .logo-cell {
      padding: 48px 40px;
      display: flex; flex-direction: column;
      gap: 24px; border: 1px solid #1b232f;
      margin: -1px 0 0 -1px;
    }
    .logo-cell-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.12em;
      text-transform: uppercase; color: #555558;
    }
    .logo-lockup {
      display: flex; align-items: center; gap: 16px;
    }
    .logo-wordmark {
      font-family: 'Satoshi', 'Inter Tight', sans-serif;
      font-weight: 500; letter-spacing: 0.04em;
      line-height: 1;
    }

    .brand-page {
      font-family: 'Inter Tight', sans-serif;
      background: #070b10;
      color: #fcfcfc;
      min-height: 100vh;
      padding: 0;
    }

    /* ── GRID BG ── */
    .grid-bg {
      background-image:
        linear-gradient(rgba(74,110,199,0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(74,110,199,0.08) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* ── SECTION ── */
    .section { padding: 80px 48px; max-width: 1400px; margin: 0 auto; }
    .section-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
      text-transform: uppercase; color: #4a6ec7;
      margin-bottom: 12px; display: block;
    }
    .section-title {
      font-size: 36px; font-weight: 700; color: #fcfcfc;
      margin: 0 0 8px;
    }
    .section-desc {
      font-size: 15px; color: #555558; margin: 0 0 48px;
    }
    .divider { border: none; border-top: 1px solid #1b232f; margin: 0; }

    /* ── HERO ── */
    .hero {
      padding: 120px 48px 80px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 14px; border-radius: 100px;
      border: 1px solid #1b232f; background: #0f1217;
      font-size: 12px; font-weight: 500; color: #888888;
      margin-bottom: 32px;
    }
    .hero-badge span { width: 6px; height: 6px; border-radius: 50%; background: #4a6ec7; }
    .hero-title {
      font-size: clamp(48px, 6vw, 80px);
      font-weight: 800;
      line-height: 1.05;
      margin: 0 0 24px;
      background: linear-gradient(156deg, #ffffff 32.92%, #4a6ec7 91%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-sub {
      font-size: 18px; color: #888888; max-width: 560px;
      line-height: 1.6; margin: 0 0 48px;
    }
    .hero-meta {
      display: flex; gap: 40px; flex-wrap: wrap;
    }
    .hero-meta-item { }
    .hero-meta-item strong { display: block; font-size: 28px; font-weight: 700; color: #fcfcfc; }
    .hero-meta-item span { font-size: 13px; color: #555558; }

    /* ── COLORS ── */
    .color-group { margin-bottom: 40px; }
    .color-group-title {
      font-size: 12px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: #555558;
      margin-bottom: 16px;
    }
    .color-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px;
    }
    .color-swatch {
      border-radius: 12px; overflow: hidden;
      border: 1px solid #1b232f;
    }
    .color-swatch-block { height: 72px; }
    .color-swatch-info {
      padding: 10px 12px; background: #0f1217;
    }
    .color-swatch-name { font-size: 11px; font-weight: 600; color: #888888; margin-bottom: 2px; }
    .color-swatch-hex { font-size: 13px; font-weight: 700; color: #fcfcfc; font-variant-numeric: tabular-nums; }
    .color-swatch-label { font-size: 11px; color: #555558; }

    /* ── GRADIENTS ── */
    .gradient-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px;
    }
    .gradient-card {
      border-radius: 16px; overflow: hidden;
      border: 1px solid #1b232f;
    }
    .gradient-block { height: 120px; }
    .gradient-info { padding: 14px 16px; background: #0f1217; }
    .gradient-label { font-size: 14px; font-weight: 600; color: #fcfcfc; margin-bottom: 4px; }
    .gradient-use { font-size: 12px; color: #555558; margin-bottom: 8px; }
    .gradient-id { font-size: 11px; font-weight: 600; color: #4a6ec7; letter-spacing: 0.1em; text-transform: uppercase; }

    /* ── TYPOGRAPHY ── */
    .type-table { width: 100%; border-collapse: collapse; }
    .type-table th {
      font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
      color: #555558; padding: 0 16px 16px 0; text-align: left; border-bottom: 1px solid #1b232f;
    }
    .type-table td { padding: 16px 16px 16px 0; border-bottom: 1px solid #0f1217; vertical-align: middle; }
    .type-label { font-size: 12px; font-weight: 600; color: #4a6ec7; }
    .type-meta { font-size: 11px; color: #555558; font-variant-numeric: tabular-nums; }
    .type-preview { font-family: 'Inter Tight', sans-serif; color: #fcfcfc; line-height: 1.1; }
    .type-use { font-size: 12px; color: #555558; }

    /* ── TEXT GRADIENTS ── */
    .text-grad-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;
    }
    .text-grad-card {
      padding: 28px 24px; border-radius: 16px;
      background: #0f1217; border: 1px solid #1b232f;
    }
    .text-grad-sample {
      font-size: 32px; font-weight: 800; line-height: 1.1;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 12px;
    }
    .text-grad-label { font-size: 12px; color: #555558; }
    .text-grad-code {
      font-size: 11px; color: #4a6ec7; font-family: monospace;
      margin-top: 6px; word-break: break-all;
    }

    /* ── BUTTON ── */
    .btn-demo {
      position: relative; overflow: hidden;
      display: inline-flex; align-items: center; gap: 10px;
      padding: 14px 28px;
      font-family: 'Inter Tight', sans-serif;
      font-size: 15px; font-weight: 600; color: #fff;
      background: linear-gradient(135deg, #1b3a6b 0%, #4a6ec7 100%);
      border: none; cursor: pointer;
    }
    .btn-demo::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(135deg, #4a6ec7 0%, #1b3a6b 100%);
      opacity: 0;
      transition: opacity 500ms ease;
    }
    .btn-demo:hover::after { opacity: 1; }
    .btn-demo span { position: relative; z-index: 1; }
    .btn-row { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }
    .btn-state-label { font-size: 12px; color: #555558; }

    /* ── CAROUSEL EXAMPLES ── */
    .carousel-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px;
    }
    .carousel-strip {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 0;
    }
    @media (max-width: 900px) { .carousel-strip { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .carousel-strip { grid-template-columns: 1fr; } }

    /* Slide styles */
    .slide {
      aspect-ratio: 4/5;
      border-radius: 0;
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 32px;
      font-family: 'Inter Tight', sans-serif;
    }
    .slide-grid-overlay {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
      background-size: 30px 30px;
      pointer-events: none;
    }
    .slide-glow {
      position: absolute; top: -80px; right: -80px;
      width: 300px; height: 300px; border-radius: 50%;
      filter: blur(80px); pointer-events: none;
    }
    .slide-top { display: flex; align-items: center; justify-content: space-between; position: relative; z-index: 1; }
    .slide-logo { font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.9); display: flex; align-items: center; gap: 8px; }
    .slide-logo-dot { width: 8px; height: 8px; border-radius: 50%; background: #4a6ec7; }
    .slide-year { font-size: 13px; color: rgba(255,255,255,0.4); }

    .slide-body { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 24px 0; }
    .slide-eyebrow { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 16px; }
    .slide-headline { font-size: 42px; font-weight: 800; line-height: 1.05; color: #fff; margin: 0 0 16px; }
    .slide-sub { font-size: 15px; color: rgba(255,255,255,0.6); line-height: 1.5; margin: 0; }

    .slide-bottom { position: relative; z-index: 1; }
    .slide-card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 0;
      padding: 12px 16px;
      font-size: 13px;
      color: rgba(255,255,255,0.8);
      margin-bottom: 8px;
    }
    .slide-tagline { font-size: 12px; color: rgba(255,255,255,0.35); text-align: center; padding-top: 12px; }

    /* Slide variants */
    .slide-navy { background: #1b3a6b; }
    .slide-dark { background: #070b10; }
    .slide-midnight { background: #0c1932; }
    .slide-gold { background: linear-gradient(135deg, #1b3a6b 0%, #2d4a8a 100%); }
    .slide-teal { background: linear-gradient(135deg, #0a1f1f 0%, #0d2f2f 100%); }
    .slide-gradient-bg { background: linear-gradient(135deg, #4a6ec7 0%, #d4a574 100%); }

    /* Stat slide */
    .stat-big { font-size: 72px; font-weight: 800; line-height: 1; margin-bottom: 8px; }
    .stat-label { font-size: 16px; color: rgba(255,255,255,0.6); }

    /* Feature pill */
    .feature-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 100px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      font-size: 12px; color: rgba(255,255,255,0.7);
      margin: 4px 4px 4px 0;
    }
    .feature-pill-dot { width: 5px; height: 5px; border-radius: 50%; }

    /* slide border */
    .slide-border { border: 1px solid rgba(255,255,255,0.1); }
    .slide-inner-card {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 0;
      padding: 20px;
      margin: 16px 0;
    }
    .slide-inner-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .slide-inner-row:last-child { margin-bottom: 0; }
    .slide-inner-label { font-size: 12px; color: rgba(255,255,255,0.45); }
    .slide-inner-value { font-size: 13px; font-weight: 600; color: rgba(255,255,255,0.9); }

    /* ── VIDEO BG TEMPLATES ── */
    .video-bg-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px;
    }
    .video-bg-card {
      aspect-ratio: 16/9; border-radius: 0; position: relative;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden; border: 1px solid #1b232f;
    }
    .video-bg-label {
      position: relative; z-index: 1;
      text-align: center;
    }
    .video-bg-title { font-size: 20px; font-weight: 700; color: #fcfcfc; }
    .video-bg-sub { font-size: 12px; color: rgba(255,255,255,0.5); margin-top: 4px; }

    /* ── LOGO SECTION ── */
    .logo-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    }
    .logo-card {
      aspect-ratio: 16/9; border-radius: 0;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid #1b232f;
    }
    .logo-text {
      font-size: 22px; font-weight: 800; letter-spacing: -0.02em;
    }

    /* ── SPACING ── */
    .mt-0 { margin-top: 0; }
    .pb-0 { padding-bottom: 0; }

    /* ── FOOTER ── */
    .brand-footer {
      padding: 40px 48px;
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid #1b232f;
    }
    .brand-footer-left { font-size: 13px; color: #555558; }
    .brand-footer-right { font-size: 13px; color: #555558; }

    @media (max-width: 768px) {
      .section { padding: 48px 24px; }
      .hero { padding: 80px 24px 48px; }
      .logo-grid { grid-template-columns: repeat(2, 1fr); }
      .brand-footer { padding: 32px 24px; flex-direction: column; gap: 8px; text-align: center; }
    }
  </style>

  <div class="brand-page grid-bg">

    <!-- ═══ HERO ═══ -->
    <div class="hero">
      <div class="hero-badge">
        <span></span>
        Internal Use · Social Media Team
      </div>
      <h1 class="hero-title">Insighty<br/>Brand Kit</h1>
      <p class="hero-sub">Typography, colors, gradients, and carousel templates — everything your team needs to create on-brand content.</p>
      <div class="hero-meta">
        <div class="hero-meta-item">
          <strong>Inter Tight</strong>
          <span>Primary typeface</span>
        </div>
        <div class="hero-meta-item">
          <strong>#070b10</strong>
          <span>Base background</span>
        </div>
        <div class="hero-meta-item">
          <strong>13</strong>
          <span>Gradient tokens</span>
        </div>
        <div class="hero-meta-item">
          <strong>4:5</strong>
          <span>Carousel ratio</span>
        </div>
      </div>
    </div>

    <hr class="divider" />

    <!-- ═══ LOGO MARK ═══ -->
    <div class="section" style="padding-bottom:0;">
      <span class="section-label">00 — Logo Mark</span>
      <h2 class="section-title">Logo System</h2>
      <p class="section-desc">Icon · Satoshi Medium · letter-spacing: 0.04em · all lowercase</p>
    </div>

    <div style="max-width:1400px; margin:0 auto; padding:0 48px 80px;">
      <div class="logo-variants">

        <!-- 1. Gradient lockup on white -->
        <div class="logo-cell" style="background:#ffffff;">
          <div class="logo-cell-label" style="color:#aaa;">White bg · gradient</div>
          <div class="logo-lockup">
            <svg width="52" height="52" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="lw1" x1="5" y1="5" x2="95" y2="95" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#4a6ec7"/>
                  <stop offset="100%" stop-color="#d4a574"/>
                </linearGradient>
              </defs>
              <g stroke="url(#lw1)" stroke-linecap="butt">
                <line x1="50" y1="50" x2="63" y2="5"  stroke-width="2.4"/>
                <line x1="50" y1="50" x2="87" y2="19" stroke-width="2.0"/>
                <line x1="50" y1="50" x2="94" y2="44" stroke-width="2.0"/>
                <line x1="50" y1="50" x2="9"  y2="34" stroke-width="2.4"/>
                <line x1="50" y1="50" x2="5"  y2="51" stroke-width="2.0"/>
                <line x1="50" y1="50" x2="26" y2="92" stroke-width="2.4"/>
                <line x1="50" y1="50" x2="47" y2="97" stroke-width="2.0"/>
                <line x1="50" y1="50" x2="84" y2="90" stroke-width="2.0"/>
                <line x1="50" y1="50" x2="96" y2="36" stroke-width="1.6"/>
              </g>
