---
---
<!-- =========================
Testimonials section
===========================-->
<section class="bg-background-2 dark:bg-background-5 relative py-16 md:py-[100px] xl:py-[200px]">
  <div class="main-container">
    <div class="space-y-16 sm:space-y-20">
      <div class="text-center">
        <h2 data-ns-animate data-delay="0.1" class="mx-auto w-full max-w-[776px]">
          Agencies Are Excited About Insighty
        </h2>
      </div>
      <div data-ns-animate data-delay="0.2" class="relative">
        <div class="reviews-fade-in-swiper">
          <div class="swiper-wrapper">
            <div class="swiper-slide">
              <div class="dark:bg-background-8 relative min-h-[470px] w-full rounded-4xl bg-white">
                <div
                  class="absolute -top-14 left-1/2 mx-auto w-full max-w-[464px] -translate-x-1/2 px-6 text-center sm:px-0"
                >
                  <figure
                    class="bg-background-1 dark:bg-background-8 dark:border-background-5 mx-auto mb-4 size-28 overflow-hidden rounded-full border-4 border-white sm:mb-[42px]"
                  >
                    <img
                      src="/images/ns-avatar-6.png"
                      alt="avatar"
                      class="size-full object-cover"
                    />
                  </figure>
                  <p
                    class="text-tagline-1 text-secondary dark:text-accent leading-[27px] font-medium md:text-lg"
                  >
                    "Finally, a tool built specifically for how agencies actually operate. This is exactly what we've been looking for."
                  </p>
                  <div class="bg-stroke-2 dark:bg-stroke-6 my-7 h-px w-full"></div>
                  <div>
                    <h3 class="text-secondary dark:text-accent text-lg leading-[27px] font-medium">
                      Sarah Mitchell
                    </h3>
                    <p class="text-tagline-2">Agency Owner, Studio North</p>
                  </div>
                </div>
                <div class="absolute bottom-14 left-1/2 -translate-x-1/2">
                  <a
                    href="/testimonial"
                    class="btn hover:btn-primary dark:btn-transparent btn-secondary btn-md"
                  >
                    <span>Become a Founding Member</span>
                  </a>
                </div>
              </div>
            </div>
            <div class="swiper-slide">
              <div class="dark:bg-background-8 relative min-h-[470px] w-full rounded-4xl bg-white">
                <div
                  class="absolute -top-14 left-1/2 mx-auto w-full max-w-[464px] -translate-x-1/2 px-6 text-center sm:px-0"
                >
                  <figure
                    class="bg-background-1 dark:bg-background-8 dark:border-background-5 mx-auto mb-4 size-28 overflow-hidden rounded-full border-4 border-white sm:mb-[42px]"
                  >
                    <img
                      src="/images/ns-avatar-1.png"
                      alt="avatar"
                      class="size-full object-cover"
                    />
                  </figure>
                  <p
                    class="text-tagline-1 text-secondary dark:text-accent leading-[27px] font-medium md:text-lg"
                  >
                    "The 'This Month' dashboard alone saves us hours every month. We've already recovered thousands in missed invoices."
                  </p>
                  <div class="bg-stroke-2 dark:bg-stroke-6 my-7 h-px w-full"></div>
                  <div>
                    <p class="text-secondary dark:text-accent text-lg leading-[27px] font-medium">
                      James Torres
                    </p>
                    <p class="text-tagline-2">Project Manager, Digital Studio</p>
                  </div>
                </div>
                <div class="absolute bottom-14 left-1/2 -translate-x-1/2">
                  <a
                    href="/testimonial"
                    class="btn hover:btn-primary dark:btn-transparent btn-secondary btn-md"
                  >
                    <span>Become a Founding Member</span>
                  </a>
                </div>
              </div>
            </div>
            <div class="swiper-slide">
              <div class="dark:bg-background-8 relative min-h-[470px] w-full rounded-4xl bg-white">
                <div
                  class="absolute -top-14 left-1/2 mx-auto w-full max-w-[464px] -translate-x-1/2 px-6 text-center sm:px-0"
                >
                  <figure
                    class="bg-background-1 dark:bg-background-8 dark:border-background-5 mx-auto mb-4 size-28 overflow-hidden rounded-full border-4 border-white sm:mb-[42px]"
                  >
                    <img
                      src="/images/ns-avatar-2.png"
                      alt="avatar"
                      class="size-full object-cover"
                    />
                  </figure>
                  <p
                    class="text-tagline-1 text-secondary dark:text-accent leading-[27px] font-medium md:text-lg"
                  >
                    "Managing multiple client retainers used to be a nightmare. Insighty is exactly the kind of clarity we've been waiting for."
                  </p>
                  <div class="bg-stroke-2 dark:bg-stroke-6 my-7 h-px w-full"></div>
                  <div>
                    <p class="text-secondary dark:text-accent text-lg leading-[27px] font-medium">
                      Emma Schulz
                    </p>
                    <p class="text-tagline-2">COO, CreativeOps Agency</p>
                  </div>
                </div>
                <div class="absolute bottom-14 left-1/2 -translate-x-1/2">
                  <a
                    href="/testimonial"
                    class="btn hover:btn-primary dark:btn-transparent btn-secondary btn-md"
                  >
                    <span>Become a Founding Member</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Navigation buttons -->
          <div
            class="pointer-events-none absolute top-1/2 left-1/2 z-10 flex w-full -translate-x-1/2 -translate-y-1/2 items-center justify-between px-4 sm:px-16"
          >
            <button
              class="reviews-fade-in-prev pointer-events-auto"
              aria-label="Previous testimonial"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="25"
                height="24"
                viewBox="0 0 25 24"
                fill="none"
              >
                <path
                  d="M14.1875 17L9.1875 12L14.1875 7"
                  class="dark:stroke-accent stroke-[#292929]"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button class="reviews-fade-in-next pointer-events-auto" aria-label="Next testimonial">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="25"
                height="24"
                viewBox="0 0 25 24"
                fill="none"
              >
                <path
                  d="M10.8125 17L15.8125 12L10.8125 7"
                  class="dark:stroke-accent stroke-[#292929]"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>

          <!-- Pagination dots -->
          <div class="reviews-fade-in-pagination"></div>
        </div>
      </div>
    </div>
  </div>
</section>
