---
---
<!-- =========================
Pixel AI section
===========================-->
<section id="pixel-ai" class="py-16 md:py-[100px] xl:py-[140px] overflow-hidden relative" style="background: linear-gradient(155deg, #112445 0%, #1b3a6b 55%, #4a6ec7 100%)">

  <!-- grid overlay -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>
  <!-- top glow -->
  <div class="pointer-events-none absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[500px] rounded-full opacity-30 blur-[120px]" style="background: radial-gradient(ellipse, #6e8fd9 0%, transparent 70%);"></div>

  <div class="main-container relative z-10 space-y-14 md:space-y-20">

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 xl:gap-20 items-center">

      <!-- Left: copy -->
      <div class="space-y-7">
        <span data-ns-animate data-delay="0.1" class="inline-block border border-white/30 text-white text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">Meet PIXEL AI</span>
        <h2 data-ns-animate data-delay="0.2" class="text-white leading-tight">
          AI That Actually Understands<br/><em class="not-italic text-primary-300">Your Agency.</em>
        </h2>
        <p data-ns-animate data-delay="0.3" class="text-white max-w-[500px]">
          Pixel Intelligence is your AI operations assistant. It continuously monitors your revenue, projects, contracts, and infrastructure. When something needs attention — an invoice that's late, a project going over budget, a domain expiring, a client at risk — Pixel alerts you immediately. No manual checking. No missed opportunities. Just smart, proactive insights.
        </p>
      </div>

      <!-- Right: AI mockup card -->
      <div
        data-ns-animate
        data-delay="0.3"
        data-direction="up"
        data-offset="60"
        class="relative rounded-[20px] overflow-hidden"
        style="background: #161929; border: 1px solid rgba(255,255,255,0.07); box-shadow: 0 0 0 1px rgba(255,255,255,0.03) inset, 0 40px 80px -20px rgba(0,0,0,0.6), 0 0 60px -10px rgba(74,110,199,0.15);"
      >
        <!-- inner top shine -->
        <div class="pointer-events-none absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(90deg, transparent 5%, rgba(255,255,255,0.09) 50%, transparent 95%);"></div>
        <!-- inner glow -->
        <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-48 opacity-25 blur-[70px]" style="background: radial-gradient(ellipse, #4a6ec7, transparent 70%);"></div>

        <div class="p-6 space-y-4 relative">

          <!-- Header -->
          <div class="flex items-center gap-3 pb-4 border-b" style="border-color: rgba(255,255,255,0.07);">
            <span class="size-9 rounded-xl flex items-center justify-center shrink-0" style="background: #1b3a6b; box-shadow: 0 0 0 1px rgba(255,255,255,0.1) inset, 0 0 16px rgba(74,110,199,0.4);">
              <svg id="pixel-star" width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M12 2L13.09 8.26L19 6L14.74 10.74L21 12L14.74 13.26L19 18L13.09 15.74L12 22L10.91 15.74L5 18L9.26 13.26L3 12L9.26 10.74L5 6L10.91 8.26L12 2Z" fill="white"/>
              </svg>
            </span>
            <div class="flex-1 min-w-0">
              <p class="text-white text-tagline-1 font-semibold leading-tight">Pixel AI</p>
              <p class="flex items-center gap-1.5 mt-0.5">
                <span id="pixel-dot" class="size-1.5 rounded-full bg-ns-green shrink-0"></span>
                <span class="text-ns-green font-semibold tracking-widest uppercase" style="font-size: 10px;">Analyzing</span>
                <span class="text-white/25 text-tagline-3">·</span>
                <span id="pixel-clock" class="text-white/40" style="font-size: 10px;"></span>
              </p>
            </div>
          </div>

          <!-- Feed: populated by JS -->
          <div id="pixel-feed" class="flex flex-col gap-2.5"></div>

          <!-- Ask input -->
          <div
            class="pixel-input flex items-center justify-between rounded-xl px-4 py-3 cursor-text"
            style="background: #0e1120; border: 1px solid rgba(255,255,255,0.07); transition: border-color 0.2s ease;"
          >
            <span class="text-tagline-1 select-none" style="color: rgba(255,255,255,0.45);">
              Ask Pixel anything<span id="pixel-cursor" class="ml-px">|</span>
            </span>
            <kbd style="font-size:10px; color: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-family: monospace; line-height: 1;">⌘K</kbd>
          </div>

        </div>
      </div>

    </div>
  </div>

  <style>
    @keyframes pxCursorBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    #pixel-cursor { animation: pxCursorBlink 1.1s step-end infinite; }

    @keyframes pxDotPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(45,155,155,0.7); }
      60% { box-shadow: 0 0 0 5px rgba(45,155,155,0); }
    }
    #pixel-dot { animation: pxDotPulse 2.2s ease-in-out infinite; }

    @keyframes pxSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    #pixel-star { animation: pxSpin 18s linear infinite; transform-origin: center; }

    .pixel-card {
      border: 1px solid transparent;
      transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .pixel-card:hover {
      background: #202540 !important;
      border-color: rgba(255,255,255,0.09) !important;
      box-shadow: 0 4px 16px rgba(0,0,0,0.25);
    }

    .pixel-input:hover { border-color: rgba(255,255,255,0.18) !important; }

    @media (prefers-reduced-motion: reduce) {
      #pixel-cursor, #pixel-dot, #pixel-star { animation: none !important; opacity: 1 !important; transform: none !important; }
    }
  </style>

  <script>
    // All insight content is static — no user input involved
    const INSIGHTS = [
      {
        label: 'Invoicing',
        lc: ['text-primary-400', 'bg-primary-500/10'],
        parts: [
          { bold: true,  t: '34 invoices' },
          { bold: false, t: ' are ready to issue this morning. ' },
          { bold: true,  t: '€ 31,950' },
          { bold: false, t: ' total.' },
        ],
      },
      {
        label: 'Pipeline',
        lc: ['text-ns-yellow', 'bg-ns-yellow/10'],
        parts: [
          { bold: true,  t: '5 proposals' },
          { bold: false, t: ' have gone quiet — last one 11 days ago. Drafts ready.' },
        ],
      },
      {
        label: 'Expiring',
        lc: ['text-orange-400', 'bg-orange-500/10'],
        parts: [
          { bold: true,  t: 'insighty.io' },
          { bold: false, t: ' domain expires in 6 days. Auto-renew disabled.' },
        ],
      },
      {
        label: 'Margin',
        lc: ['text-ns-green', 'bg-ns-green/10'],
        parts: [
          { bold: false, t: 'All active projects tracking ' },
          { bold: true,  t: '≥ 38% margin' },
          { bold: false, t: '. No interventions needed.' },
        ],
      },
      {
        label: 'Capacity',
        lc: ['text-cyan-400', 'bg-cyan-500/10'],
        parts: [
          { bold: true,  t: '3 team members' },
          { bold: false, t: ' over 90% utilised next week. Consider reshuffling.' },
        ],
      },
      {
        label: 'Revenue',
        lc: ['text-primary-400', 'bg-primary-500/10'],
        parts: [
          { bold: false, t: 'Monthly target at ' },
          { bold: true,  t: '€ 47,200' },
          { bold: false, t: '. On track to exceed by ' },
          { bold: true,  t: '12%' },
          { bold: false, t: '.' },
        ],
      },
      {
        label: 'Contract',
        lc: ['text-ns-yellow', 'bg-ns-yellow/10'],
        parts: [
          { bold: true,  t: 'Acme Corp' },
          { bold: false, t: ' retainer renews in 14 days. Review pricing before renewal.' },
        ],
      },
      {
        label: 'Overdue',
        lc: ['text-orange-400', 'bg-orange-500/10'],
        parts: [
          { bold: true,  t: 'Invoice #1042' },
          { bold: false, t: ' is 21 days overdue. ' },
          { bold: true,  t: '€ 4,800' },
          { bold: false, t: ' outstanding.' },
        ],
      },
    ];

    const ENTER_MS = 420;
    const EXIT_MS  = 250;
    const CYCLE_MS = 3800;
    const reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let slotIdx    = 0;
    let nextInsight = 4;
    let started    = false;

    function updateClock() {
      const el = document.getElementById('pixel-clock');
      if (!el) return;
      const t = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      el.textContent = t + ' CET';
    }

    // Build card label element
    function makeLabel(insight) {
      const span = document.createElement('span');
      span.setAttribute('data-label', '');
      span.className = ['inline-block', 'px-2', 'py-0.5', 'rounded-md', 'mb-1.5',
                        'font-semibold', 'tracking-widest', ...insight.lc].join(' ');
      Object.assign(span.style, { fontSize: '10px', textTransform: 'uppercase', letterSpacing: '0.08em' });
      span.textContent = insight.label;
      return span;
    }

    // Build card text paragraph using structured parts (no innerHTML)
    function makeText(insight) {
      const p = document.createElement('p');
      p.setAttribute('data-text', '');
      p.className = 'text-tagline-1 leading-snug';
      p.style.color = 'rgba(255,255,255,0.85)';
      insight.parts.forEach(part => {
        if (part.bold) {
          const strong = document.createElement('strong');
          strong.className = 'text-white font-medium';
          strong.textContent = part.t;
          p.appendChild(strong);
        } else {
          p.appendChild(document.createTextNode(part.t));
        }
      });
      return p;
    }

    function makeCard(insight) {
      const d = document.createElement('div');
      d.className = 'pixel-card rounded-xl p-4';
      d.style.background = '#1c2035';
      d.appendChild(makeLabel(insight));
      d.appendChild(makeText(insight));
      return d;
    }

    // Update existing card's content in place
    function updateCardContent(card, insight) {
      const oldLabel = card.querySelector('[data-label]');
      const oldText  = card.querySelector('[data-text]');
      const newLabel = makeLabel(insight);
      const newText  = makeText(insight);
      if (oldLabel) card.replaceChild(newLabel, oldLabel);
      else card.prepend(newLabel);
      if (oldText) card.replaceChild(newText, oldText);
      else card.appendChild(newText);
    }

    function fadeIn(el, delay = 0) {
      if (reduced) { el.style.opacity = '1'; return; }
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
      setTimeout(() => {
        el.style.transition = `opacity ${ENTER_MS}ms cubic-bezier(0.16,1,0.3,1), transform ${ENTER_MS}ms cubic-bezier(0.16,1,0.3,1)`;
        requestAnimationFrame(() => { el.style.opacity = '1'; el.style.transform = 'translateY(0)'; });
      }, delay);
    }

    function fadeOut(el, cb) {
      if (reduced) { cb(); return; }
      el.style.transition = `opacity ${EXIT_MS}ms cubic-bezier(0.4,0,1,1), transform ${EXIT_MS}ms cubic-bezier(0.4,0,1,1)`;
      el.style.opacity = '0';
      el.style.transform = 'translateY(-6px)';
      setTimeout(cb, EXIT_MS + 10);
    }

    function initFeed() {
      const feed = document.getElementById('pixel-feed');
      if (!feed) return;
      INSIGHTS.slice(0, 4).forEach((insight, i) => {
        const card = makeCard(insight);
        feed.appendChild(card);
        fadeIn(card, i * 340);
      });
      if (!reduced) setTimeout(() => setInterval(cycleSlot, CYCLE_MS), 4 * 340 + 2000);
    }

    function cycleSlot() {
      const feed = document.getElementById('pixel-feed');
      if (!feed) return;
      const cards = feed.querySelectorAll('.pixel-card');
      if (!cards.length) return;

      const card    = cards[slotIdx % cards.length];
      const insight = INSIGHTS[nextInsight % INSIGHTS.length];
      slotIdx++;
      nextInsight++;

      fadeOut(card, () => {
        updateCardContent(card, insight);
        card.style.transform = 'translateY(8px)';
        card.style.transition = `opacity ${ENTER_MS}ms cubic-bezier(0.16,1,0.3,1), transform ${ENTER_MS}ms cubic-bezier(0.16,1,0.3,1)`;
        requestAnimationFrame(() => { card.style.opacity = '1'; card.style.transform = 'translateY(0)'; });
      });
    }

    const section = document.getElementById('pixel-ai');
    if (section) {
      const io = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting && !started) {
          started = true;
          initFeed();
          io.disconnect();
        }
      }, { threshold: 0.2 });
      io.observe(section);
    }

    updateClock();
    setInterval(updateClock, 60_000);
  </script>

</section>
