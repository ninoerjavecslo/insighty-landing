---
---
<!-- ===============================
  Services section
 =============================== -->
<section
  id="product-tour"
  class="xl:py-[200px] md:py-[100px] py-16 bg-background-2 dark:bg-background-5 space-y-[100px] overflow-hidden"
>
  <div class="main-container lg:space-y-[100px] md:space-y-[80px] space-y-20 sm:space-y-16">
    <!-- section-content -->
    <div class="max-w-[650px] mx-auto w-full text-center space-y-4">
      <span data-ns-animate data-delay="0.1" class="inline-block border border-secondary/25 text-secondary text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">Product Tour</span>
      <h2 data-ns-animate data-delay="0.2">Designed for Agencies. Built by Agencies.</h2>
      <p data-ns-animate data-delay="0.3">
        Explore how Insighty brings all your data together. See revenue planning, forecasting, and operations—all in one platform.
      </p>
    </div>
    <!-- services-1 -->
    <div class="grid grid-cols-12 items-center xl:gap-[100px] lg:gap-20 md:gap-y-14 gap-y-6">
      <div class="col-span-12 lg:col-span-6">
        <figure
          data-ns-animate
          data-delay="0.1"
          data-direction="right"
          data-offset="100"
          class="lg:max-w-[595px] max-w-[500px] w-full lg:mx-0 mx-auto"
        >
          <img
            src="/images/shared/client-detail-card.png"
            alt="Client detail view"
            class="w-full h-full object-cover"
          />
        </figure>
      </div>
      <div class="col-span-12 lg:col-span-6">
        <div class="lg:text-left text-center">
          <div class="sm:space-y-3 space-y-1.5 lg:mb-8 mb-6">
            <p data-ns-animate data-delay="0.1" class="text-tagline-3 font-medium text-secondary dark:text-accent uppercase tracking-widest">Client Intelligence</p>
            <h3 data-ns-animate data-delay="0.2" class="max-w-[509px] lg:mx-0 mx-auto">
              One client. The full picture.
            </h3>
            <p data-ns-animate data-delay="0.3">
              Your client isn't a row in a spreadsheet. Open their page and see every active project, every invoice planned or issued, every domain expiring, every change request, every hosting.
            </p>
          </div>
          <ul class="list-none lg:mb-0 mb-0 flex flex-col gap-3 lg:items-start items-center">
            <li data-ns-animate data-delay="0.35" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Projects with total value, amount invoiced, and current status</span>
            </li>
            <li data-ns-animate data-delay="0.4" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Full invoice history across projects and maintenance contracts</span>
            </li>
            <li data-ns-animate data-delay="0.45" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Hosting costs, domain expiry dates, and contract end dates per client</span>
            </li>
            <li data-ns-animate data-delay="0.5" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Pipeline and open proposals linked to the same client</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
    <!-- services-2 -->
    <div
      class="grid grid-cols-12 items-center xl:gap-[100px] lg:gap-20 md:gap-y-10 sm:gap-y-5 gap-y-3"
    >
      <div class="col-span-12 lg:col-span-6 lg:order-1 order-2">
        <div class="md:space-y-8 space-y-6 lg:text-left text-center">
          <div class="sm:space-y-3 space-y-1.5">
            <p data-ns-animate data-delay="0.1" class="text-tagline-3 font-medium text-secondary dark:text-accent uppercase tracking-widest">Invoice Planning</p>
            <h3 data-ns-animate data-delay="0.2" class="lg:mx-0 mx-auto lg:max-w-[498px] w-full">
              Know what to send.<br />Every time you need.
            </h3>
            <p data-ns-animate data-delay="0.3" class="lg:mx-0 mx-auto lg:max-w-[412px]">
              A 6-month matrix shows your entire billing pipeline at once. This Month narrows it down to what needs action today — confirm it, issue it, or move it to next month with one click. No spreadsheet. No missed invoices.
            </p>
          </div>
          <ul class="list-none flex flex-col gap-3 lg:items-start items-center">
            <li data-ns-animate data-delay="0.35" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Six-month view of planned and issued invoices per project</span>
            </li>
            <li data-ns-animate data-delay="0.4" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">One-click confirm, defer, or transfer to another month</span>
            </li>
            <li data-ns-animate data-delay="0.45" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Monthly target vs. achieved progress always on screen</span>
            </li>
            <li data-ns-animate data-delay="0.5" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Retainers auto-populate so recurring billing never gets forgotten</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="col-span-12 lg:col-span-6 lg:order-2 order-1">
        <figure
          data-ns-animate
          data-delay="0.1"
          data-direction="left"
          class="lg:max-w-[595px] max-w-[500px] w-full lg:mx-0 mx-auto"
        >
          <img
            src="/images/shared/invoice-planning-card.png"
            alt="Invoice planning view"
            class="w-full h-full object-cover"
          />
        </figure>
      </div>
    </div>
    <!-- services-3 -->
    <div class="grid grid-cols-12 items-center xl:gap-10 gap-y-14">
      <div class="col-span-12 xl:col-span-6">
        <figure
          data-ns-animate
          data-delay="0.1"
          data-direction="right"
          class="lg:max-w-[595px] max-w-[500px] w-full lg:mx-0 mx-auto"
        >
          <img
            src="/images/shared/sales-pipeline-card.png"
            alt="Sales pipeline view"
            class="w-full h-full object-cover"
          />
        </figure>
      </div>
      <div class="col-span-12 xl:col-span-6">
        <div class="text-center services-content-4 xl:text-left">
          <div class="space-y-3 mb-6">
            <p data-ns-animate data-delay="0.1" class="text-tagline-3 font-medium text-secondary dark:text-accent uppercase tracking-widest">Sales & Change Requests</p>
            <h3 data-ns-animate data-delay="0.2" class="max-w-[509px] mx-auto xl:mx-0">
              From proposal to paid. No manual steps.
            </h3>
            <p data-ns-animate data-delay="0.3" class="max-w-[465px] mx-auto xl:mx-0">
              Win a deal and the project is already structured. Approve a change request and it feeds straight into the invoice plan. The full revenue loop — without the copy-pasting.
            </p>
          </div>
          <ul class="list-none mb-0 flex flex-col gap-3 xl:items-start items-center">
            <li data-ns-animate data-delay="0.35" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Pipeline tracks proposals with probability scores and estimated value</span>
            </li>
            <li data-ns-animate data-delay="0.4" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Won deals flow directly into project setup and billing</span>
            </li>
            <li data-ns-animate data-delay="0.45" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Change requests move from pending → approved → invoiced</span>
            </li>
            <li data-ns-animate data-delay="0.5" class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-2 font-normal text-black dark:text-accent">Forecast always reflects approved work, not just wishful pipeline</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
