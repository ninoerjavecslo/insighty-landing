---
---
<!-- =========================
CTA section — Founding Member Form
===========================-->
<section class="bg-background-2 dark:bg-background-5 relative py-16 md:py-[100px] xl:py-[150px]">
  <div class="main-container">
    <div class="dark:bg-background-6 relative z-10 w-full overflow-hidden rounded-[24px] lg:rounded-[32px] bg-white">


      <div class="grid grid-cols-1 lg:grid-cols-2">

        <!-- Left: copy -->
        <div class="px-8 py-10 md:px-12 md:py-14 xl:px-16 xl:py-20 flex flex-col justify-center space-y-6 lg:border-r border-stroke-1/10 dark:border-stroke-5">
          <span data-ns-animate data-delay="0.1" class="inline-block border border-secondary/25 text-secondary text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5 self-start">Founding Member</span>
          <div class="space-y-4">
            <h2 data-ns-animate data-delay="0.2" class="max-w-[420px]">
              Be part of something before everyone else is.
            </h2>
            <p data-ns-animate data-delay="0.3" class="max-w-[400px]">
              A limited number of founding member spots are open before launch. Lock in early access, founding pricing, and a direct line to the product team.
            </p>
          </div>
          <ul data-ns-animate data-delay="0.35" class="space-y-3">
            <li class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-1 font-normal text-black dark:text-accent">Early access before public launch</span>
            </li>
            <li class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-1 font-normal text-black dark:text-accent">Founding member pricing — locked for life</span>
            </li>
            <li class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-1 font-normal text-black dark:text-accent">Direct influence on the product roadmap</span>
            </li>
            <li class="flex items-center gap-3">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0"><rect width="18" height="18" rx="9" class="fill-secondary dark:fill-accent"/><path d="M8.31661 12.7561L13.7491 7.42144C14.0836 7.0959 14.0836 6.5697 13.7491 6.24416C13.4145 5.91861 12.8736 5.91861 12.539 6.24416L7.7116 10.9901L5.46096 8.78807C5.12636 8.46253 4.58554 8.46253 4.25095 8.78807C3.91635 9.11362 3.91635 9.63982 4.25095 9.96536L7.1066 12.7561C7.27347 12.9184 7.49253 13 7.7116 13C7.93067 13 8.14974 12.9184 8.31661 12.7561Z" class="fill-white dark:fill-secondary"/></svg>
              <span class="text-tagline-1 font-normal text-black dark:text-accent">Private founding member community</span>
            </li>
          </ul>
        </div>

        <!-- Right: form -->
        <div class="px-8 py-10 md:px-12 md:py-14 xl:px-16 xl:py-20 flex flex-col justify-center">
          <form data-ns-animate data-delay="0.2" class="space-y-4" onsubmit="return false;">
            <div class="space-y-1.5">
              <label for="cta-name" class="text-tagline-2 font-medium text-secondary dark:text-accent">Full name</label>
              <input
                id="cta-name"
                name="name"
                type="text"
                placeholder="Sam Carter"
                class="w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-secondary dark:focus:border-accent transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="cta-email" class="text-tagline-2 font-medium text-secondary dark:text-accent">Work email</label>
              <input
                id="cta-email"
                name="email"
                type="email"
                placeholder="sam@agency.com"
                class="w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-secondary dark:focus:border-accent transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="cta-company" class="text-tagline-2 font-medium text-secondary dark:text-accent">Agency name</label>
              <input
                id="cta-company"
                name="company"
                type="text"
                placeholder="Your agency"
                class="w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent placeholder:text-secondary/30 dark:placeholder:text-accent/30 focus:outline-none focus:border-secondary dark:focus:border-accent transition-colors"
              />
            </div>
            <div class="space-y-1.5">
              <label for="cta-role" class="text-tagline-2 font-medium text-secondary dark:text-accent">Team size</label>
              <select
                id="cta-role"
                name="role"
                class="w-full rounded-xl border border-stroke-2 dark:border-stroke-6 bg-background-2 dark:bg-background-7 px-4 py-3 text-tagline-1 text-secondary dark:text-accent focus:outline-none focus:border-secondary dark:focus:border-accent transition-colors appearance-none"
              >
                <option value="" disabled selected>Select team size</option>
                <option>1–5 people</option>
                <option>6–15 people</option>
                <option>16–30 people</option>
                <option>30+ people</option>
              </select>
            </div>
            <button
              type="submit"
              class="btn btn-secondary hover:btn-primary dark:btn-accent btn-md w-full mt-2"
            >
              <span>Claim my founding member spot</span>
            </button>
            <p class="text-tagline-3 text-secondary/40 dark:text-accent/40 text-center">
              No credit card required. We'll reach out before launch.
            </p>
          </form>
        </div>

      </div>
    </div>
  </div>
</section>
