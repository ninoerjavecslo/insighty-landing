---
import ThemeToggle from "../atoms/ThemeToggle.astro";
import Logo from "../atoms/Logo.astro";
import { safeFetch, postsQuery } from '../../lib/sanity';
import type { SanityPost } from '../../lib/sanity';

const allPosts: SanityPost[] = await safeFetch<SanityPost[]>(postsQuery, {}, []);
const sorted = [...allPosts].sort((a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf());
const featuredPost = allPosts.find(p => p.featured) ?? sorted[0];
const secondPost   = sorted.find(p => p._id !== featuredPost?._id) ?? sorted[1];
---

<style>
  .header-one {
    opacity: var(--header-opacity, 0);
  }
</style>
<noscript><style>.header-one { opacity: 1 !important; }</style></noscript>

<!-- =========================
Header v1
===========================-->
<header>
  <div
    class="header-one lp:!max-w-[1290px] bg-background-2 dark:border-stroke-6 dark:bg-background-9 fixed top-5 left-1/2 z-50 mx-auto flex w-full max-w-[350px] -translate-x-1/2 items-center justify-between rounded-2xl px-2.5 py-2.5 opacity-0 backdrop-blur-[15px] max-[400px]:max-w-[350px] min-[425px]:max-w-[375px] min-[500px]:max-w-[450px] sm:max-w-[540px] md:max-w-[720px] lg:max-w-[960px] xl:max-w-[1140px] xl:py-0 dark:border"
    data-ns-animate
    data-direction="up"
    data-offset="100"
  >
    <div>
      <a href="/">
        <span class="sr-only">Home</span>
        <Logo class="hidden lg:block w-[140px]" />
        <Logo class="block lg:hidden w-[110px]" />
      </a>
    </div>
    <nav class="hidden items-center xl:flex">
      <ul class="flex items-center">
        <li class="py-2.5">
          <a href="#platform" class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200">
            <span>Platform</span>
          </a>
        </li>
        <li class="py-2.5">
          <a href="#product-tour" class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200">
            <span>Product Tour</span>
          </a>
        </li>
        <li class="py-2.5">
          <a href="#pixel-ai" class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200">
            <span>Pixel AI</span>
          </a>
        </li>
        <li class="py-2.5">
          <a href="#impact" class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200">
            <span>Impact</span>
          </a>
        </li>
        <li class="py-2.5">
          <a href="#faq" class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200">
            <span>FAQ</span>
          </a>
        </li>
        <li class="py-2.5">
          <a href="/pricing" class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200">
            <span>Pricing</span>
          </a>
        </li>
        <!-- Use Cases mega menu -->
        <li class="py-2.5" id="use-cases-nav-item">
          <button
            id="use-cases-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center gap-1.5 rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200"
          >
            <span>Use Cases</span>
            <svg id="use-cases-chevron" class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 14 14" fill="none">
              <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </li>

        <!-- Resources mega menu -->
        <li class="py-2.5" id="resources-nav-item">
          <button
            id="resources-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            class="hover:border-stroke-2 dark:hover:border-stroke-7 text-tagline-2 uppercase tracking-wider text-secondary/85 hover:text-secondary dark:text-white dark:hover:text-white flex items-center gap-1.5 rounded-full border border-transparent px-4 py-2 font-medium transition-all duration-200"
          >
            <span>Resources</span>
            <svg id="resources-chevron" class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 14 14" fill="none">
              <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </li>
      </ul>
    </nav>

    <div class="hidden items-center justify-center xl:flex">
      <a
        href="/request-a-demo"
        class="btn btn-md btn-secondary dark:btn-accent hover:btn-primary !rounded-none"
      >
        <span>Request a Demo</span>
      </a>
    </div>
    <div class="block xl:hidden">
      <button
        class="nav-hamburger bg-background-4 dark:bg-background-6 flex size-12 cursor-pointer flex-col items-center justify-center gap-[5px] rounded-full"
      >
        <span class="sr-only">Menu</span>
        <span class="bg-stroke-9 dark:bg-stroke-1 block h-0.5 w-6"></span>
        <span class="bg-stroke-9 dark:bg-stroke-1 block h-0.5 w-6"></span>
        <span class="bg-stroke-9 dark:bg-stroke-1 block h-0.5 w-6"></span>
      </button>
    </div>
  </div>

  <!-- =========================
  Mobile Menu
  ===========================-->
  <aside
    class="sidebar dark:bg-background-8 scroll-bar fixed top-0 right-0 z-[9999] h-screen w-full translate-x-full bg-white transition-all duration-300 sm:w-[380px] xl:hidden"
  >
    <div class="flex flex-col h-full p-6 sm:p-8">

      <!-- Header -->
      <div class="flex items-center justify-between mb-8">
        <a href="/">
          <span class="sr-only">Home</span>
          <Logo class="w-[120px]" />
        </a>
        <button
          class="nav-hamburger-close bg-background-4 dark:bg-background-9 relative flex size-10 cursor-pointer items-center justify-center rounded-full"
        >
          <span class="sr-only">Close Menu</span>
          <span class="bg-stroke-9/60 dark:bg-stroke-1 absolute block h-0.5 w-4 rotate-45"></span>
          <span class="bg-stroke-9/60 dark:bg-stroke-1 absolute block h-0.5 w-4 -rotate-45"></span>
        </button>
      </div>

      <!-- Nav links -->
      <nav class="flex-1">
        <ul class="space-y-1">
          <li>
            <a
              href="#platform"
              class="nav-hamburger-close text-secondary dark:text-accent text-heading-6 font-normal block py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >Platform</a>
          </li>
          <li>
            <a
              href="#product-tour"
              class="nav-hamburger-close text-secondary dark:text-accent text-heading-6 font-normal block py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >Product Tour</a>
          </li>
          <li>
            <a
              href="#pixel-ai"
              class="nav-hamburger-close text-secondary dark:text-accent text-heading-6 font-normal block py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >Pixel AI</a>
          </li>
          <li>
            <a
              href="#impact"
              class="nav-hamburger-close text-secondary dark:text-accent text-heading-6 font-normal block py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >Impact</a>
          </li>
          <li>
            <a
              href="#faq"
              class="nav-hamburger-close text-secondary dark:text-accent text-heading-6 font-normal block py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >FAQ</a>
          </li>
          <li>
            <a
              href="/pricing"
              class="nav-hamburger-close text-secondary dark:text-accent text-heading-6 font-normal block py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >Pricing</a>
          </li>
          <li>
            <button
              id="mobile-use-cases-trigger"
              class="w-full flex items-center justify-between text-secondary dark:text-accent text-heading-6 font-normal py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >
              <span>Use Cases</span>
              <svg id="mobile-use-cases-chevron" class="w-4 h-4 transition-transform duration-200 text-secondary/80 dark:text-accent/80" viewBox="0 0 16 16" fill="none">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul id="mobile-use-cases-panel" class="hidden pl-3 pb-1 space-y-0.5 pt-1">
              <li><a href="/use-cases/agency" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Agency</a></li>
              <li><a href="/use-cases/it-services" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">IT Services</a></li>
              <li><a href="/use-cases/accounting-finance" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Accounting & Finance</a></li>
              <li><a href="/use-cases/business-operations" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Business Operations</a></li>
              <li><a href="/use-cases/freelancer" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Freelancer</a></li>
            </ul>
          </li>
          <li>
            <button
              id="mobile-resources-trigger"
              class="w-full flex items-center justify-between text-secondary dark:text-accent text-heading-6 font-normal py-3 border-b border-stroke-1/10 dark:border-stroke-5 transition-colors hover:text-primary-500"
            >
              <span>Resources</span>
              <svg id="mobile-resources-chevron" class="w-4 h-4 transition-transform duration-200 text-secondary/80 dark:text-accent/80" viewBox="0 0 16 16" fill="none">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <ul id="mobile-resources-panel" class="hidden pl-3 pb-1 space-y-0.5 pt-1">
              <li><a href="/blog" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Blog</a></li>
              <li><a href="/tools" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Free Tools</a></li>
              <li><a href="/compare" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Comparisons</a></li>
              <li><a href="/success-stories" class="nav-hamburger-close text-secondary/70 dark:text-accent/70 text-tagline-1 block py-2 hover:text-primary-500 transition-colors">Success Stories</a></li>
            </ul>
          </li>
        </ul>
      </nav>

      <!-- CTA -->
      <div class="mt-8">
        <a href="/request-a-demo" class="btn btn-secondary btn-md w-full">
          <span>Request a Demo</span>
        </a>
      </div>

    </div>
  </aside>

  <ThemeToggle />
</header>

<!-- Use Cases mega menu dropdown -->
<div
  id="use-cases-dropdown"
  role="region"
  aria-label="Use Cases menu"
  class="rounded-2xl border border-stroke-2 dark:border-stroke-6 bg-background-1 dark:bg-background-8 shadow-[0_8px_40px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_40px_rgba(0,0,0,0.4)] p-5"
  style="position:fixed; top:80px; left:20px; opacity:0; pointer-events:none; transform:translateY(8px); transition: opacity 0.2s ease, transform 0.2s ease; z-index:9999;"
>
  <div class="grid grid-cols-[auto_260px_200px] gap-2">

    <!-- Left: use cases in 2-col grid -->
    <div>
      <p class="text-tagline-3 uppercase tracking-widest font-semibold text-black dark:text-white px-3 pb-2">Who it's for</p>
      <div class="grid grid-cols-2 gap-0.5">

        <a href="/use-cases/agency" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
          <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="12" height="8" rx="1"/><path d="M5 7V5a3 3 0 016 0v2"/>
            </svg>
          </span>
          <div>
            <p class="text-tagline-2 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Agency</p>
            <p class="text-tagline-3 text-secondary/85 dark:text-accent/85 leading-snug">Revenue, projects & retainers</p>
          </div>
        </a>

        <a href="/use-cases/it-services" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
          <span class="w-7 h-7 rounded-lg bg-ns-green/10 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-ns-green" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="8" r="6"/><path d="M2 8h12M8 2a9.3 9.3 0 000 12M8 2a9.3 9.3 0 010 12"/>
            </svg>
          </span>
          <div>
            <p class="text-tagline-2 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">IT Services</p>
            <p class="text-tagline-3 text-secondary/85 dark:text-accent/85 leading-snug">Hosting, domains & contracts</p>
          </div>
        </a>

        <a href="/use-cases/accounting-finance" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
          <span class="w-7 h-7 rounded-lg bg-ns-yellow/10 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-ns-yellow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 2H4a1 1 0 00-1 1v10a1 1 0 001 1h8a1 1 0 001-1V6L9 2z"/><path d="M9 2v4h4M6 9h4M6 12h2"/>
            </svg>
          </span>
          <div>
            <p class="text-tagline-2 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Accounting & Finance</p>
            <p class="text-tagline-3 text-secondary/85 dark:text-accent/85 leading-snug">Automate invoicing & track revenue</p>
          </div>
        </a>

        <a href="/use-cases/business-operations" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
          <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/>
            </svg>
          </span>
          <div>
            <p class="text-tagline-2 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Business Operations</p>
            <p class="text-tagline-3 text-secondary/85 dark:text-accent/85 leading-snug">Capacity & project profitability</p>
          </div>
        </a>

        <a href="/use-cases/freelancer" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
          <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="5" r="3"/><path d="M2 14c0-3.314 2.686-6 6-6s6 2.686 6 6"/>
            </svg>
          </span>
          <div>
            <p class="text-tagline-2 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Freelancer</p>
            <p class="text-tagline-3 text-secondary/85 dark:text-accent/85 leading-snug">Clients, projects & pipeline</p>
          </div>
        </a>

      </div>
    </div>

    <!-- Middle: blog post list -->
    <div class="border-l border-stroke-2 dark:border-stroke-6 pl-3">
      <p class="text-tagline-3 uppercase tracking-widest font-semibold text-black dark:text-white pb-2">From the blog</p>
      <ul class="space-y-0.5">
        {sorted.slice(0, 3).map((post) => (
          <li>
            <a
              href={`/blog/${post.slug.current}`}
              class="block text-tagline-2 text-secondary/70 dark:text-accent/70 hover:text-primary-500 dark:hover:text-primary-400 transition-colors duration-150 py-1.5 leading-snug line-clamp-1"
            >
              {post.title}
            </a>
          </li>
        ))}
        <li>
          <a href="/blog" class="inline-flex items-center gap-1 text-tagline-3 text-primary-500 hover:text-primary-600 font-medium mt-1 transition-colors duration-150">
            All articles
            <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 6h8M7 3l3 3-3 3"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <!-- Right: founding member card -->
    <div class="flex flex-col">
      <p class="text-tagline-3 uppercase tracking-widest font-semibold text-black dark:text-white px-1 pb-2">Early access</p>
      <a
        href="/founding-member"
        class="flex-1 rounded-xl overflow-hidden border border-stroke-2 dark:border-stroke-5 hover:border-primary-500/40 transition-colors duration-150 group flex flex-col"
        style="background: linear-gradient(155deg, #112445 0%, #1b3a6b 60%, #4a6ec7 100%)"
      >
        <div class="p-4 flex-1 flex flex-col justify-between gap-4">
          <div>
            <span class="inline-block bg-white/10 text-white text-tagline-3 font-semibold tracking-widest uppercase px-2 py-0.5 rounded-md mb-2.5">Founding Member</span>
            <p class="text-white font-semibold text-tagline-1 leading-snug">20 spots left at pre-launch pricing</p>
            <p class="text-white/50 text-tagline-2 mt-1">Lock in your rate before we go public.</p>
          </div>
          <div class="flex items-center gap-1.5 text-white/70 group-hover:text-white transition-colors duration-150">
            <span class="text-tagline-2 font-medium">Claim your spot</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 14 14" fill="none">
              <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </a>
    </div>

  </div>
</div>

<!-- Mega menu dropdown — fixed position, outside all stacking contexts -->
<div
  id="resources-dropdown"
  role="region"
  aria-label="Resources menu"
  class="rounded-2xl border border-stroke-2 dark:border-stroke-6 bg-background-1 dark:bg-background-8 shadow-[0_8px_40px_rgba(0,0,0,0.12)] dark:shadow-[0_8px_40px_rgba(0,0,0,0.4)] p-5"
  style="position:fixed; top:80px; right:20px; width:680px; max-width:calc(100vw - 40px); opacity:0; pointer-events:none; transform:translateY(8px); transition: opacity 0.2s ease, transform 0.2s ease; z-index:9999;"
>
  <div class="grid grid-cols-[1fr_220px] gap-5">

    <!-- Left: nav links -->
    <div class="space-y-0.5">
      <p class="text-tagline-3 uppercase tracking-widest font-semibold text-black dark:text-white px-3 pb-2">Discover</p>

      <a href="/blog" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
        <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 4h12M2 8h8M2 12h6"/>
          </svg>
        </span>
        <div>
          <p class="text-tagline-1 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Blog</p>
          <p class="text-tagline-3 text-secondary/85 dark:text-accent/85">Agency insights, ops guides, and growth tactics</p>
        </div>
      </a>

      <a href="/tools" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
        <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/>
          </svg>
        </span>
        <div>
          <p class="text-tagline-1 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Free Tools</p>
          <p class="text-tagline-3 text-secondary/85 dark:text-accent/85">Calculators and resources, free to use</p>
        </div>
      </a>

      <a href="/compare" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
        <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 8h5M9 8h5M7 4v8M9 4v8"/>
          </svg>
        </span>
        <div>
          <p class="text-tagline-1 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Comparisons</p>
          <p class="text-tagline-3 text-secondary/85 dark:text-accent/85">How Insighty stacks up against 27 tools</p>
        </div>
      </a>

      <a href="/success-stories" class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-background-2 dark:hover:bg-background-7 transition-colors duration-150 group">
        <span class="w-7 h-7 rounded-lg bg-primary-500/10 flex items-center justify-center shrink-0">
          <svg class="w-3.5 h-3.5 text-primary-500" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2l1.5 3 3.5.5-2.5 2.5.5 3.5L8 10l-3 1.5.5-3.5L3 5.5l3.5-.5z"/>
          </svg>
        </span>
        <div>
          <p class="text-tagline-1 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150">Success Stories</p>
          <p class="text-tagline-3 text-secondary/85 dark:text-accent/85">How agencies grow with Insighty</p>
        </div>
      </a>
    </div>

    <!-- Right: two blog posts -->
    <div>
      <p class="text-tagline-3 uppercase tracking-widest font-semibold text-black dark:text-white px-1 pb-2">Latest posts</p>
      <div class="space-y-2">
        {featuredPost && (
          <a
            href={`/blog/${featuredPost.slug.current}`}
            class="block rounded-xl overflow-hidden border border-stroke-2 dark:border-stroke-5 hover:border-primary-500/30 transition-colors duration-150 group"
          >
            <div class="h-[120px] flex items-end p-2.5 relative overflow-hidden" style="background: linear-gradient(135deg, #112445 0%, #4a6ec7 100%)">
              <span class="relative z-10 badge badge-white !text-secondary text-tagline-3 font-medium">{featuredPost.category}</span>
            </div>
            <div class="px-3 py-2 space-y-0.5 bg-background-2 dark:bg-background-7">
              <p class="text-tagline-2 font-semibold text-secondary dark:text-accent group-hover:text-primary-500 transition-colors duration-150 leading-snug line-clamp-2">{featuredPost.title}</p>
              <p class="text-tagline-3 text-secondary/80 dark:text-accent/80">{featuredPost.readTime} min read</p>
            </div>
          </a>
        )}

      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function () {
    function initResourcesMenu() {
      var trigger  = document.getElementById('resources-trigger');
      var dropdown = document.getElementById('resources-dropdown');
      var chevron  = document.getElementById('resources-chevron');
      var navItem  = document.getElementById('resources-nav-item');

      if (!trigger || !dropdown) return;

      var closeTimer = null;

      function positionDropdown() {
        var headerEl = document.querySelector('.header-one');
        if (!headerEl) return;
        var rect = headerEl.getBoundingClientRect();
        dropdown.style.top = (rect.bottom + 12) + 'px';
        dropdown.style.right = (window.innerWidth - rect.right) + 'px';
        dropdown.style.left = 'auto';
      }

      function openMenu() {
        clearTimeout(closeTimer);
        positionDropdown();
        dropdown.style.opacity = '1';
        dropdown.style.pointerEvents = 'auto';
        dropdown.style.transform = 'translateY(0)';
        chevron.style.transform = 'rotate(180deg)';
        trigger.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        closeTimer = setTimeout(function () {
          dropdown.style.opacity = '0';
          dropdown.style.pointerEvents = 'none';
          dropdown.style.transform = 'translateY(8px)';
          chevron.style.transform = '';
          trigger.setAttribute('aria-expanded', 'false');
        }, 150);
      }

      navItem.addEventListener('mouseenter', openMenu);
      navItem.addEventListener('mouseleave', closeMenu);
      dropdown.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
      dropdown.addEventListener('mouseleave', closeMenu);

      trigger.addEventListener('click', function () {
        trigger.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
      });

      document.addEventListener('click', function (e) {
        if (!navItem.contains(e.target) && !dropdown.contains(e.target)) closeMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeMenu();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initResourcesMenu);
    } else {
      initResourcesMenu();
    }
  })();

  // Use Cases mega menu
  (function () {
    function initUseCasesMenu() {
      var trigger  = document.getElementById('use-cases-trigger');
      var dropdown = document.getElementById('use-cases-dropdown');
      var chevron  = document.getElementById('use-cases-chevron');
      var navItem  = document.getElementById('use-cases-nav-item');

      if (!trigger || !dropdown) return;

      var closeTimer = null;

      function positionDropdown() {
        var headerEl = document.querySelector('.header-one');
        if (!headerEl) return;
        var rect = headerEl.getBoundingClientRect();
        dropdown.style.top   = (rect.bottom + 12) + 'px';
        dropdown.style.left  = rect.left + 'px';
        dropdown.style.right = 'auto';
        dropdown.style.width = rect.width + 'px';
      }

      function openMenu() {
        clearTimeout(closeTimer);
        positionDropdown();
        dropdown.style.opacity = '1';
        dropdown.style.pointerEvents = 'auto';
        dropdown.style.transform = 'translateY(0)';
        chevron.style.transform = 'rotate(180deg)';
        trigger.setAttribute('aria-expanded', 'true');
      }

      function closeMenu() {
        closeTimer = setTimeout(function () {
          dropdown.style.opacity = '0';
          dropdown.style.pointerEvents = 'none';
          dropdown.style.transform = 'translateY(8px)';
          chevron.style.transform = '';
          trigger.setAttribute('aria-expanded', 'false');
        }, 150);
      }

      navItem.addEventListener('mouseenter', openMenu);
      navItem.addEventListener('mouseleave', closeMenu);
      dropdown.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
      dropdown.addEventListener('mouseleave', closeMenu);

      trigger.addEventListener('click', function () {
        trigger.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
      });

      document.addEventListener('click', function (e) {
        if (!navItem.contains(e.target) && !dropdown.contains(e.target)) closeMenu();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeMenu();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUseCasesMenu);
    } else {
      initUseCasesMenu();
    }
  })();

  // Mobile accordions (Use Cases + Resources)
  (function () {
    function initMobileAccordion(btnId, panelId, chevronId) {
      var btn     = document.getElementById(btnId);
      var panel   = document.getElementById(panelId);
      var chevron = document.getElementById(chevronId);
      if (!btn || !panel) return;
      btn.addEventListener('click', function () {
        var open = !panel.classList.contains('hidden');
        panel.classList.toggle('hidden', open);
        if (chevron) chevron.style.transform = open ? '' : 'rotate(180deg)';
      });
    }
    function init() {
      initMobileAccordion('mobile-use-cases-trigger', 'mobile-use-cases-panel', 'mobile-use-cases-chevron');
      initMobileAccordion('mobile-resources-trigger', 'mobile-resources-panel', 'mobile-resources-chevron');
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
