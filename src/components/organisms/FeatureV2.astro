---
---
<!-- =========================
How it fits section
===========================-->
<section id="integrations" class="bg-background-3 dark:bg-background-7 py-16 md:py-[100px] xl:py-[150px] overflow-hidden">
  <div class="main-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 xl:gap-24 items-center">

      <!-- Left: floating icons -->
      <div
        data-ns-animate
        data-delay="0.2"
        class="relative h-[480px] xl:h-[560px] select-none"
      >
        <!-- dot grid bg -->
        <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 24px 24px; color: var(--color-stroke-2, #e2e8f0);"></div>

        <!-- connecting lines -->
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <g stroke="#94a3b8" stroke-opacity="0.35" stroke-width="0.4" fill="none">
            <!-- Jira ↔ Xero -->
            <line x1="45" y1="10" x2="86" y2="10"/>
            <!-- Jira ↔ Slack -->
            <line x1="45" y1="10" x2="14" y2="32"/>
            <!-- Jira ↔ Asana -->
            <line x1="45" y1="10" x2="34" y2="58"/>
            <!-- Xero ↔ QuickBooks -->
            <line x1="86" y1="10" x2="88" y2="36"/>
            <!-- Slack ↔ QuickBooks -->
            <line x1="14" y1="32" x2="88" y2="36"/>
            <!-- Slack ↔ Asana -->
            <line x1="14" y1="32" x2="34" y2="58"/>
            <!-- QuickBooks ↔ GitHub -->
            <line x1="88" y1="36" x2="82" y2="61"/>
            <!-- Asana ↔ GitHub -->
            <line x1="34" y1="58" x2="82" y2="61"/>
            <!-- Asana ↔ Stripe -->
            <line x1="34" y1="58" x2="14" y2="85"/>
            <!-- GitHub ↔ Figma -->
            <line x1="82" y1="61" x2="66" y2="90"/>
            <!-- Stripe ↔ Figma -->
            <line x1="14" y1="85" x2="66" y2="90"/>
          </g>
        </svg>

        <!-- Jira -->
        <div class="hero-card-float-1 absolute top-[4%] left-[38%]">
          <div class="size-20 xl:size-24 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="38" height="38" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#0052CC"/><path d="M18.857 17.143L11 9.286 8.857 11.43l7.857 7.857L8.857 27.14 11 29.286l7.857-7.857 7.857 7.857L28.857 27.143l-7.857-7.857 7.857-7.857L26.714 9.286z" fill="white"/></svg>
          </div>
        </div>

        <!-- Xero -->
        <div class="hero-card-float-2 absolute top-[6%] right-[10%]">
          <div class="size-16 xl:size-20 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#13B5EA"/><path d="M12 12l12 12M24 12L12 24" stroke="white" stroke-width="2.5" stroke-linecap="round"/></svg>
          </div>
        </div>

        <!-- Slack -->
        <div class="hero-card-float-3 absolute top-[28%] left-[8%]">
          <div class="size-16 xl:size-20 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#4A154B"/><path d="M13.5 21a1.5 1.5 0 0 1-3 0v-4.5a1.5 1.5 0 0 1 3 0V21zm1.5-9a1.5 1.5 0 0 0 0-3H11a1.5 1.5 0 0 0 0 3h4zm7.5 4.5a1.5 1.5 0 0 0 3 0v-4.5a1.5 1.5 0 0 0-3 0V16.5zm-1.5 9a1.5 1.5 0 0 0 0 3H25a1.5 1.5 0 0 0 0-3h-4zm-9-3a1.5 1.5 0 0 1-3 0V18a1.5 1.5 0 0 1 3 0v4.5zm9-12a1.5 1.5 0 0 1 0 3H18a1.5 1.5 0 0 1 0-3h3zm-4.5 15a1.5 1.5 0 0 0 3 0v-4.5a1.5 1.5 0 0 0-3 0V25zm-9-4.5a1.5 1.5 0 0 0 0 3H11a1.5 1.5 0 0 0 0-3H7z" fill="white"/></svg>
          </div>
        </div>

        <!-- QuickBooks -->
        <div class="hero-card-float-1 absolute top-[30%] right-[5%]" style="animation-delay: 0.5s;">
          <div class="size-20 xl:size-24 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="38" height="38" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#2CA01C"/><circle cx="18" cy="18" r="9" stroke="white" stroke-width="1.5"/><path d="M18 13v10M13 18h10" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
        </div>

        <!-- Asana -->
        <div class="hero-card-float-2 absolute top-[54%] left-[28%]" style="animation-delay: 1s;">
          <div class="size-16 xl:size-20 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#F06A6A"/><circle cx="18" cy="13" r="4" fill="white"/><circle cx="11" cy="22" r="4" fill="white"/><circle cx="25" cy="22" r="4" fill="white"/></svg>
          </div>
        </div>

        <!-- GitHub -->
        <div class="hero-card-float-3 absolute top-[56%] right-[14%]" style="animation-delay: 0.3s;">
          <div class="size-14 xl:size-16 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="28" height="28" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#24292E"/><path d="M18 8C12.477 8 8 12.477 8 18c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.268 2.75 1.026A9.564 9.564 0 0 1 18 12.844a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.026 2.747-1.026.546 1.377.202 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C25.138 26.167 28 22.418 28 18c0-5.523-4.477-10-10-10z" fill="white"/></svg>
          </div>
        </div>

        <!-- Stripe -->
        <div class="hero-card-float-1 absolute bottom-[8%] left-[10%]" style="animation-delay: 0.8s;">
          <div class="size-14 xl:size-16 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="28" height="28" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#635BFF"/><path d="M17 13c-2 0-3 .9-3 2s.8 1.8 3 2.2c2.2.4 4 1.3 4 3.3S19.5 24 17 24c-2 0-3.5-.8-4-2" stroke="white" stroke-width="1.8" stroke-linecap="round"/><line x1="18" y1="10" x2="18" y2="14" stroke="white" stroke-width="1.8" stroke-linecap="round"/><line x1="18" y1="24" x2="18" y2="28" stroke="white" stroke-width="1.8" stroke-linecap="round"/></svg>
          </div>
        </div>

        <!-- Figma -->
        <div class="hero-card-float-2 absolute bottom-[5%] right-[30%]" style="animation-delay: 1.2s;">
          <div class="size-16 xl:size-20 rounded-full bg-white dark:bg-background-8 shadow-lg flex items-center justify-center">
            <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="#A259FF"/><rect x="13" y="9" width="5" height="5" rx="1" fill="#F24E1E"/><rect x="18" y="9" width="5" height="5" rx="1" fill="#FF7262"/><rect x="13" y="14" width="5" height="5" rx="1" fill="#A259FF"/><rect x="13" y="19" width="5" height="5" rx="1" fill="#0ACF83"/><circle cx="20.5" cy="21.5" r="2.5" fill="#1ABCFE"/></svg>
          </div>
        </div>
      </div>

      <!-- Right: text -->
      <div class="space-y-5">
        <span data-ns-animate data-delay="0.1" class="inline-block border border-secondary/25 text-secondary text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">Integrations</span>
        <h2 data-ns-animate data-delay="0.2">
          Keep your stack.<br />Add the layer that makes sense of it.
        </h2>
        <p data-ns-animate data-delay="0.3" class="max-w-[500px]">
          Insighty doesn't replace Jira, Slack, or your accounting tool. It sits above them — pulling the signal that already exists in your stack and turning it into the numbers you actually run the agency on.
        </p>
      </div>

    </div>
  </div>
</section>
