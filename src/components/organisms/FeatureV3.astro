---
---
<!-- =========================
Impact section
===========================-->
<section id="impact" class="relative xl:py-[200px] md:py-[100px] py-16">
  <div class="main-container space-y-16 md:space-y-20">

    <!-- Header -->
    <div class="space-y-4 max-w-[700px] text-center sm:text-left">
      <span data-ns-animate data-delay="0.1" class="inline-block border border-secondary/25 text-secondary text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">The Impact</span>
      <h2 data-ns-animate data-delay="0.2">
        Numbers agencies feel<br />in the first month.
      </h2>
      <p data-ns-animate data-delay="0.3" class="max-w-[520px]">
        Not marketing estimates. This is what happens when you stop reconstructing reality from five tabs and just open one.
      </p>
    </div>

    <!-- Stats bar -->
    <div
      data-ns-animate
      data-delay="0.2"
      class="rounded-2xl px-5 py-2"
      style="background: linear-gradient(135deg, #112445 0%, #1b3a6b 60%, #4a6ec7 100%)"
    >
      <div class="grid grid-cols-2 lg:grid-cols-4 divide-x-0 lg:divide-x divide-y lg:divide-y-0 divide-white/10">

        <!-- Stat 1 -->
        <div class="flex items-center justify-center flex-col gap-5 py-8 px-4 md:px-6 md:py-10 text-center">
          <div class="w-fit">
            <p class="text-heading-3 text-white font-semibold leading-none">8 hrs</p>
          </div>
          <div class="space-y-1.5">
            <p class="text-white text-heading-6">Saved every month</p>
            <p class="text-white text-tagline-2 font-normal max-w-[200px]">No more tab-switching to figure out what's billable.</p>
          </div>
        </div>

        <!-- Stat 2 -->
        <div class="flex items-center justify-center flex-col gap-5 py-8 px-4 md:px-6 md:py-10 text-center">
          <div class="w-fit">
            <p class="text-heading-3 text-white font-semibold leading-none">€2.4k</p>
          </div>
          <div class="space-y-1.5">
            <p class="text-white text-heading-6">Recovered revenue</p>
            <p class="text-white text-tagline-2 font-normal max-w-[200px]">Invoice leakage surfaced and confirmed in one view.</p>
          </div>
        </div>

        <!-- Stat 3 -->
        <div class="flex items-center justify-center flex-col gap-5 py-8 px-4 md:px-6 md:py-10 text-center">
          <div class="w-fit">
            <p class="text-heading-3 text-white font-semibold leading-none">0</p>
          </div>
          <div class="space-y-1.5">
            <p class="text-white text-heading-6">Missed renewals</p>
            <p class="text-white text-tagline-2 font-normal max-w-[200px]">Alerts fire before every domain expiry and contract end.</p>
          </div>
        </div>

        <!-- Stat 4 -->
        <div class="flex items-center justify-center flex-col gap-5 py-8 px-4 md:px-6 md:py-10 text-center">
          <div class="w-fit">
            <p class="text-heading-3 text-white font-semibold leading-none">5 min</p>
          </div>
          <div class="space-y-1.5">
            <p class="text-white text-heading-6">Board summary</p>
            <p class="text-white text-tagline-2 font-normal max-w-[200px]">Revenue, margin, and pipeline assembled automatically.</p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
