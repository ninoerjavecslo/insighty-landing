---
---
<!-- =========================
Founding Member section
===========================-->
<section id="founding-member" class="py-16 md:py-[100px] xl:py-[140px] overflow-hidden relative" style="background: linear-gradient(180deg, #070f1c 0%, #0d1a30 60%, #071018 100%);">

  <!-- subtle grid overlay -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.035]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 36px 36px;"></div>
  <!-- centered brand-blue radial glow -->
  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] opacity-25 blur-[120px]" style="background: radial-gradient(ellipse at 50% 0%, #1b3a6b 0%, #4a6ec7 40%, transparent 70%);"></div>
  <!-- secondary warm accent glow, bottom right -->
  <div class="pointer-events-none absolute bottom-0 right-0 w-[500px] h-[400px] opacity-10 blur-[100px]" style="background: radial-gradient(ellipse at 100% 100%, #2d9b9b 0%, transparent 70%);"></div>

  <div class="main-container relative z-10 space-y-14 md:space-y-20">

    <!-- Header -->
    <div class="space-y-5 text-center max-w-[680px] mx-auto">
      <span data-ns-animate data-delay="0.1" class="inline-block border border-white/30 text-white text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">
        Founding Members
      </span>
      <h2 data-ns-animate data-delay="0.2" class="text-white">
        Why join now, not later?
      </h2>
      <p data-ns-animate data-delay="0.3" class="text-white">
        We're opening a limited number of founding member spots before launch. Here's what you get that nobody else will — ever.
      </p>
    </div>

    <!-- Benefits grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">

      <!-- Lifetime pricing lock -->
      <div
        data-ns-animate
        data-delay="0.2"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-2"
      >
        <p class="text-heading-6 font-medium text-white">Lifetime pricing lock</p>
        <p class="text-white text-tagline-1">The price you sign up at is yours forever. No annual increases, no "we're adjusting pricing" emails. You're in at founding rates for life.</p>
      </div>

      <!-- First access -->
      <div
        data-ns-animate
        data-delay="0.3"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-2"
      >
        <p class="text-heading-6 font-medium text-white">First access to every release</p>
        <p class="text-white text-tagline-1">New modules, new features, Pixel AI updates — founding members get access weeks before public release. You run on the latest version, always.</p>
      </div>

      <!-- Help build it right -->
      <div
        data-ns-animate
        data-delay="0.4"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-2"
      >
        <p class="text-heading-6 font-medium text-white">Help us build it right</p>
        <p class="text-white text-tagline-1">Direct line to the product team. Your workflow, your pain points, your agency's reality. We built the roadmap from real agency input — founding members keep shaping it.</p>
      </div>

      <!-- White-glove onboarding -->
      <div
        data-ns-animate
        data-delay="0.3"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-2"
      >
        <p class="text-heading-6 font-medium text-white">White-glove onboarding</p>
        <p class="text-white text-tagline-1">We'll migrate your data, map your projects, and get you up and running ourselves. No reading docs, no figuring it out alone. Founding members get hands-on setup.</p>
      </div>

      <!-- Private community -->
      <div
        data-ns-animate
        data-delay="0.4"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-2"
      >
        <p class="text-heading-6 font-medium text-white">Private founding member community</p>
        <p class="text-white text-tagline-1">A private group of agency operators who get early access, compare notes, and talk directly to the Insighty team. No noise, no outsiders, no vendor pitches.</p>
      </div>

      <!-- Founding member badge -->
      <div
        data-ns-animate
        data-delay="0.5"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-2"
      >
        <p class="text-heading-6 font-medium text-white">Founding member badge</p>
        <p class="text-white text-tagline-1">Permanently marked as a founding member in your account — the people who believed in Insighty before it launched. A small thing that means something.</p>
      </div>

    </div>

    <!-- CTA -->
    <div data-ns-animate data-delay="0.4" class="text-center space-y-4">
      <a href="/request-a-demo" class="btn btn-xl btn-white inline-block">
        <span>Become a Founding Member</span>
      </a>
      <p class="text-white text-tagline-2">Limited spots available. No credit card required.</p>
    </div>

  </div>
</section>
