---
---
<!-- =========================
Founding Member section
===========================-->
<section id="founding-member" class="py-16 md:py-[100px] xl:py-[140px] overflow-hidden relative" style="background: #060b18;">

  <!-- bg glow -->
  <figure class="pointer-events-none absolute -top-[400px] left-1/2 -z-0 size-[900px] -translate-x-1/2 select-none opacity-30">
    <img src="/images/ns-img-532.png" alt="" class="size-full object-cover" />
  </figure>

  <div class="main-container relative z-10 space-y-14 md:space-y-20">

    <!-- Header -->
    <div class="space-y-5 text-center max-w-[680px] mx-auto">
      <span data-ns-animate data-delay="0.1" class="inline-block border border-white/30 text-white text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">
        Founding Members
      </span>
      <h2 data-ns-animate data-delay="0.2" class="text-accent">
        Why join now, not later?
      </h2>
      <p data-ns-animate data-delay="0.3" class="text-accent/70">
        We're opening a limited number of founding member spots before launch. Here's what you get that nobody else will — ever.
      </p>
    </div>

    <!-- Benefits grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">

      <!-- Lifetime pricing lock -->
      <div
        data-ns-animate
        data-delay="0.2"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <span class="inline-flex items-center justify-center size-11">
          <span class="ns-shape-35 text-white text-[22px]"></span>
        </span>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-white">Lifetime pricing lock</p>
          <p class="text-white/70 text-tagline-1">The price you sign up at is yours forever. No annual increases, no "we're adjusting pricing" emails. You're in at founding rates for life.</p>
        </div>
      </div>

      <!-- First access -->
      <div
        data-ns-animate
        data-delay="0.3"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <span class="inline-flex items-center justify-center size-11">
          <span class="ns-shape-34 text-white text-[22px]"></span>
        </span>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-white">First access to every release</p>
          <p class="text-white/70 text-tagline-1">New modules, new features, Pixel AI updates — founding members get access weeks before public release. You run on the latest version, always.</p>
        </div>
      </div>

      <!-- Help build it right -->
      <div
        data-ns-animate
        data-delay="0.4"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <span class="inline-flex items-center justify-center size-11">
          <span class="ns-shape-45 text-white text-[22px]"></span>
        </span>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-white">Help us build it right</p>
          <p class="text-white/70 text-tagline-1">Direct line to the product team. Your workflow, your pain points, your agency's reality. We built the roadmap from real agency input — founding members keep shaping it.</p>
        </div>
      </div>

      <!-- White-glove onboarding -->
      <div
        data-ns-animate
        data-delay="0.3"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <span class="inline-flex items-center justify-center size-11">
          <span class="ns-shape-8 text-white text-[22px]"></span>
        </span>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-white">White-glove onboarding</p>
          <p class="text-white/70 text-tagline-1">We'll migrate your data, map your projects, and get you up and running ourselves. No reading docs, no figuring it out alone. Founding members get hands-on setup.</p>
        </div>
      </div>

      <!-- Private community -->
      <div
        data-ns-animate
        data-delay="0.4"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <span class="inline-flex items-center justify-center size-11">
          <span class="ns-shape-41 text-white text-[22px]"></span>
        </span>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-white">Private founding member community</p>
          <p class="text-white/70 text-tagline-1">A private group of agency operators who get early access, compare notes, and talk directly to the Insighty team. No noise, no outsiders, no vendor pitches.</p>
        </div>
      </div>

      <!-- Founding member badge -->
      <div
        data-ns-animate
        data-delay="0.5"
        class="bg-white/5 border border-white/10 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <span class="inline-flex items-center justify-center size-11">
          <span class="ns-shape-36 text-white text-[22px]"></span>
        </span>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-white">Founding member badge</p>
          <p class="text-white/70 text-tagline-1">Permanently marked as a founding member in your account — the people who believed in Insighty before it launched. A small thing that means something.</p>
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div data-ns-animate data-delay="0.4" class="text-center space-y-4">
      <a href="/request-a-demo" class="btn btn-xl btn-white inline-block">
        <span>Become a Founding Member</span>
      </a>
      <p class="text-white/60 text-tagline-2">Limited spots available. No credit card required.</p>
    </div>

  </div>
</section>
