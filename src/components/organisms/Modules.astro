---
---
<!-- =========================
Modules section
===========================-->
<section id="platform" class="bg-background-3 dark:bg-background-7 py-16 md:py-[100px] xl:py-[150px]">
  <div class="main-container space-y-14 md:space-y-20">
    <div class="space-y-4">
      <span data-ns-animate data-delay="0.05" class="inline-block border border-secondary/25 text-secondary text-tagline-3 font-medium tracking-widest uppercase px-4 py-1.5">Platform</span>
      <h2
        data-ns-animate
        data-delay="0.1"
        class="mx-auto max-w-[700px] text-center sm:text-left sm:mx-0"
      >
        Six surfaces.<br />One source of truth.
      </h2>
      <p
        data-ns-animate
        data-delay="0.2"
        class="mx-auto max-w-[520px] text-center sm:text-left sm:mx-0"
      >
        Every module reads from the same database. No reconciliation, no cross-tool sync, no stale numbers.
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">

      <!-- 01 Revenue & Forecast -->
      <div
        data-ns-animate
        data-delay="0.2"
        class="bg-white dark:bg-background-8 border border-stroke-1/10 dark:border-stroke-5 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <div class="flex items-start gap-4">
          <span class="bg-background-3 dark:bg-background-6 inline-flex items-center justify-center size-11 rounded-xl">
            <span class="ns-shape-35 text-secondary dark:text-accent text-[22px]"></span>
          </span>
        </div>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-secondary dark:text-accent">Revenue Planner</p>
          <p class="text-tagline-1 font-normal">
            Multi-stream revenue matrix across projects, retainers, hosting, and domains — tracked from planned to paid. Plus a 12-month weighted forecast built on what's actually committed.
          </p>
        </div>
      </div>

      <!-- 02 This Month -->
      <div
        data-ns-animate
        data-delay="0.3"
        class="bg-white dark:bg-background-8 border border-stroke-1/10 dark:border-stroke-5 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <div class="flex items-start gap-4">
          <span class="bg-background-3 dark:bg-background-6 inline-flex items-center justify-center size-11 rounded-xl">
            <span class="ns-shape-34 text-secondary dark:text-accent text-[22px]"></span>
          </span>
        </div>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-secondary dark:text-accent">Invoice Dashboard</p>
          <p class="text-tagline-1 font-normal">
            Every invoice due this month in one focused view. One click to confirm, issue, or defer. Invoice leakage stops here.
          </p>
        </div>
      </div>

      <!-- 03 Clients -->
      <div
        data-ns-animate
        data-delay="0.4"
        class="bg-white dark:bg-background-8 border border-stroke-1/10 dark:border-stroke-5 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <div class="flex items-start gap-4">
          <span class="bg-background-3 dark:bg-background-6 inline-flex items-center justify-center size-11 rounded-xl">
            <span class="ns-shape-41 text-secondary dark:text-accent text-[22px]"></span>
          </span>
        </div>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-secondary dark:text-accent">Client Intelligence</p>
          <p class="text-tagline-1 font-normal">
            Every client's projects, retainers, hosting, domains, and pipeline deals in one profile. Lifetime value, contract history, and financial summary — always current.
          </p>
        </div>
      </div>

      <!-- 04 Infrastructure -->
      <div
        data-ns-animate
        data-delay="0.3"
        class="bg-white dark:bg-background-8 border border-stroke-1/10 dark:border-stroke-5 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <div class="flex items-start gap-4">
          <span class="bg-background-3 dark:bg-background-6 inline-flex items-center justify-center size-11 rounded-xl">
            <span class="ns-shape-8 text-secondary dark:text-accent text-[22px]"></span>
          </span>
        </div>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-secondary dark:text-accent">Infrastructure</p>
          <p class="text-tagline-1 font-normal">
            Hosting revenue per client, domain renewals, and provider costs — tracked line by line. Net margin visible. No renewal arrives as a surprise.
          </p>
        </div>
      </div>

      <!-- 05 Sales Pipeline -->
      <div
        data-ns-animate
        data-delay="0.4"
        class="bg-white dark:bg-background-8 border border-stroke-1/10 dark:border-stroke-5 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <div class="flex items-start gap-4">
          <span class="bg-background-3 dark:bg-background-6 inline-flex items-center justify-center size-11 rounded-xl">
            <span class="ns-shape-45 text-secondary dark:text-accent text-[22px]"></span>
          </span>
        </div>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-secondary dark:text-accent">Sales Pipeline</p>
          <p class="text-tagline-1 font-normal">
            Proposal, negotiation, won, lost. Probability-weighted deal values feed your 12-month revenue forecast automatically.
          </p>
        </div>
      </div>

      <!-- 06 Reports -->
      <div
        data-ns-animate
        data-delay="0.5"
        class="bg-white dark:bg-background-8 border border-stroke-1/10 dark:border-stroke-5 rounded-[20px] p-6 md:p-8 space-y-5"
      >
        <div class="flex items-start gap-4">
          <span class="bg-background-3 dark:bg-background-6 inline-flex items-center justify-center size-11 rounded-xl">
            <span class="ns-shape-36 text-secondary dark:text-accent text-[22px]"></span>
          </span>
        </div>
        <div class="space-y-2">
          <p class="text-heading-6 font-medium text-secondary dark:text-accent">Agency Reports</p>
          <p class="text-tagline-1 font-normal">
            Pipeline impact, delay scenarios, capacity forecast, and monthly digest — assembled automatically and ready for the board.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
