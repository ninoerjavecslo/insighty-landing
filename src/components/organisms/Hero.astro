---
---
<!-- =========================
Hero section
===========================-->
<section
  class="hero-section relative pt-[140px] pb-20 sm:pt-[150px] sm:pb-[100px] md:pt-[160px] md:pb-[130px] lg:pt-[180px] xl:pb-[200px]"
  aria-label="Hero section"
>
  <div class="main-container space-y-[50px] md:space-y-[80px] lg:space-y-[100px]">
    <div class="space-y-10 text-center md:space-y-14">
      <div class="relative z-20 space-y-2 sm:space-y-4">
        <div data-ns-animate data-delay="0.05" class="flex justify-center mb-4 sm:mb-6">
          <div class="p-[1.5px] bg-gradient-to-r from-primary-400 via-primary-300 to-primary-500 max-w-[90vw]">
            <div class="bg-white dark:bg-background-8 px-4 sm:px-5 py-2 backdrop-blur-sm">
              <span class="text-[10px] sm:text-tagline-3 font-semibold text-secondary dark:text-accent uppercase tracking-wider sm:tracking-widest">Early Access &middot; 20 Founding Spots Left</span>
            </div>
          </div>
        </div>
        <h1
          data-ns-animate
          data-delay="0.1"
          class="mx-auto max-w-[450px] sm:max-w-[600px] md:max-w-[800px] lg:max-w-full"
        >
          AI-Powered Agency Intelligence Platform Built for Profitable Growth
        </h1>
        <p
          data-ns-animate
          data-delay="0.2"
          class="mx-auto w-full max-w-[500px] md:max-w-[630px] xl:max-w-[802px]"
        >
          Insighty brings every client, project, contract, and revenue stream into one intelligent
          dashboard. Coming soon to help agencies scale profitably.
        </p>
      </div>
      <div data-ns-animate data-delay="0.3" class="relative z-20">
        <a
          href="/contact"
          class="btn btn-primary btn-md mx-auto w-[90%] md:w-auto"
          aria-label="Join the Insighty waitlist"
        >
          <span>Become a Founding Member</span>
        </a>
      </div>
    </div>
    <div class="relative z-10">
      <div
        data-ns-animate
        data-delay="0.5"
        class="absolute -top-[50%] left-1/2 -z-10 -translate-x-1/2 lg:-top-[35%]"
      >
        <!-- hero bg gradient  -->
        <figure
          class="pointer-events-none mx-auto flex size-[350px] items-center justify-center select-none min-[425px]:size-[400px] sm:size-[550px] md:size-[650px] lg:size-[700px] xl:size-[897px]"
        >
          <img
            src="/images/ns-img-506.png"
            alt="Decorative gradient background"
            class="h-full w-full object-cover"
          />
        </figure>
      </div>
      <!-- dashboard + floating cards wrapper -->
      <div class="relative">
        <!-- hero main img  -->
        <figure
          data-ns-animate
          data-instant
          data-delay="0.4"
          class="mx-auto w-full max-w-[450px] overflow-hidden rounded-xl opacity-0 sm:max-w-[500px] md:max-w-[600px] md:rounded-[20px] lg:max-w-[800px] xl:max-w-[1170px]"
        >
          <img
            src="/images/shared/insighty-dashboard.svg"
            alt="Insighty agency intelligence platform dashboard"
            class="size-full object-cover"
          />
        </figure>

        <!-- Floating card: Quick Actions (left) -->
        <div class="hero-scroll-card-1 absolute hidden lg:block left-4 top-[6%] xl:-left-8 z-20">
          <div class="hero-card-float-1">
            <figure
              data-ns-animate
              data-instant
              data-delay="0.75"
              data-direction="left"
              class="w-[155px] xl:w-[195px] rounded-xl overflow-hidden drop-shadow-[0_8px_32px_rgba(0,0,0,0.18)]"
            >
              <img
                src="/images/shared/insighty-card-quick-actions.svg"
                alt="Quick actions panel"
                class="w-full"
              />
            </figure>
          </div>
        </div>

        <!-- Floating card: Pixel AI (bottom right) -->
        <div class="hero-scroll-card-3 absolute hidden lg:block right-4 bottom-[5%] xl:-right-8 z-20">
          <div class="hero-card-float-3">
            <figure
              data-ns-animate
              data-instant
              data-delay="0.95"
              data-direction="right"
              class="w-[155px] xl:w-[195px] rounded-xl overflow-hidden drop-shadow-[0_8px_32px_rgba(0,0,0,0.18)]"
            >
              <img
                src="/images/shared/insighty-card-pixel-ai.svg"
                alt="Pixel AI assistant"
                class="w-full"
              />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
