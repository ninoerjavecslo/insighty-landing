---
interface Props {
  id: string
  name: string
  placeholder?: string
  required?: boolean
  rows?: number
}
const { id, name, placeholder, required = false, rows = 4 } = Astro.props
---
<textarea
  id={id}
  name={name}
  placeholder={placeholder}
  required={required || undefined}
  rows={rows}
  aria-required={required ? 'true' : undefined}
  aria-describedby={`${id}-error`}
  class="form-input"
></textarea>
