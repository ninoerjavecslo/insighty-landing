---
interface Props {
  align?: 'left' | 'center' | 'right'
  direction?: 'row' | 'col'
  class?: string
}

const {
  align = 'left',
  direction = 'row',
  class: className = '',
} = Astro.props

const alignMap = {
  left:   'justify-start',
  center: 'justify-center',
  right:  'justify-end',
}

const classes = [
  'flex',
  direction === 'col' ? 'flex-col items-stretch' : 'flex-row flex-wrap items-center',
  alignMap[align],
  'gap-3',
  className,
].filter(Boolean).join(' ')
---

<div class={classes}>
  <slot />
</div>
