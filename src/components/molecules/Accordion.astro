---
interface Props {
  items: { q: string; a: string }[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---
<div class="accordion w-full space-y-3" aria-label="Frequently asked questions">
  {items.map((item, i) => (
    <div class={`accordion-item border-stroke-1 dark:border-stroke-6 rounded-[20px] border${openFirst && i === 0 ? ' active-accordion' : ''}`}>
      <button
        class="accordion-action flex w-full cursor-pointer items-center justify-between p-4 md:p-5 lg:p-6 outline-none"
        aria-expanded="false"
      >
        <span class="xl:text-heading-6 text-tagline-1 text-secondary dark:text-accent flex-1 text-left font-normal">
          {item.q}
        </span>
        <span class="accordion-arrow data-[state=true]:bg-secondary dark:data-[state=true]:bg-accent data-[state=false]:bg-primary-700 ml-2.5 flex size-7 shrink-0 items-center justify-center rounded-full transition-colors duration-300 ease-in-out sm:ml-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="6" viewBox="0 0 10 6" fill="none" class="transition-colors duration-300 ease-in-out">
            <path d="M9 0.910156L5 4.91016L1 0.910156" stroke="white" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
      <div class="accordion-content">
        <div class="px-6 pb-6">
          <p class="text-tagline-1 text-secondary/80 dark:text-accent/80 leading-relaxed">{item.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>
