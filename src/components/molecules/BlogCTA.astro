---
import { blogCTA } from '../../data/blogCTAContent'
import Button from '../atoms/Button.astro'
---

<aside
  class="not-prose my-12 rounded-2xl overflow-hidden relative"
  style="background: linear-gradient(135deg, #112445 0%, #4a6ec7 100%)"
  aria-label="Try Insighty"
>
  <div
    class="absolute inset-0 opacity-[0.04] pointer-events-none"
    style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 32px 32px;"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-center p-8 md:p-10">
    <div class="space-y-4">
      <h3 class="text-white leading-tight max-w-[420px] not-prose">{blogCTA.headline}</h3>
      <p class="text-tagline-2 text-white/70 max-w-[400px]">{blogCTA.subtext}</p>
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <Button kind="outline-white" href={blogCTA.primaryCTA.href}>
          <span>{blogCTA.primaryCTA.label}</span>
        </Button>
        <Button kind="arrow" href={blogCTA.secondaryCTA.href}>{blogCTA.secondaryCTA.label}</Button>
      </div>
    </div>

    <div class="hidden md:block shrink-0 w-[240px] xl:w-[280px]">
      <picture>
        <source srcset="/images/ns-img-506.webp" type="image/webp" />
        <img
          src="/images/ns-img-506.png"
          alt="Insighty platform dashboard"
          class="w-full rounded-xl shadow-2xl ring-1 ring-white/10 rotate-1"
          loading="lazy"
          decoding="async"
          width="898"
          height="898"
        />
      </picture>
    </div>
  </div>
</aside>
