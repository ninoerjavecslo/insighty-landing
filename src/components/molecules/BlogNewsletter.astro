---
// TODO: Connect to Mailtrap — replace action URL and add server-side handler
// Mailtrap bulk sending endpoint goes in NEWSLETTER_ENDPOINT env var
// Form submission handler: src/pages/api/newsletter.ts (create when integrating)
---

<div class="rounded-2xl overflow-hidden bg-background-1 dark:bg-background-6 border border-stroke-2 dark:border-stroke-5 grid grid-cols-1 md:grid-cols-[1fr_auto]">

  <!-- Left: copy + form -->
  <div class="p-8 md:p-10 xl:p-12 flex flex-col justify-center gap-6">
    <div class="space-y-3">
      <span class="inline-block text-tagline-3 uppercase tracking-widest font-medium text-secondary/40 dark:text-accent/40">Newsletter</span>
      <h3 class="text-secondary dark:text-accent leading-tight max-w-[380px]">
        Get agency insights delivered to your inbox.
      </h3>
      <p class="text-tagline-2 text-secondary/60 dark:text-accent/60 max-w-[340px]">
        Practical tips on agency ops, revenue, and growth — no fluff, straight to the point.
      </p>
    </div>

    <form
      id="blog-newsletter-form"
      class="flex flex-col sm:flex-row gap-3 max-w-[480px]"
      novalidate
    >
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        placeholder="Enter your email address"
        required
        autocomplete="email"
        class="auth-form-input flex-1"
      />
      <button
        type="submit"
        class="btn btn-md btn-primary shrink-0"
      >
        <span>Subscribe</span>
      </button>
    </form>

    <p id="newsletter-msg" class="hidden text-tagline-3 text-secondary/60 dark:text-accent/60 -mt-2"></p>
    <p class="text-tagline-3 text-secondary/40 dark:text-accent/40">No spam. Unsubscribe anytime.</p>
  </div>

  <!-- Right: decorative -->
  <div
    class="hidden md:block w-[260px] xl:w-[320px] relative overflow-hidden"
    aria-hidden="true"
  >
    <div
      class="absolute inset-0"
      style="background: linear-gradient(135deg, #112445 0%, #4a6ec7 100%)"
    ></div>
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 28px 28px;"
    ></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <svg class="w-24 h-24 text-white/20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
      </svg>
    </div>
  </div>

</div>

<script>
  const form = document.getElementById('blog-newsletter-form') as HTMLFormElement | null
  const msg = document.getElementById('newsletter-msg')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim()
    if (!email) return

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement
    btn.disabled = true
    btn.textContent = 'Subscribing…'

    try {
      // TODO: replace with real endpoint when Mailtrap is connected
      // const res = await fetch('/api/newsletter', { method: 'POST', body: JSON.stringify({ email }), headers: { 'Content-Type': 'application/json' } })
      // if (!res.ok) throw new Error()

      // Placeholder success until endpoint is wired
      await new Promise(r => setTimeout(r, 600))

      form.reset()
      if (msg) {
        msg.textContent = "You're subscribed! We'll be in touch soon."
        msg.classList.remove('hidden')
      }
      btn.textContent = 'Subscribed'
    } catch {
      btn.disabled = false
      btn.textContent = 'Subscribe'
      if (msg) {
        msg.textContent = 'Something went wrong. Please try again.'
        msg.classList.remove('hidden')
      }
    }
  })
</script>
