{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "Agency Ops",
        "Revenue",
        "Projects",
        "Product"
      ]
    },
    "readTime": {
      "type": "number"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "thumbnail": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate",
    "category",
    "readTime"
  ]
}